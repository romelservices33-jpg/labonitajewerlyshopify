            <svg width="17" height="17" viewBox="0 0 24 24" fill="currentColor"><path d="M12.04 2c-5.46 0-9.91 4.45-9.91 9.91 0 1.75.46 3.45 1.32 4.95L2.05 22l5.25-1.38c1.45.79 3.08 1.21 4.74 1.21 5.46 0 9.91-4.45 9.91-9.91 0-2.65-1.03-5.14-2.9-7.01A9.816 9.816 0 0012.04 2zm0 18.06c-1.49 0-2.95-.4-4.22-1.16l-.3-.18-3.13.82.83-3.05-.2-.31a8.13 8.13 0 01-1.25-4.28c0-4.51 3.67-8.17 8.18-8.17 2.18 0 4.24.85 5.78 2.39 1.54 1.54 2.39 3.6 2.39 5.78 0 4.51-3.67 8.16-8.18 8.16zm4.49-6.13c-.25-.12-1.47-.72-1.7-.81-.23-.08-.39-.12-.56.12-.17.25-.64.81-.79.97-.14.17-.29.19-.54.06-.25-.12-1.05-.39-2-1.23-.74-.66-1.24-1.47-1.39-1.72-.14-.25-.02-.38.11-.5.11-.11.25-.29.37-.43.12-.14.17-.25.25-.41.08-.17.04-.31-.02-.43s-.56-1.34-.76-1.84c-.2-.48-.41-.42-.56-.43h-.48c-.17 0-.44.06-.67.31-.23.25-.88.86-.88 2.1 0 1.24.9 2.44 1.03 2.61.12.17 1.77 2.71 4.3 3.79.6.26 1.07.41 1.44.53.61.19 1.16.17 1.6.1.49-.07 1.47-.6 1.68-1.18.21-.58.21-1.07.14-1.18-.06-.11-.23-.17-.48-.29z"/></svg>
            <span>Vender mi Oro al 93% por WhatsApp</span>
          </a>
        </div>
      </div>

    </div>
  </div>
</section>

<script>
  (function() {
    var TROY_OUNCE_GRAMS = 31.1034768;
    var BUYBACK_RATE = 0.93; // 93% of official Kitco gold price
    var currentSpotOzUsd = 4143.70;
    var selectedKarat = '14k';
    var karatFactors = {
      '24k': 1.0,
      '18k': 18 / 24,
      '14k': 14 / 24,
      '10k': 10 / 24
    };

    function formatUSD(num) {
      return '$' + Number(num).toLocaleString('en-US', { minimumFractionDigits: 2, maximumFractionDigits: 2 });
    }

    function updateAllKitcoDOM(quoteData) {
      if (quoteData && typeof quoteData.bid === 'number' && quoteData.bid > 100) {
        currentSpotOzUsd = Number(quoteData.bid);
      }

      var officialGram24k = currentSpotOzUsd / TROY_OUNCE_GRAMS;
      var buybackOz24k = currentSpotOzUsd * BUYBACK_RATE;

      var g24Off = officialGram24k;
      var g18Off = officialGram24k * karatFactors['18k'];
      var g14Off = officialGram24k * karatFactors['14k'];
      var g10Off = officialGram24k * karatFactors['10k'];

      var g24Buy = g24Off * BUYBACK_RATE;
      var g18Buy = g18Off * BUYBACK_RATE;
      var g14Buy = g14Off * BUYBACK_RATE;
      var g10Buy = g10Off * BUYBACK_RATE;

      // Update top announcement marquee & spot displays
      document.querySelectorAll('.js-kitco-spot-oz').forEach(function(el) {
        el.textContent = formatUSD(currentSpotOzUsd) + (el.id === 'kitcoSpotOzDisplay' ? '' : '/oz');
      });
      document.querySelectorAll('.js-kitco-buy-24k').forEach(function(el) {
        el.textContent = formatUSD(g24Buy) + '/g (24K)';
      });
      document.querySelectorAll('.js-kitco-buy-14k').forEach(function(el) {
        el.textContent = formatUSD(g14Buy) + '/g (14K)';
      });
      document.querySelectorAll('.js-kitco-buy-10k').forEach(function(el) {
        el.textContent = formatUSD(g10Buy) + '/g (10K)';
      });

      var offGramEl = document.getElementById('kitcoOfficialGram24k');
      if (offGramEl) offGramEl.textContent = formatUSD(officialGram24k);

      var buyOzEl = document.getElementById('kitcoBuybackOz24k');
      if (buyOzEl) buyOzEl.textContent = formatUSD(buybackOz24k);

      var buyGramTopEl = document.getElementById('kitcoBuybackGram24kTop');
      if (buyGramTopEl) buyGramTopEl.textContent = formatUSD(g24Buy) + '/g';

      if (quoteData) {
        var changeBadge = document.getElementById('kitcoChangeBadge');
        if (changeBadge && typeof quoteData.change === 'number') {
          var chg = Number(quoteData.change);
          var pct = Number(quoteData.changePercentage || 0);
          var sign = chg >= 0 ? '+' : '';
          changeBadge.textContent = sign + formatUSD(chg) + ' (' + sign + pct.toFixed(2) + '%)';
          changeBadge.style.background = chg >= 0 ? 'rgba(16, 185, 129, 0.22)' : 'rgba(239, 68, 68, 0.24)';
          changeBadge.style.color = chg >= 0 ? '#6EE7B7' : '#FCA5A5';
        }
        var rangeEl = document.getElementById('kitcoRangeToday');
        if (rangeEl && quoteData.low && quoteData.high) {
          rangeEl.textContent = formatUSD(quoteData.low) + ' – ' + formatUSD(quoteData.high);
        }
        var timeEl = document.getElementById('kitcoUpdatedTime');
        if (timeEl) {
          var now = new Date();
          timeEl.textContent = 'Cotización Kitco hoy: ' + now.toLocaleDateString('es-US', { day: '2-digit', month: 'short', year: 'numeric' });
        }
      }

      // Update Karat Cards
      var mapCards = [
        { k: '24k', buy: g24Buy, off: g24Off },
        { k: '18k', buy: g18Buy, off: g18Off },
        { k: '14k', buy: g14Buy, off: g14Off },
        { k: '10k', buy: g10Buy, off: g10Off }
      ];
      mapCards.forEach(function(item) {
        var gEl = document.getElementById('kitcoCard' + item.k + 'Gram');
        if (gEl) gEl.textContent = formatUSD(item.buy);
        var oEl = document.getElementById('kitcoCard' + item.k + 'Official');
        if (oEl) oEl.textContent = formatUSD(item.off) + '/g';
      });

      recalculateKitcoBuyback();
    }

    window.selectKitcoCalculatorKarat = function(karat) {
      selectedKarat = karat;
      document.querySelectorAll('.kitco-karat-pill').forEach(function(btn) {
        btn.classList.toggle('active', btn.getAttribute('data-karat-btn') === karat);
      });
      document.querySelectorAll('.kitco-karat-card').forEach(function(card) {
        card.classList.toggle('is-selected', card.getAttribute('data-karat-card') === karat);
      });
      recalculateKitcoBuyback();
    };

    window.setKitcoCalculatorWeight = function(grams) {
      var input = document.getElementById('kitcoWeightInput');
      if (input) {
        input.value = grams;
        recalculateKitcoBuyback();
      }
    };

    window.recalculateKitcoBuyback = function() {
      var input = document.getElementById('kitcoWeightInput');
      var weightGrams = input ? parseFloat(input.value) : 10;
      if (isNaN(weightGrams) || weightGrams < 0) weightGrams = 0;

      var purity = karatFactors[selectedKarat] || (14 / 24);
      var officialPerGram = (currentSpotOzUsd / TROY_OUNCE_GRAMS) * purity;
      var officialTotal = officialPerGram * weightGrams;
      var storePayout93 = officialTotal * BUYBACK_RATE;

      var kLabel = document.getElementById('kitcoCalcKaratLabel');
      if (kLabel) kLabel.textContent = selectedKarat.toUpperCase();

      var offTotalEl = document.getElementById('kitcoCalcOfficialTotal');
      if (offTotalEl) offTotalEl.textContent = formatUSD(officialTotal) + ' USD';

      var payoutEl = document.getElementById('kitcoCalcStorePayout');
      if (payoutEl) payoutEl.textContent = formatUSD(storePayout93) + ' USD';

      var waBtn = document.getElementById('kitcoWhatsappSellBtn');
      if (waBtn) {
        var msg = 'Hola La Bonita Jewelry, quiero vender ' + weightGrams + 'g de oro ' + selectedKarat.toUpperCase() +
          ' con la cotización oficial de Kitco hoy (' + formatUSD(currentSpotOzUsd) + '/oz). Pago estimado al 93% en tienda: ' + formatUSD(storePayout93) + ' USD.';
        waBtn.href = 'https://wa.me/15026980759?text=' + encodeURIComponent(msg);
      }
    };

    function fetchLiveKitcoPrice() {
      var query = 'query GetMetalQuoteV3($symbol: String!, $currency: String!) { GetMetalQuoteV3(symbol: $symbol, currency: $currency) { results { ask bid change changePercentage high low mid originalTime } } }';
      fetch('https://kdb-gw.prod.kitco.com/graphql', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json', 'Accept': 'application/json' },
        body: JSON.stringify({ query: query, variables: { symbol: 'AU', currency: 'USD' } })
      })
      .then(function(r) { return r.json(); })
      .then(function(json) {
        var res = json && json.data && json.data.GetMetalQuoteV3 && json.data.GetMetalQuoteV3.results && json.data.GetMetalQuoteV3.results[0];
        if (res && typeof res.bid === 'number') {
          updateAllKitcoDOM(res);
        } else {
          throw new Error('Empty Kitco GraphQL response');
        }
      })
      .catch(function() {
        // Fallback to daily synced Shopify JSON asset
        fetch("{{ 'kitco-gold-price.json' | asset_url }}")
          .then(function(r) { return r.json(); })
          .then(function(data) {
            if (data && data.official_spot) {
              updateAllKitcoDOM({
                bid: data.official_spot.bid_oz_usd,
                change: data.official_spot.change_usd,
                changePercentage: data.official_spot.change_percentage,
                high: data.official_spot.high_oz_usd,
                low: data.official_spot.low_oz_usd
              });
            }
          })
          .catch(function() {});
      });
    }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', function() {
        updateAllKitcoDOM(null);
        fetchLiveKitcoPrice();
      });
    } else {
      updateAllKitcoDOM(null);
      fetchLiveKitcoPrice();
    }
    // Refresh live Kitco quote every 60 seconds while customer is on page
    setInterval(fetchLiveKitcoPrice, 60000);
  })();
</script>
