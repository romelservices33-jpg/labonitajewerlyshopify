{{ 'editorial-luxury.css' | asset_url | stylesheet_tag }}

{%- assign selected_variant = product.selected_or_first_available_variant -%}
{%- assign karat_tag = '14K' -%}
{%- if product.tags contains '10k' or product.title contains '10K' or product.title contains '10k' -%}
  {%- assign karat_tag = '10K' -%}
{%- endif -%}

<style>
  .pdp-floating-page-backdrop {
    min-height: calc(100vh - 120px);
    background: radial-gradient(circle at 50% 30%, #08195B 0%, #040C2D 100%);
    padding: 60px 20px 80px;
    display: flex;
    flex-direction: column;
    align-items: center;
    position: relative;
    box-sizing: border-box;
    width: 100%;
  }

  .pdp-unified-card-wrap {
    width: 100%;
    max-width: 980px;
    margin: 0 auto;
    position: relative;
    z-index: 5;
  }

  .pdp-unified-card {
    background: #FFFFFF;
    border-radius: 24px;
    border: 1px solid rgba(209, 176, 84, 0.35);
    box-shadow: 0 24px 70px rgba(4, 12, 45, 0.45), 0 4px 16px rgba(0, 0, 0, 0.1);
    display: grid;
    grid-template-columns: 1fr 1.15fr;
    overflow: hidden;
    width: 100%;
  }

  @media (max-width: 860px) {
    .pdp-unified-card {
      grid-template-columns: 1fr;
    }
    .pdp-floating-page-backdrop {
      padding: 30px 14px 60px;
    }
  }

  /* Left Side: Media Column */
  .pdp-card-media-col {
    background: radial-gradient(circle at 50% 50%, #FAF8F2 0%, #EFECE3 100%);
    padding: 0;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    position: relative;
    border-right: 1px solid rgba(8, 25, 91, 0.08);
    min-height: 480px;
    overflow: hidden;
  }

  .pdp-card-main-img {
    width: 100%;
    height: 100%;
    min-height: 480px;
    object-fit: cover;
    display: block;
    transition: transform 0.4s ease;
  }

  .pdp-card-main-img:hover {
    transform: scale(1.03);
  }

  .pdp-floating-badge {
    position: absolute;
    top: 18px;
    left: 18px;
    background: rgba(8, 25, 91, 0.92);
    backdrop-filter: blur(6px);
    -webkit-backdrop-filter: blur(6px);
    color: #FFFFFF;
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    padding: 6px 14px;
    border-radius: 999px;
    border: 1px solid #D1B054;
    box-shadow: 0 4px 14px rgba(8, 25, 91, 0.25);
    z-index: 5;
  }

  .pdp-thumbs-row {
    position: absolute;
    bottom: 14px;
    left: 14px;
    right: 14px;
    display: flex;
    gap: 8px;
    overflow-x: auto;
    z-index: 6;
    padding-bottom: 4px;
  }

  .pdp-thumb-item {
    width: 52px;
    height: 52px;
    border-radius: 8px;
    border: 2px solid transparent;
    padding: 0;
    background: #FFFFFF;
    cursor: pointer;
    overflow: hidden;
    flex-shrink: 0;
    box-shadow: 0 2px 8px rgba(0,0,0,0.15);
  }

  .pdp-thumb-item.active {
    border-color: #08195B;
  }

  .pdp-thumb-item img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  /* Right Side: Details Column */
  .pdp-card-details-col {
    padding: 36px 36px 36px 32px;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
  }

  @media (max-width: 600px) {
    .pdp-card-details-col {
      padding: 24px 18px;
    }
  }

  .pdp-header-meta-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 8px;
  }

  .pdp-category-kicker {
    font-family: 'Plus Jakarta Sans', sans-serif;
    font-size: 0.75rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.12em;
    color: #D1B054;
  }

  .pdp-stock-status {
    font-size: 0.75rem;
    color: #059669;
    font-weight: 700;
    display: inline-flex;
    align-items: center;
    gap: 4px;
  }

  .pdp-stock-dot {
    width: 6px;
    height: 6px;
    background: #059669;
    border-radius: 50%;
    display: inline-block;
  }

  .pdp-title-main {
    font-family: 'Cormorant Garamond', Georgia, serif;
    font-size: 2rem;
    font-weight: 600;
    color: #08195B;
    line-height: 1.2;
    margin: 0 0 12px 0;
  }

  .pdp-pricing-row-single {
    display: flex;
    align-items: baseline;
    gap: 12px;
    flex-wrap: wrap;
    margin-bottom: 12px;
  }

  .pdp-price-now {
    font-family: 'Plus Jakarta Sans', sans-serif;
    font-size: 1.75rem;
    font-weight: 800;
    color: #08195B;
  }

  .pdp-price-was {
    font-size: 1.1rem;
    color: #94A3B8;
    text-decoration: line-through;
    font-weight: 500;
  }

  .pdp-green-pill-badge {
    background: rgba(5, 150, 105, 0.12);
    color: #059669;
    font-size: 0.75rem;
    font-weight: 700;
    padding: 3px 10px;
    border-radius: 20px;
  }

  .pdp-affirm-banner {
    display: flex;
    align-items: center;
    gap: 8px;
    background: #FAF9F6;
    border: 1px solid rgba(209, 176, 84, 0.35);
    padding: 8px 12px;
    border-radius: 8px;
    font-size: 0.8rem;
    color: #334155;
    margin-bottom: 18px;
  }

  .pdp-affirm-banner strong {
    color: #08195B;
    font-weight: 700;
  }

  /* Option Pills */
  .pdp-selector-group {
    margin-bottom: 14px;
  }

  .pdp-selector-label {
    display: flex;
    justify-content: space-between;
    font-size: 0.8rem;
    font-weight: 700;
    color: #08195B;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    margin-bottom: 6px;
    font-family: 'Plus Jakarta Sans', sans-serif;
  }

  .pdp-selector-label span:last-child {
    color: #D1B054;
    font-weight: 700;
  }

  .pdp-pills-flex {
    display: flex;
    gap: 8px;
    flex-wrap: wrap;
  }

  .pdp-pill-button {
    background: #FFFFFF;
    border: 1.5px solid #E2E8F0;
    border-radius: 10px;
    padding: 6px 14px;
    font-size: 0.82rem;
    font-weight: 600;
    color: #1E293B;
    cursor: pointer;
    transition: all 0.2s ease;
  }

  .pdp-pill-button:hover {
    border-color: #08195B;
    color: #08195B;
  }

  .pdp-pill-button.active {
    background: #08195B;
    border-color: #08195B;
    color: #FFFFFF;
    box-shadow: 0 4px 10px rgba(8, 25, 91, 0.2);
  }

  /* Specs Table */
  .pdp-specs-table-compact {
    width: 100%;
    border-collapse: collapse;
    margin: 14px 0 18px;
    font-size: 0.82rem;
  }

  .pdp-specs-table-compact td {
    padding: 7px 0;
    border-bottom: 1px solid rgba(8, 25, 91, 0.06);
  }

  .pdp-specs-table-compact .spec-title {
    color: #64748B;
    font-weight: 500;
    width: 42%;
  }

  .pdp-specs-table-compact .spec-data {
    color: #08195B;
    font-weight: 600;
    text-align: right;
  }

  /* Actions */
  .pdp-actions-row-unified {
    display: flex;
    gap: 10px;
    align-items: center;
    margin-bottom: 14px;
  }

  .pdp-qty-control {
    display: inline-flex;
    align-items: center;
    border: 1.5px solid #E2E8F0;
    border-radius: 8px;
    background: #FFFFFF;
    height: 44px;
  }

  .pdp-qty-btn-action {
    background: transparent;
    border: none;
    width: 32px;
    height: 100%;
    font-size: 1.1rem;
    font-weight: 700;
    color: #08195B;
    cursor: pointer;
  }

  .pdp-qty-input-box {
    width: 30px;
    text-align: center;
    border: none;
    font-weight: 700;
    font-size: 0.95rem;
    color: #08195B;
    background: transparent;
  }

  .pdp-btn-submit-cart {
    flex: 1;
    height: 44px;
    background: #08195B;
    color: #FFFFFF;
    border: 1px solid rgba(209, 176, 84, 0.6);
    border-radius: 8px;
    font-family: 'Plus Jakarta Sans', sans-serif;
    font-size: 0.88rem;
    font-weight: 700;
    letter-spacing: 0.04em;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    cursor: pointer;
    box-shadow: 0 6px 18px rgba(8, 25, 91, 0.25);
    transition: all 0.25s ease;
  }

  .pdp-btn-submit-cart:hover {
    background: #0d278c;
    border-color: #D1B054;
    transform: translateY(-1px);
    box-shadow: 0 8px 22px rgba(8, 25, 91, 0.35);
  }

  .pdp-btn-submit-cart:disabled {
    background: #94A3B8;
    border-color: transparent;
    cursor: not-allowed;
    transform: none;
  }

  /* Trust Strip */
  .pdp-trust-icons-strip {
    display: flex;
    justify-content: space-between;
    padding-top: 12px;
    border-top: 1px solid rgba(8, 25, 91, 0.08);
    font-size: 0.74rem;
    color: #475569;
    flex-wrap: wrap;
    gap: 8px;
  }

  .pdp-trust-unit {
    display: flex;
    align-items: center;
    gap: 5px;
  }
</style>

<section class="pdp-floating-page-backdrop" id="ProductSection-{{ section.id }}">
  <div class="pdp-unified-card-wrap">
    <div class="pdp-unified-card">
      
      <!-- LEFT COLUMN: UNIFIED MEDIA -->
      <div class="pdp-card-media-col">
        {%- if product.featured_image != blank -%}
          <img
            id="pdpMainImg"
            src="{{ product.featured_image | image_url: width: 900 }}"
            alt="{{ product.title | escape }}"
            class="pdp-card-main-img"
            loading="eager"
            width="900"
            height="900"
          >
        {%- else -%}
          <img
            id="pdpMainImg"
            src="{{ 'collection-cadenas.jpg' | asset_url }}"
            alt="{{ product.title | escape }}"
            class="pdp-card-main-img"
            loading="eager"
            width="900"
            height="900"
          >
        {%- endif -%}

        <span class="pdp-floating-badge" id="pdpKaratBadge">Oro {{ karat_tag }} Sólido</span>

        {%- if product.images.size > 1 -%}
          <div class="pdp-thumbs-row">
            {%- for image in product.images -%}
              <button
                type="button"
                class="pdp-thumb-item {% if forloop.first %}active{% endif %}"
                onclick="switchPdpThumb('{{ image | image_url: width: 900 }}', this)"
                aria-label="Ver imagen {{ forloop.index }}"
              >
                <img src="{{ image | image_url: width: 120 }}" alt="{{ product.title | escape }}" loading="lazy" width="52" height="52">
              </button>
            {%- endfor -%}
          </div>
        {%- endif -%}
      </div>

      <!-- RIGHT COLUMN: UNIFIED DETAILS -->
      <div class="pdp-card-details-col">
        <div>
          <!-- Header Meta -->
          <div class="pdp-header-meta-row">
            <span class="pdp-category-kicker">COLECCIÓN {{ product.type | default: 'LA BONITA' | upcase }}</span>
            <span class="pdp-stock-status">
              <span class="pdp-stock-dot"></span> En Stock · Envío Hoy
            </span>
          </div>

          <!-- Product Title -->
          <h1 class="pdp-title-main">{{ product.title }}</h1>

          <!-- Pricing Row -->
          <div class="pdp-pricing-row-single">
            <span class="pdp-price-now" id="pdpPriceNow">{{ selected_variant.price | money }}</span>
            {%- if selected_variant.compare_at_price > selected_variant.price -%}
              <span class="pdp-price-was" id="pdpPriceWas">{{ selected_variant.compare_at_price | money }}</span>
            {%- endif -%}
            <span class="pdp-green-pill-badge">Oro {{ karat_tag }} Macizo</span>
          </div>

          <!-- Affirm Monthly Calc -->
          <div class="pdp-affirm-banner">
            <svg viewBox="0 0 24 24" width="16" height="16" fill="currentColor"><path d="M20 4H4c-1.11 0-1.99.89-1.99 2L2 18c0 1.11.89 2 2 2h16c1.11 0 2-.89 2-2V6c0-1.11-.89-2-2-2zm0 14H4v-6h16v6zm0-10H4V6h16v2z"/></svg>
            <span>O paga desde <strong id="pdpAffirmMonthly">${{ selected_variant.price | divided_by: 1200 | at_least: 35 }}/mes</strong> en cuotas con <strong>Affirm</strong></span>
          </div>

          <!-- Option Selectors -->
          <form method="post" action="/cart/add" id="pdpBuyForm-{{ section.id }}">
            <input type="hidden" name="id" id="pdpSelectedVariantId" value="{{ selected_variant.id }}">

            {%- unless product.has_only_default_variant -%}
              {%- for option in product.options_with_values -%}
                <div class="pdp-selector-group">
                  <div class="pdp-selector-label">
                    <span>{{ option.name }}</span>
                    <span id="pdpOptVal-{{ forloop.index0 }}">{{ option.selected_value }}</span>
                  </div>
                  <div class="pdp-pills-flex">
                    {%- for value in option.values -%}
                      <button
                        type="button"
                        class="pdp-pill-button {% if option.selected_value == value %}active{% endif %}"
                        data-opt-idx="{{ forloop.parentloop.index0 }}"
                        data-val="{{ value | escape }}"
                        onclick="onPdpVariantClick({{ forloop.parentloop.index0 }}, '{{ value | escape }}', this)"
                      >
                        {{ value }}
                      </button>
                    {%- endfor -%}
                  </div>
                </div>
              {%- endfor -%}
            {%- endunless -%}

            <!-- Goldsmith Specs Table -->
            <table class="pdp-specs-table-compact">
              <tbody>
                <tr>
                  <td class="spec-title">Pureza de Metal</td>
                  <td class="spec-data" id="pdpSpecMetal">Oro {{ karat_tag }} Sólido Garantizado</td>
                </tr>
                <tr>
                  <td class="spec-title">Peso Estimado</td>
                  <td class="spec-data" id="pdpSpecWeight">Oro Genuino Certificado</td>
                </tr>
                <tr>
                  <td class="spec-title">Medida / Dimensión</td>
                  <td class="spec-data" id="pdpSpecSize">{{ selected_variant.title | replace: 'Default Title', 'Estándar' }}</td>
                </tr>
                <tr>
                  <td class="spec-title">Cierre / Acabado</td>
                  <td class="spec-data">Caja con Doble Seguro / Pulido Fino</td>
                </tr>
                <tr>
                  <td class="spec-title">Garantía Oficial</td>
                  <td class="spec-data" style="color:#D1B054;">Certificado de Autenticidad de por Vida</td>
                </tr>
              </tbody>
            </table>

            <!-- Actions Row -->
            <div class="pdp-actions-row-unified">
              <div class="pdp-qty-control">
                <button type="button" class="pdp-qty-btn-action" onclick="adjustPdpQty(-1)" aria-label="Disminuir cantidad">-</button>
                <input type="number" id="pdpQuantityInput" name="quantity" value="1" min="1" max="10" class="pdp-qty-input-box" readonly>
                <button type="button" class="pdp-qty-btn-action" onclick="adjustPdpQty(1)" aria-label="Aumentar cantidad">+</button>
              </div>

              <button
                type="submit"
                class="pdp-btn-submit-cart"
                id="pdpSubmitBtn"
                {% unless selected_variant.available %}disabled{% endunless %}
              >
                <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M6 2L3 6v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6l-3-4z"></path>
                  <line x1="3" y1="6" x2="21" y2="6"></line>
                  <path d="M16 10a4 4 0 0 1-8 0"></path>
                </svg>
                <span>{% if selected_variant.available %}Agregar al Carrito{% else %}Agotado{% endif %}</span>
              </button>
            </div>
          </form>
        </div>

        <!-- Trust Icons Strip -->
        <div class="pdp-trust-icons-strip">
          <span class="pdp-trust-unit">
            <svg viewBox="0 0 24 24" width="15" height="15" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>
            <span>Oro 100% Genuino</span>
          </span>
          <span class="pdp-trust-unit">
            <svg viewBox="0 0 24 24" width="15" height="15" fill="none" stroke="currentColor" stroke-width="2"><rect x="1" y="3" width="15" height="13"></rect><polygon points="16 8 20 8 23 11 23 16 16 16 16 8"></polygon><circle cx="5.5" cy="18.5" r="2.5"></circle><circle cx="18.5" cy="18.5" r="2.5"></circle></svg>
            <span>Envío Asegurado Gratis</span>
          </span>
          <span class="pdp-trust-unit">
            <svg viewBox="0 0 24 24" width="15" height="15" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="11" width="18" height="11" rx="2" ry="2"></rect><path d="M7 11V7a5 5 0 0 1 10 0v4"></path></svg>
            <span>Pago Seguro Cifrado</span>
          </span>
        </div>

      </div>

    </div>
  </div>
</section>

<!-- INLINE JAVASCRIPT FOR PDP FLOATING CARD -->
<script>
  function switchPdpThumb(src, btn) {
    var main = document.getElementById('pdpMainImg');
    if (main) main.src = src;
    var thumbs = document.querySelectorAll('.pdp-thumb-item');
    thumbs.forEach(function(t) { t.classList.remove('active'); });
    if (btn) btn.classList.add('active');
  }

  function adjustPdpQty(delta) {
    var input = document.getElementById('pdpQuantityInput');
    if (!input) return;
    var current = parseInt(input.value) || 1;
    var next = Math.max(1, Math.min(10, current + delta));
    input.value = next;
  }

  var pdpProductVariants = {{ product.variants | json }};

  function onPdpVariantClick(optIdx, val, btn) {
    var label = document.getElementById('pdpOptVal-' + optIdx);
    if (label) label.textContent = val;

    var parent = btn.parentElement;
    parent.querySelectorAll('.pdp-pill-button').forEach(function(p) { p.classList.remove('active'); });
    btn.classList.add('active');

    // Check all selected options
    var selected = [];
    document.querySelectorAll('.pdp-selector-group').forEach(function(group) {
      var act = group.querySelector('.pdp-pill-button.active');
      if (act) selected.push(act.getAttribute('data-val'));
    });

    var matched = pdpProductVariants.find(function(v) {
      return v.options.every(function(optVal, idx) {
        return selected[idx] === optVal;
      });
    });

    if (matched) {
      var hid = document.getElementById('pdpSelectedVariantId');
      if (hid) hid.value = matched.id;

      var pEl = document.getElementById('pdpPriceNow');
      if (pEl) {
        pEl.textContent = '$' + (matched.price / 100).toFixed(2) + ' USD';
      }

      var affEl = document.getElementById('pdpAffirmMonthly');
      if (affEl) {
        var mo = Math.max(35, Math.round(matched.price / 1200));
        affEl.textContent = '$' + mo + '/mes';
      }

      var sizeSpec = document.getElementById('pdpSpecSize');
      if (sizeSpec) sizeSpec.textContent = matched.title;

      var subBtn = document.getElementById('pdpSubmitBtn');
      if (subBtn) {
        if (matched.available) {
          subBtn.removeAttribute('disabled');
          subBtn.querySelector('span').textContent = 'Agregar al Carrito';
        } else {
          subBtn.setAttribute('disabled', 'disabled');
          subBtn.querySelector('span').textContent = 'Agotado';
        }
      }
    }
  }
</script>

