{{ 'editorial-luxury.css' | asset_url | stylesheet_tag }}

{%- assign selected_variant = product.selected_or_first_available_variant -%}
{%- assign karat_tag = '14K' -%}
{%- if product.tags contains '10k' or product.title contains '10K' or product.title contains '10k' -%}
  {%- assign karat_tag = '10K' -%}
{%- endif -%}

<section class="luxury-product-detail-section" id="ProductSection-{{ section.id }}" data-section-id="{{ section.id }}">
  <div class="product-detail-container">
    
    <!-- BREADCRUMB -->
    <nav class="product-luxury-breadcrumb" aria-label="Migas de pan">
      <a href="{{ routes.root_url }}">Inicio</a>
      <span class="breadcrumb-sep">/</span>
      {%- if collection -%}
        <a href="{{ collection.url }}">{{ collection.title }}</a>
        <span class="breadcrumb-sep">/</span>
      {%- else -%}
        <a href="{{ routes.all_products_collection_url }}">{{ product.type | default: 'Joyería Fina' }}</a>
        <span class="breadcrumb-sep">/</span>
      {%- endif -%}
      <span class="breadcrumb-current">{{ product.title }}</span>
    </nav>

    <!-- 2-COLUMN MAIN PRODUCT GRID -->
    <div class="product-detail-grid">
      
      <!-- LEFT COLUMN: LUXURY MEDIA GALLERY -->
      <div class="product-media-column">
        <div class="product-main-media-card">
          <div class="product-media-wrapper" id="mainProductMediaWrap">
            {%- if product.featured_image != blank -%}
              <img
                id="mainProductImage"
                src="{{ product.featured_image | image_url: width: 1000 }}"
                alt="{{ product.title | escape }}"
                class="product-featured-img"
                loading="eager"
                width="1000"
                height="1000"
              >
            {%- else -%}
              <img
                id="mainProductImage"
                src="{{ 'collection-cadenas.jpg' | asset_url }}"
                alt="{{ product.title | escape }}"
                class="product-featured-img"
                loading="eager"
                width="1000"
                height="1000"
              >
            {%- endif -%}

            <!-- Gold Authenticity Pin Badge -->
            <div class="cutout-card-pin">
              <span>{{ karat_tag }} ORO AUTÉNTICO</span>
              <svg class="cutout-corner cutout-corner-pin-left" width="24" height="32" viewBox="0 0 24 32" fill="none"><path d="M0 0 H24 V32 C17.38 32 12 24.83 12 16 C12 7.17 6.63 0 0 0 Z" fill="currentColor"/></svg>
            </div>

            <!-- Inset Category Label -->
            <div class="cutout-card-inset-label">
              <span class="cutout-label-text">{{ product.type | default: 'Alta Joyería' | capitalize }}</span>
              <svg class="cutout-corner cutout-corner-label-right" width="24" height="32" viewBox="0 0 24 32" fill="none"><path d="M0 0 C6.63 0 12 7.17 12 16 C12 24.83 17.38 32 24 32 H0 V0 Z" fill="currentColor"/></svg>
            </div>
          </div>
        </div>

        <!-- Thumbnails Strip (if multiple media) -->
        {%- if product.images.size > 1 -%}
          <div class="product-thumbnails-track">
            {%- for image in product.images -%}
              <button
                type="button"
                class="product-thumb-btn {% if forloop.first %}active{% endif %}"
                onclick="switchProductImage('{{ image | image_url: width: 1000 }}', this)"
                aria-label="Ver imagen {{ forloop.index }}"
              >
                <img src="{{ image | image_url: width: 160 }}" alt="{{ product.title | escape }}" loading="lazy" width="80" height="80">
              </button>
            {%- endfor -%}
          </div>
        {%- endif -%}
      </div>

      <!-- RIGHT COLUMN: PRODUCT DETAILS & PURCHASE -->
      <div class="product-info-column">
        <div class="product-info-card">
          
          <div class="product-brand-kicker">LA BONITA JEWELRY • ORO GENUINO</div>
          
          <h1 class="product-detail-title">{{ product.title }}</h1>

          <!-- PRICING ROW -->
          <div class="product-detail-pricing-box">
            <div class="price-row-main">
              <span class="price-current" id="productPrice">{{ selected_variant.price | money }}</span>
              {%- if selected_variant.compare_at_price > selected_variant.price -%}
                <span class="price-original" id="productComparePrice">{{ selected_variant.compare_at_price | money }}</span>
                <span class="price-discount-tag">Ahorro {{ selected_variant.compare_at_price | minus: selected_variant.price | money }}</span>
              {%- endif -%}
            </div>
            
            <div class="affirm-monthly-pill">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#08195B" stroke-width="2">
                <rect x="2" y="5" width="20" height="14" rx="2"></rect>
                <line x1="2" y1="10" x2="22" y2="10"></line>
              </svg>
              <span>Desde <strong>${{ selected_variant.price | divided_by: 1200 | at_least: 35 }}/mes</strong> con Affirm o hasta 12 meses sin intereses</span>
            </div>
          </div>

          <!-- AVAILABILITY & SHIPPING BADGE -->
          <div class="product-assurance-strip">
            <div class="assurance-item">
              <span class="assurance-dot"></span>
              <span><strong>En Stock</strong> — Listo para Envío Inmediato</span>
            </div>
            <div class="assurance-item">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor" color="#D1B054"><path d="M12 1L3 5v6c0 5.55 3.84 10.74 9 12 5.16-1.26 9-6.45 9-12V5l-9-4zm-2 16l-4-4 1.41-1.41L10 14.17l6.59-6.59L18 9l-8 8z"/></svg>
              <span>Oro {{ karat_tag }} Garantizado de por Vida</span>
            </div>
          </div>

          <!-- PURCHASE FORM -->
          <form method="post" action="/cart/add" id="productForm-{{ section.id }}" class="product-buy-form">
            <input type="hidden" name="id" id="selectedVariantId" value="{{ selected_variant.id }}">

            <!-- VARIANTS (If any) -->
            {%- unless product.has_only_default_variant -%}
              <div class="product-options-container">
                {%- for option in product.options_with_values -%}
                  <div class="product-option-group">
                    <label class="product-option-label">
                      {{ option.name }}: <span class="selected-option-val" id="selected-val-{{ forloop.index0 }}">{{ option.selected_value }}</span>
                    </label>
                    <div class="product-option-pills">
                      {%- for value in option.values -%}
                        <button
                          type="button"
                          class="btn-variant-pill {% if option.selected_value == value %}active{% endif %}"
                          data-option-index="{{ forloop.parentloop.index0 }}"
                          data-value="{{ value | escape }}"
                          onclick="selectVariantOption({{ forloop.parentloop.index0 }}, '{{ value | escape }}', this)"
                        >
                          {{ value }}
                        </button>
                      {%- endfor -%}
                    </div>
                  </div>
                {%- endfor -%}
              </div>
            {%- endunless -%}

            <!-- QUANTITY SELECTOR & BUY BUTTONS -->
            <div class="product-actions-row">
              <div class="product-qty-selector">
                <button type="button" class="qty-btn" onclick="adjustProductQty(-1)" aria-label="Disminuir cantidad">−</button>
                <input type="number" id="productQuantity" name="quantity" value="1" min="1" max="10" class="qty-input" readonly>
                <button type="button" class="qty-btn" onclick="adjustProductQty(1)" aria-label="Aumentar cantidad">+</button>
              </div>

              <button
                type="submit"
                class="btn-product-add-cart"
                id="btnAddToCart"
                {% unless selected_variant.available %}disabled{% endunless %}
              >
                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                  <path d="M16 8a4 4 0 0 1-8 0M3.6 7.4L2.9 15.8C2.8 17.6 2.7 18.5 3 19.2c.3.6.7 1.1 1.3 1.4.7.4 1.6.4 3.4.4h8.6c1.8 0 2.7 0 3.4-.4.6-.3 1-.8 1.3-1.4.3-.7.2-1.6.1-3.4l-.7-8.4c-.1-1.6-.2-2.3-.5-2.9-.3-.5-.8-1-1.3-1.2C18 3 17.2 3 15.6 3H8.4C6.8 3 6 3 5.4 3.3c-.5.2-1 .7-1.3 1.2-.3.6-.4 1.3-.5 2.9z"/>
                </svg>
                <span>{% if selected_variant.available %}AGREGAR AL CARRITO{% else %}AGOTADO TEMPORALMENTE{% endif %}</span>
              </button>
            </div>

            <!-- DIRECT WHATSAPP ADVICE BUTTON -->
            <a
              href="https://wa.me/15025994250?text=Hola,%20me%20interesa%20la%20joya:%20{{ product.title | url_encode }}%20({{ shop.url }}{{ product.url }})"
              target="_blank"
              rel="noopener"
              class="btn-product-whatsapp-inquiry"
            >
              <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor">
                <path d="M12.04 2c-5.46 0-9.91 4.45-9.91 9.91 0 1.75.46 3.45 1.32 4.95L2.05 22l5.25-1.38c1.45.79 3.08 1.21 4.74 1.21 5.46 0 9.91-4.45 9.91-9.91 0-2.65-1.03-5.14-2.9-7.01A9.816 9.816 0 0012.04 2zm0 18.06c-1.49 0-2.95-.4-4.22-1.16l-.3-.18-3.13.82.83-3.05-.2-.31a8.13 8.13 0 01-1.25-4.28c0-4.51 3.67-8.17 8.18-8.17 2.18 0 4.24.85 5.78 2.39 1.54 1.54 2.39 3.6 2.39 5.78 0 4.51-3.67 8.16-8.18 8.16zm4.49-6.13c-.25-.12-1.47-.72-1.7-.81-.23-.08-.39-.12-.56.12-.17.25-.64.81-.79.97-.14.17-.29.19-.54.06-.25-.12-1.05-.39-2-1.23-.74-.66-1.24-1.47-1.39-1.72-.14-.25-.02-.38.11-.5.11-.11.25-.29.37-.43.12-.14.17-.25.25-.41.08-.17.04-.31-.02-.43s-.56-1.34-.76-1.84c-.2-.48-.41-.42-.56-.43h-.48c-.17 0-.44.06-.67.31-.23.25-.88.86-.88 2.1 0 1.24.9 2.44 1.03 2.61.12.17 1.77 2.71 4.3 3.79.6.26 1.07.41 1.44.53.61.19 1.16.17 1.6.1.49-.07 1.47-.6 1.68-1.18.21-.58.21-1.07.14-1.18-.06-.11-.23-.17-.48-.29z"/>
              </svg>
              <span>Consultar Asesor Especialista por WhatsApp</span>
            </a>
          </form>

          <!-- DESCRIPTION & ACCORDION TABS -->
          <div class="product-editorial-tabs">
            
            <!-- Description -->
            <details class="luxury-tab" open>
              <summary class="luxury-tab-header">
                <span>Descripción & Detalles de la Joya</span>
                <svg class="tab-chevron" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="6 9 12 15 18 9"></polyline></svg>
              </summary>
              <div class="luxury-tab-content">
                <div class="product-rich-text">
                  {%- if product.description != blank -%}
                    {{ product.description }}
                  {%- else -%}
                    <p>Pieza de alta joyería forjada meticulosamente en <strong>Oro Auténtico {{ karat_tag }}</strong>. Diseñada para brindar un brillo inigualable, durabilidad de por vida y un confort impecable en el uso diario.</p>
                  {%- endif -%}
                </div>
              </div>
            </details>

            <!-- Specifications -->
            <details class="luxury-tab">
              <summary class="luxury-tab-header">
                <span>Especificaciones de Metal & Pureza</span>
                <svg class="tab-chevron" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="6 9 12 15 18 9"></polyline></svg>
              </summary>
              <div class="luxury-tab-content">
                <ul class="specs-bullet-list">
                  <li><strong>Metal:</strong> Oro Genuino Certificado {{ karat_tag }} (No chapado ni laminado)</li>
                  <li><strong>Autenticidad:</strong> Grabado oficial con sello de contraste</li>
                  <li><strong>Acabado:</strong> Pulido a mano con corte italiano de alto brillo</li>
                  <li><strong>Broche / Estructura:</strong> Reforzado para máxima seguridad</li>
                </ul>
              </div>
            </details>

            <!-- Shipping & Delivery -->
            <details class="luxury-tab">
              <summary class="luxury-tab-header">
                <span>Envío Asegurado & Garantía de Entrega</span>
                <svg class="tab-chevron" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="6 9 12 15 18 9"></polyline></svg>
              </summary>
              <div class="luxury-tab-content">
                <p>Todos los pedidos se despachan en empaque de lujo protegido con seguro total contra pérdida o daño. Requiere firma al momento de entrega para tu total tranquilidad.</p>
                <p><strong>Tiempo estimado:</strong> 2 a 4 días hábiles a todo EE. UU. y Puerto Rico.</p>
              </div>
            </details>
          </div>

        </div>
      </div>

    </div>
  </div>

  <!-- FOUR TRUST PILLARS (Integrated at base of product) -->
  <div class="trust-pillars-section">
    <div class="trust-pillars-inner">
      <div class="pillar-card">
        <div class="pillar-icon-box">
          <svg class="MuiSvgIcon-root" focusable="false" viewBox="0 0 24 24"><path d="M12 1L3 5v6c0 5.55 3.84 10.74 9 12 5.16-1.26 9-6.45 9-12V5l-9-4zm-2 16l-4-4 1.41-1.41L10 14.17l6.59-6.59L18 9l-8 8z"/></svg>
        </div>
        <div class="pillar-info">
          <h4>Oro 10K / 14K Garantizado</h4>
          <p>Piezas forjadas exclusivamente en oro auténtico con certificación oficial.</p>
        </div>
      </div>

      <div class="pillar-card">
        <div class="pillar-icon-box">
          <svg class="MuiSvgIcon-root" focusable="false" viewBox="0 0 24 24"><path d="M20 8h-3V4H3c-1.1 0-2 .9-2 2v11h2c0 1.66 1.34 3 3 3s3-1.34 3-3h6c0 1.66 1.34 3 3 3s3-1.34 3-3h2v-5l-3-4zM6 18.5c-.83 0-1.5-.67-1.5-1.5s.67-1.5 1.5-1.5 1.5.67 1.5 1.5-.67 1.5-1.5 1.5zm13.5-9l1.96 2.5H17V9.5h2.5zm-1.5 9c-.83 0-1.5-.67-1.5-1.5s.67-1.5 1.5-1.5 1.5.67 1.5 1.5-.67 1.5-1.5 1.5z"/></svg>
        </div>
        <div class="pillar-info">
          <h4>Envío Asegurado Gratis</h4>
          <p>Cobertura completa y entrega segura en todo EE. UU. y Puerto Rico.</p>
        </div>
      </div>

      <div class="pillar-card">
        <div class="pillar-icon-box">
          <svg class="MuiSvgIcon-root" focusable="false" viewBox="0 0 24 24"><path d="M20 4H4c-1.11 0-1.99.89-1.99 2L2 18c0 1.11.89 2 2 2h16c1.11 0 2-.89 2-2V6c0-1.11-.89-2-2-2zm0 14H4v-6h16v6zm0-10H4V6h16v2z"/></svg>
        </div>
        <div class="pillar-info">
          <h4>Financiamiento Flexible</h4>
          <p>Compra hoy y paga a tu ritmo desde $35/mes con Affirm y 0% APR.</p>
        </div>
      </div>

      <div class="pillar-card">
        <div class="pillar-icon-box">
          <svg class="MuiSvgIcon-root" focusable="false" viewBox="0 0 24 24"><path d="M12 21.35l-1.45-1.32C5.4 15.36 2 12.28 2 8.5 2 5.42 4.42 3 7.5 3c1.74 0 3.41.81 4.5 2.09C13.09 3.81 14.76 3 16.5 3 19.58 3 22 5.42 22 8.5c0 3.78-3.4 6.86-8.55 11.54L12 21.35z"/></svg>
        </div>
        <div class="pillar-info">
          <h4>Garantía de Autenticidad</h4>
          <p>Respaldamos la calidad de cada broche, eslabón y joya de por vida.</p>
        </div>
      </div>
    </div>
  </div>

  <!-- RELATED LUXURY PRODUCTS -->
  {%- assign rec_collection = collection | default: product.collections.first | default: collections['all'] -%}
  {%- if rec_collection != blank and rec_collection.products.size > 1 -%}
    <div class="product-related-section">
      <div class="related-inner">
        <div class="related-header">
          <span class="related-subtitle">COLECCIÓN EXCLUSIVA</span>
          <h2 class="related-title">Joyas Recomendadas para Ti</h2>
        </div>

        <div class="catalog-products-grid">
          {%- assign count = 0 -%}
          {%- for rel_prod in rec_collection.products -%}
            {%- if rel_prod.id != product.id and count < 4 -%}
              {%- assign count = count | plus: 1 -%}
              {%- assign rel_karat = '14K' -%}
              {%- if rel_prod.tags contains '10k' or rel_prod.title contains '10K' or rel_prod.title contains '10k' -%}
                {%- assign rel_karat = '10K' -%}
              {%- endif -%}
              <div class="product-shop-card cutout-product-card">
                <div class="cutout-card-media">
                  <a href="{{ rel_prod.url }}">
                    {%- if rel_prod.featured_image != blank -%}
                      <img src="{{ rel_prod.featured_image | image_url: width: 600 }}" alt="{{ rel_prod.title | escape }}" class="cutout-card-img" loading="lazy">
                    {%- else -%}
                      <img src="{{ 'collection-cadenas.jpg' | asset_url }}" alt="{{ rel_prod.title | escape }}" class="cutout-card-img" loading="lazy">
                    {%- endif -%}
                  </a>
                  <div class="cutout-card-pin">
                    <span>{{ rel_karat }} ORO</span>
                    <svg class="cutout-corner cutout-corner-pin-left" width="24" height="32" viewBox="0 0 24 32" fill="none"><path d="M0 0 H24 V32 C17.38 32 12 24.83 12 16 C12 7.17 6.63 0 0 0 Z" fill="currentColor"/></svg>
                  </div>
                  <div class="cutout-card-inset-label">
                    <span class="cutout-label-text">{{ rel_prod.type | default: 'Joya' | capitalize }}</span>
                    <svg class="cutout-corner cutout-corner-label-right" width="24" height="32" viewBox="0 0 24 32" fill="none"><path d="M0 0 C6.63 0 12 7.17 12 16 C12 24.83 17.38 32 24 32 H0 V0 Z" fill="currentColor"/></svg>
                  </div>
                </div>
                <div class="cutout-card-content">
                  <div class="cutout-title-row">
                    <h4 class="cutout-product-title"><a href="{{ rel_prod.url }}">{{ rel_prod.title }}</a></h4>
                  </div>
                  <div class="product-card-pricing-row">
                    <div class="pricing-amounts">
                      <div class="pricing-numbers-row">
                        <span class="price-now">{{ rel_prod.price | money }}</span>
                        {%- if rel_prod.compare_at_price > rel_prod.price -%}
                          <span class="price-was">{{ rel_prod.compare_at_price | money }}</span>
                        {%- endif -%}
                      </div>
                      <div class="affirm-monthly-badge">Desde <strong>${{ rel_prod.price | divided_by: 1200 | at_least: 35 }}/mes</strong> con Affirm</div>
                    </div>
                    <button class="btn-add-cart-pill" onclick="window.location.href='{{ rel_prod.url }}'" title="Ver Joya" aria-label="Ver Joya">
                      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M16 8a4 4 0 0 1-8 0M3.6 7.4L2.9 15.8C2.8 17.6 2.7 18.5 3 19.2c.3.6.7 1.1 1.3 1.4.7.4 1.6.4 3.4.4h8.6c1.8 0 2.7 0 3.4-.4.6-.3 1-.8 1.3-1.4.3-.7.2-1.6.1-3.4l-.7-8.4c-.1-1.6-.2-2.3-.5-2.9-.3-.5-.8-1-1.3-1.2C18 3 17.2 3 15.6 3H8.4C6.8 3 6 3 5.4 3.3c-.5.2-1 .7-1.3 1.2-.3.6-.4 1.3-.5 2.9z"/></svg>
                    </button>
                  </div>
                </div>
              </div>
            {%- endif -%}
          {%- endfor -%}
        </div>
      </div>
    </div>
  {%- endif -%}

</section>

<!-- INLINE PRODUCT JAVASCRIPT -->
<script>
  function switchProductImage(src, btn) {
    var mainImg = document.getElementById('mainProductImage');
    if (mainImg) {
      mainImg.src = src;
    }
    var thumbs = document.querySelectorAll('.product-thumb-btn');
    thumbs.forEach(function(t) { t.classList.remove('active'); });
    if (btn) btn.classList.add('active');
  }

  function adjustProductQty(delta) {
    var input = document.getElementById('productQuantity');
    if (!input) return;
    var current = parseInt(input.value) || 1;
    var next = Math.max(1, Math.min(10, current + delta));
    input.value = next;
  }

  var productVariants = {{ product.variants | json }};

  function selectVariantOption(optionIndex, value, btn) {
    var labelEl = document.getElementById('selected-val-' + optionIndex);
    if (labelEl) labelEl.textContent = value;
    
    var parent = btn.parentElement;
    parent.querySelectorAll('.btn-variant-pill').forEach(function(p) { p.classList.remove('active'); });
    btn.classList.add('active');

    // Find currently selected values for all options
    var selectedOptions = [];
    document.querySelectorAll('.product-option-group').forEach(function(group, idx) {
      var activeBtn = group.querySelector('.btn-variant-pill.active');
      if (activeBtn) {
        selectedOptions.push(activeBtn.getAttribute('data-value'));
      }
    });

    // Find matching variant
    var matched = productVariants.find(function(v) {
      return v.options.every(function(optVal, idx) {
        return selectedOptions[idx] === optVal;
      });
    });

    if (matched) {
      var hiddenId = document.getElementById('selectedVariantId');
      if (hiddenId) hiddenId.value = matched.id;

      var priceEl = document.getElementById('productPrice');
      if (priceEl && window.Shopify && Shopify.formatMoney) {
        priceEl.textContent = Shopify.formatMoney(matched.price);
      } else if (priceEl) {
        priceEl.textContent = '$' + (matched.price / 100).toFixed(2);
      }

      var addBtn = document.getElementById('btnAddToCart');
      if (addBtn) {
        if (matched.available) {
          addBtn.removeAttribute('disabled');
          addBtn.querySelector('span').textContent = 'AGREGAR AL CARRITO';
        } else {
          addBtn.setAttribute('disabled', 'disabled');
          addBtn.querySelector('span').textContent = 'AGOTADO TEMPORALMENTE';
        }
      }
    }
  }
</script>

