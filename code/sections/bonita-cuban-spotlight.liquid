{{ 'luxury-bonita.css' | asset_url | stylesheet_tag }}

<section class="bonita-cuban-section" id="Cuban-{{ section.id }}">
  <div class="bonita-cuban-container">
    <!-- Visual Media Column -->
    <div class="bonita-cuban-media">
      {%- if section.settings.image != blank -%}
        <img
          src="{{ section.settings.image | image_url: width: 1000 }}"
          alt="{{ section.settings.title | escape }}"
          loading="lazy"
          width="1000"
          height="800"
        >
      {%- else -%}
        <img
          src="https://images.unsplash.com/photo-1599643478518-a784e5dc4c8f?auto=format&fit=crop&w=1000&q=80"
          alt="Cadena Cubana Miami"
          loading="lazy"
          width="1000"
          height="800"
        >
      {%- endif -%}

      <div class="bonita-cuban-stamp">
        <svg width="24" height="24" viewBox="0 0 24 24" fill="var(--bonita-gold-primary)">
          <polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"></polygon>
        </svg>
        <span class="bonita-cuban-stamp-text">100% ORO SÓLIDO</span>
      </div>
    </div>

    <!-- Content Column -->
    <div class="bonita-cuban-content">
      <div class="bonita-badge-inline">
        <span>✦ {{ section.settings.badge | default: 'Especialistas en Cuban Link' }}</span>
      </div>

      <h2 class="bonita-cuban-title">
        {{ section.settings.title_prefix | default: 'LA CADENA CUBANA' }}
        <span class="bonita-gold-text">{{ section.settings.title_highlight | default: 'DEFINITIVA' }}</span>
      </h2>

      <p class="bonita-cuban-desc">
        {{ section.settings.description | default: 'Fabricada siguiendo la tradición orfebre de Miami: eslabones apretados, corte plano perfecto y pulido a espejo. No vendemos hueco ni laminado; garantizamos el peso en gramos y la pureza exacta del oro 10k y 14k.' }}
      </p>

      <!-- Millimeter Gauge Selector -->
      <div class="bonita-mm-gauge">
        <span class="bonita-mm-label">Grosores Más Populares (Milímetros):</span>
        <div class="bonita-mm-list">
          <span class="bonita-mm-pill" onclick="selectMm(this, '4mm')">4 mm</span>
          <span class="bonita-mm-pill" onclick="selectMm(this, '6mm')">6 mm</span>
          <span class="bonita-mm-pill active" onclick="selectMm(this, '8mm')">8 mm (Popular)</span>
          <span class="bonita-mm-pill" onclick="selectMm(this, '10mm')">10 mm</span>
          <span class="bonita-mm-pill" onclick="selectMm(this, '12mm')">12 mm (Pesada)</span>
        </div>
      </div>

      <!-- Key Trust Features -->
      <div class="bonita-cuban-features">
        <div class="bonita-cuban-feature-item">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
            <polyline points="20 6 9 17 4 12"></polyline>
          </svg>
          <span>Eslabón 100% Sólido</span>
        </div>
        <div class="bonita-cuban-feature-item">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
            <polyline points="20 6 9 17 4 12"></polyline>
          </svg>
          <span>Cierre Box Lock Reforzado</span>
        </div>
        <div class="bonita-cuban-feature-item">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
            <polyline points="20 6 9 17 4 12"></polyline>
          </svg>
          <span>Certificado de Gramaje Real</span>
        </div>
        <div class="bonita-cuban-feature-item">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
            <polyline points="20 6 9 17 4 12"></polyline>
          </svg>
          <span>Envío Asegurado Puerta a Puerta</span>
        </div>
      </div>

      <!-- Action -->
      <div style="display: flex; gap: 16px; flex-wrap: wrap;">
        <a href="{{ section.settings.button_url | default: '/collections/all' }}" class="bonita-shimmer-btn">
          <span>{{ section.settings.button_text | default: 'Ver Cadenas Disponibles' }}</span>
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
            <line x1="5" y1="12" x2="19" y2="12"></line>
            <polyline points="12 5 19 12 12 19"></polyline>
          </svg>
        </a>
      </div>
    </div>
  </div>
</section>

<script>
  function selectMm(element, mm) {
    const pills = element.parentElement.querySelectorAll('.bonita-mm-pill');
    pills.forEach(p => p.classList.remove('active'));
    element.classList.add('active');
  }
</script>

{% schema %}
{
  "name": "Spotlight Cadena Cubana",
  "settings": [
    {
      "type": "image_picker",
      "id": "image",
      "label": "Foto de Cadena Cubana"
    },
    {
      "type": "text",
      "id": "badge",
      "label": "Insignia",
      "default": "Especialistas en Cuban Link"
    },
    {
      "type": "text",
      "id": "title_prefix",
      "label": "Título Prefijo",
      "default": "LA CADENA CUBANA"
    },
    {
      "type": "text",
      "id": "title_highlight",
      "label": "Título Resaltado",
      "default": "DEFINITIVA"
    },
    {
      "type": "textarea",
      "id": "description",
      "label": "Descripción",
      "default": "Fabricada siguiendo la tradición orfebre de Miami: eslabones apretados, corte plano perfecto y pulido a espejo. No vendemos hueco ni laminado; garantizamos el peso en gramos y la pureza exacta del oro 10k y 14k."
    },
    {
      "type": "text",
      "id": "button_text",
      "label": "Texto del Botón",
      "default": "Ver Cadenas Disponibles"
    },
    {
      "type": "url",
      "id": "button_url",
      "label": "Enlace del Botón"
    }
  ],
  "presets": [
    {
      "name": "Spotlight Cadena Cubana"
    }
  ]
}
{% endschema %}
