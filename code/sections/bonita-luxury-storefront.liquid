      (function() {
        try {
          var splash = document.getElementById('luxurySplashScreen');
          if (!splash) return;
          var paths = splash.querySelectorAll('.splash-svg-logo path');
          paths.forEach(function(p) {
            var len = Math.ceil(p.getTotalLength()) || 5500;
            var safeLen = Math.ceil(len * 1.05);
            p.style.setProperty('--path-len', safeLen);
            p.style.strokeDasharray = safeLen + ' ' + safeLen;
            p.style.strokeDashoffset = safeLen;
          });
          requestAnimationFrame(function() {
            splash.classList.add('splash-ready');
          });
        } catch(e) {
          var splashEl = document.getElementById('luxurySplashScreen');
          if (splashEl) splashEl.classList.add('splash-ready');
        }
      })();
    </script>
