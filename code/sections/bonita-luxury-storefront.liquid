          <!-- Slider Gramaje a Todo el Ancho -->
          <div class="filter-range-fullwidth">
            <div class="filter-range-header">
              <label for="filterWeight" class="filter-label">Peso Máximo</label>
              <span class="filter-range-val" id="filterWeightVal">Hasta: 70.0 g</span>
            </div>
            <input type="range" id="filterWeight" class="filter-range-input" min="1" max="70" step="0.5" value="70" oninput="updateWeightDisplay(this.value)" onchange="applyCatalogFilters()" aria-label="Filtrar por peso máximo en gramos">
          </div>

