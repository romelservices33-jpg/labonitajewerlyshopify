{{ 'editorial-luxury.css' | asset_url | stylesheet_tag }}

<style>
  /* Seamless Feather Fade on Hero Video to dissolve into Silk background */
  .macro-hero-section {
    position: relative !important;
    background: transparent !important;
  }
  .macro-hero-section video,
  .macro-hero-section .hero-bg-media {
    position: absolute !important;
    inset: 0 !important;
    width: 100% !important;
    height: 100% !important;
    object-fit: cover !important;
    object-position: center 74% !important;
    z-index: 1 !important;
    opacity: 0.88 !important;
    -webkit-mask-image: linear-gradient(to bottom, rgba(0,0,0,1) 0%, rgba(0,0,0,1) 50%, rgba(0,0,0,0.5) 75%, rgba(0,0,0,0) 100%) !important;
    mask-image: linear-gradient(to bottom, rgba(0,0,0,1) 0%, rgba(0,0,0,1) 50%, rgba(0,0,0,0.5) 75%, rgba(0,0,0,0) 100%) !important;
  }
  @media (max-width: 768px) {
    .macro-hero-section video,
    .macro-hero-section .hero-bg-media {
      object-position: center 68% !important;
      -webkit-mask-image: linear-gradient(to bottom, rgba(0,0,0,1) 0%, rgba(0,0,0,1) 30%, rgba(0,0,0,0.2) 46%, rgba(0,0,0,0) 56%) !important;
      mask-image: linear-gradient(to bottom, rgba(0,0,0,1) 0%, rgba(0,0,0,1) 30%, rgba(0,0,0,0.2) 46%, rgba(0,0,0,0) 56%) !important;
    }
    .macro-hero-section .hero-gradient-overlay {
      -webkit-mask-image: linear-gradient(to bottom, rgba(0,0,0,1) 0%, rgba(0,0,0,1) 30%, rgba(0,0,0,0) 56%) !important;
      mask-image: linear-gradient(to bottom, rgba(0,0,0,1) 0%, rgba(0,0,0,1) 30%, rgba(0,0,0,0) 56%) !important;
    }
  }
  .macro-hero-section .hero-gradient-overlay {
    position: absolute !important;
    inset: 0 !important;
    width: 100% !important;
    height: 100% !important;
    background: linear-gradient(
      180deg,
      rgba(8, 25, 91, 0.85) 0%,
      rgba(8, 25, 91, 0.45) 35%,
      rgba(4, 9, 36, 0.3) 65%,
      transparent 100%
    ) !important;
    -webkit-mask-image: linear-gradient(to bottom, rgba(0,0,0,1) 0%, rgba(0,0,0,1) 60%, rgba(0,0,0,0) 100%) !important;
    mask-image: linear-gradient(to bottom, rgba(0,0,0,1) 0%, rgba(0,0,0,1) 60%, rgba(0,0,0,0) 100%) !important;
    backdrop-filter: blur(0.5px) !important;
    -webkit-backdrop-filter: blur(0.5px) !important;
    z-index: 2 !important;
    pointer-events: none !important;
    display: block !important;
  }
  .hero-content-wrap {
    position: relative !important;
    z-index: 10 !important;
  }
  .hero-main-headline {
    color: #FFFFFF !important;
    text-shadow: 0 4px 20px rgba(8, 25, 91, 0.8), 0 1px 4px rgba(0, 0, 0, 0.6) !important;
  }
  .hero-main-headline span.gold-highlight {
    color: #D1B054 !important;
    text-shadow: 0 2px 14px rgba(209, 176, 84, 0.5), 0 1px 3px rgba(8, 25, 91, 0.8) !important;
  }
  .hero-supporting-copy {
    color: rgba(255, 255, 255, 0.98) !important;
    text-shadow: 0 2px 12px rgba(8, 25, 91, 0.8), 0 1px 3px rgba(0, 0, 0, 0.5) !important;
  }
</style>

