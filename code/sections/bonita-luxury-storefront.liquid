                    <input id="karat-10k" name="filter-karat" type="radio" value="10k" onchange="handleSelectOption('karat', '10k', 'Oro 10K Auténtico')">
                    <label class="option" for="karat-10k" data-txt="Oro 10K Auténtico"></label>
