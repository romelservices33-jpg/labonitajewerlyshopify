          <h4 style="font-size:0.95rem; font-weight:600; color: var(--color-royal-navy);">Cadena Sólido 10K Italian Curb</h4>
          <div style="font-size:0.8rem; color:#6B7280;">24" · 4.7 mm · 12.06 g</div>
          <div style="font-size:0.95rem; font-weight:700; color: var(--color-royal-navy); margin-top:4px;">$1,380 USD</div>
        </div>
        <button style="background:none; border:none; color:#9CA3AF; cursor:pointer; display:inline-flex; align-items:center; padding:4px;" onclick="removeCartSample()" aria-label="Eliminar">
          <svg class="MuiSvgIcon-root MuiSvgIcon-fontSizeSmall" focusable="false" viewBox="0 0 24 24" aria-hidden="true">
            <path d="M19 6.41L17.59 5 12 10.59 6.41 5 5 6.41 10.59 12 5 17.59 6.41 19 12 13.41 17.59 19 19 17.59 13.41 12z"></path>
          </svg>
        </button>
      </div>
    </div>
    <div class="cart-panel-footer">
      <div style="display:flex; justify-content:space-between; align-items:baseline; margin-bottom:16px;">
        <span style="font-size:0.85rem; color:#6B7280; text-transform:uppercase; letter-spacing:0.05em;">Subtotal Estimado</span>
        <span style="font-size:1.3rem; font-weight:700; color: var(--color-royal-navy);" id="cartSubtotal">$1,380 USD</span>
      </div>
      <div style="font-size:0.75rem; color:#6B7280; margin-bottom:12px; text-align:center; display:flex; align-items:center; justify-content:center; gap:6px;" id="cartAffirmEstimate">
        <svg viewBox="0 0 24 24" width="15" height="15" fill="currentColor"><path d="M20 4H4c-1.11 0-1.99.89-1.99 2L2 18c0 1.11.89 2 2 2h16c1.11 0 2-.89 2-2V6c0-1.11-.89-2-2-2zm0 14H4v-6h16v6zm0-10H4V6h16v2z"/></svg>
        <span>O divide este pedido en cuotas desde <strong>$115/mes</strong> con Affirm</span>
      </div>
      <button class="btn-black-pill" style="width:100%; text-align:center; padding:14px; cursor:pointer;" onclick="window.location.href='checkout.html'">
        Pagar Pedido Seguro →
      </button>
    </div>
  </aside>

  <!-- TOAST FEEDBACK -->
  <div class="toast-pill" id="toastPill">Joya agregada a tu carrito.</div>

  <!-- GSAP 3 & SCROLLTRIGGER LUXURY ANIMATION SUITE -->
  <script src="https://cdnjs.cloudflare.com/ajax/libs/gsap/3.12.5/gsap.min.js"></script>
  <script src="https://cdnjs.cloudflare.com/ajax/libs/gsap/3.12.5/ScrollTrigger.min.js"></script>

  <!-- SCRIPT -->
  <script>
    const MUI_HEART_OUTLINE = "M16.5 3c-1.74 0-3.41.81-4.5 2.09C10.91 3.81 9.24 3 7.5 3 4.42 3 2 5.42 2 8.5c0 3.78 3.4 6.86 8.55 11.54L12 21.35l1.45-1.32C18.6 15.36 22 12.28 22 8.5 22 5.42 19.58 3 16.5 3zm-4.4 15.55l-.1.1-.1-.1C7.14 14.24 4 11.39 4 8.5 4 6.5 5.5 5 7.5 5c1.54 0 3.04.99 3.57 2.36h1.87C13.46 5.99 14.96 5 16.5 5c2 0 3.5 1.5 3.5 3.5 0 2.89-3.14 5.74-7.9 10.05z";
    const MUI_HEART_FILLED = "M12 21.35l-1.45-1.32C5.4 15.36 2 12.28 2 8.5 2 5.42 4.42 3 7.5 3 4.42 3 2 5.42 2 8.5c0 3.78-3.4 6.86-8.55 11.54L12 21.35z";

    /* Global Cart State */
    let cartItems = [
      {
        id: 1,
        title: "Cadena Sólido 10K Italian Curb",
        spec: "24\" · 4.7 mm · 12.06 g",
        price: 1380,
        qty: 1,
        img: "assets/collection-cadenas.jpg"
      }
    ];

    function openCart() {
      document.getElementById('cartBackdrop').classList.add('open');
      document.getElementById('cartPanel').classList.add('open');
      renderCartItems();
    }

    function closeCart() {
      document.getElementById('cartBackdrop').classList.remove('open');
      document.getElementById('cartPanel').classList.remove('open');
    }

    function updateCartUI() {
      const subtotal = cartItems.reduce((sum, item) => sum + (item.price * item.qty), 0);
      const totalCount = cartItems.reduce((sum, item) => sum + item.qty, 0);

      const cartSubtotalEl = document.getElementById('cartSubtotal');
      if (cartSubtotalEl) cartSubtotalEl.textContent = '$' + subtotal.toLocaleString() + ' USD';

      const badgeHeader = document.getElementById('cartCountHeader');
      if (badgeHeader) badgeHeader.textContent = totalCount;

      const badgeHeaderNav = document.getElementById('cartCountBadge');
      if (badgeHeaderNav) badgeHeaderNav.textContent = totalCount;

      const mbDock = document.getElementById('mobileDockCartBadge');
      if (mbDock) mbDock.textContent = totalCount;

      // Affirm monthly estimate in Cart Drawer
      const affirmEl = document.getElementById('cartAffirmEstimate');
      if (affirmEl) {
        if (subtotal > 0) {
          const monthly = Math.round(subtotal / 12);
          affirmEl.innerHTML = `<svg viewBox="0 0 24 24" width="15" height="15" fill="currentColor"><path d="M20 4H4c-1.11 0-1.99.89-1.99 2L2 18c0 1.11.89 2 2 2h16c1.11 0 2-.89 2-2V6c0-1.11-.89-2-2-2zm0 14H4v-6h16v6zm0-10H4V6h16v2z"/></svg><span>O divide este pedido en cuotas desde <strong>$${monthly}/mes</strong> con Affirm</span>`;
          affirmEl.style.display = 'flex';
        } else {
          affirmEl.style.display = 'none';
        }
      }

      // Dynamic Free Shipping Progress Bar ($150 USD Threshold)
      const threshold = 150;
      const fillEl = document.getElementById('freeShippingFill');
      const statusEl = document.getElementById('freeShippingStatus');

      if (fillEl && statusEl) {
        if (subtotal >= threshold) {
          fillEl.style.width = '100%';
          fillEl.style.background = 'linear-gradient(90deg, #10B981 0%, #059669 100%)';
          statusEl.innerHTML = '<span style="color:#059669; display:inline-flex; align-items:center; gap:5px;"><svg viewBox="0 0 24 24" width="15" height="15" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"></polyline></svg> ¡Felicidades! Tienes Envío Gratis</span>';
        } else {
          const pct = Math.max(8, Math.round((subtotal / threshold) * 100));
          const remaining = threshold - subtotal;
          fillEl.style.width = pct + '%';
          fillEl.style.background = 'linear-gradient(90deg, #D1B054 0%, #08195B 100%)';
          statusEl.innerHTML = `¡Te faltan <strong>$${remaining.toLocaleString()} USD</strong> para Envío Gratis!`;
        }
      }
    }

    function renderCartItems() {
      const container = document.getElementById('cartItemsContainer');
      if (!container) return;

      if (cartItems.length === 0) {
        container.innerHTML = `
          <div style="text-align:center; padding: 48px 20px; color:#64748B;">
            <svg viewBox="0 0 24 24" width="48" height="48" fill="none" stroke="currentColor" stroke-width="1.5" style="margin-bottom:12px; opacity:0.45;">
              <path d="M6 2L3 6v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6l-3-4z"></path>
              <line x1="3" y1="6" x2="21" y2="6"></line>
              <path d="M16 10a4 4 0 0 1-8 0"></path>
            </svg>
            <p style="font-size:0.95rem; font-weight:600; color:#08195B; margin-bottom:6px;">Tu carrito está vacío</p>
            <p style="font-size:0.8rem; margin-bottom:18px;">Explora nuestras piezas en oro 100% auténtico 10K y 14K.</p>
            <button class="btn-black-pill" onclick="closeCart(); scrollToCatalog();" style="padding:10px 20px; font-size:0.82rem;">Ver Catálogo</button>
          </div>
        `;
      } else {
        container.innerHTML = cartItems.map(item => {
          const thumbHtml = (item.img && item.img !== 'mock' && !item.img.includes('mock'))
            ? `<img src="${item.img}" style="width:72px; height:72px; object-fit:cover; background:#FAF9F6; border-radius:12px; border:1px solid rgba(209,176,84,0.25);">`
            : `<div style="width:72px; height:72px; display:flex; flex-direction:column; align-items:center; justify-content:center; gap:3px; background:#F5F3ED; border-radius:12px; border:1px solid rgba(209,176,84,0.3); color:#8C94A0;"><svg viewBox="0 0 24 24" width="24" height="24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M23 19a2 2 0 0 1-2 2H3a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h4l2-3h6l2 3h4a2 2 0 0 1 2 2z"/><circle cx="12" cy="13" r="4"/><circle cx="18" cy="10" r="1" fill="currentColor"/></svg><span style="font-size:0.58rem; letter-spacing:0.06em; text-transform:uppercase; font-weight:700;">Oro Real</span></div>`;

          return `
            <div style="display:flex; gap:14px; align-items:center; padding:14px 0; border-bottom:1px solid #ECEAE5;" data-item-id="${item.id}">
              ${thumbHtml}
              <div style="flex:1; min-width:0;">
                <h4 style="font-size:0.92rem; font-weight:600; color:#08195B; line-height:1.25; margin-bottom:2px; white-space:nowrap; overflow:hidden; text-overflow:ellipsis;">${item.title}</h4>
                <div style="font-size:0.78rem; color:#6B7280; margin-bottom:4px;">${item.spec || 'Oro Sólido Garantizado'}</div>
                <div style="display:flex; align-items:center; justify-content:space-between;">
                  <span style="font-size:0.95rem; font-weight:700; color:#08195B;">$${(item.price * item.qty).toLocaleString()} USD</span>
                  <div style="display:inline-flex; align-items:center; border:1px solid #E2E8F0; border-radius:6px; background:#FFFFFF;">
                    <button style="border:none; background:transparent; padding:2px 8px; font-weight:700; color:#08195B; cursor:pointer;" onclick="changeCartItemQty(${item.id}, -1)">-</button>
                    <span style="font-size:0.8rem; font-weight:700; padding:0 4px; min-width:18px; text-align:center;">${item.qty}</span>
                    <button style="border:none; background:transparent; padding:2px 8px; font-weight:700; color:#08195B; cursor:pointer;" onclick="changeCartItemQty(${item.id}, 1)">+</button>
                  </div>
                </div>
              </div>
              <button style="background:none; border:none; color:#9CA3AF; cursor:pointer; display:inline-flex; align-items:center; padding:4px;" onclick="removeCartItem(${item.id})" aria-label="Eliminar ${item.title}">
                <svg class="MuiSvgIcon-root MuiSvgIcon-fontSizeSmall" focusable="false" viewBox="0 0 24 24" aria-hidden="true">
                  <path d="M19 6.41L17.59 5 12 10.59 6.41 5 5 6.41 10.59 12 5 17.59 6.41 19 12 13.41 17.59 19 19 17.59 13.41 12z"></path>
                </svg>
              </button>
            </div>
          `;
        }).join('');
      }

      updateCartUI();
    }

    function removeCartItem(id) {
      cartItems = cartItems.filter(item => item.id !== id);
      renderCartItems();
      showToast('Artículo eliminado del carrito');
    }

    function changeCartItemQty(id, delta) {
      const item = cartItems.find(it => it.id === id);
      if (!item) return;
      item.qty += delta;
      if (item.qty <= 0) {
        removeCartItem(id);
      } else {
        renderCartItems();
      }
    }

    function removeCartSample() {
      removeCartItem(1);
    }

    function addToCartItem(name, price, img, metadata) {
      const existing = cartItems.find(it => it.title === name);
      if (existing) {
        existing.qty += (metadata && metadata.qty) ? metadata.qty : 1;
      } else {
        cartItems.unshift({
          id: Date.now(),
          title: name,
          spec: (metadata && metadata.spec) ? metadata.spec : 'Oro 100% Auténtico Certificado',
          price: price,
          qty: (metadata && metadata.qty) ? metadata.qty : 1,
          img: img || 'mock'
        });
      }

      renderCartItems();
      showToast(name + ' agregada al carrito');
      openCart();
    }

    /* ==========================================================================
       LUXURY QUICK VIEW PDP MODAL CONTROLLER
       ========================================================================== */
    let currentModalProduct = null;

    const CATEGORY_SIZES = {
      cadenas: [
        { label: '18"', value: '18', factor: 0.90 },
        { label: '20"', value: '20', factor: 0.95 },
        { label: '22"', value: '22', factor: 1.00 },
        { label: '24"', value: '24', factor: 1.05 },
        { label: '26"', value: '26', factor: 1.10 },
        { label: '28"', value: '28', factor: 1.16 }
      ],
      cuban: [
        { label: '20"', value: '20', factor: 0.94 },
        { label: '22"', value: '22', factor: 1.00 },
        { label: '24"', value: '24', factor: 1.06 },
        { label: '26"', value: '26', factor: 1.12 }
      ],
      pulseras: [
        { label: '7.0"', value: '7.0', factor: 0.94 },
        { label: '7.5"', value: '7.5', factor: 1.00 },
        { label: '8.0"', value: '8.0', factor: 1.06 },
        { label: '8.5"', value: '8.5', factor: 1.12 }
      ],
      anillos: [
        { label: 'Talla #7', value: '7', factor: 0.96 },
        { label: 'Talla #8', value: '8', factor: 1.00 },
        { label: 'Talla #9', value: '9', factor: 1.04 },
        { label: 'Talla #10', value: '10', factor: 1.08 },
        { label: 'Talla #11', value: '11', factor: 1.12 }
      ],
      aretes: [
        { label: '12 mm', value: '12mm', factor: 0.90 },
        { label: '15 mm', value: '15mm', factor: 1.00 },
        { label: '18 mm', value: '18mm', factor: 1.15 }
      ],
      dijes: [
        { label: 'Mediano (25mm)', value: 'M', factor: 0.90 },
        { label: 'Grande (35mm)', value: 'L', factor: 1.00 },
        { label: 'XL Master (45mm)', value: 'XL', factor: 1.25 }
      ]
    };

    function openProductModalFromCard(card) {
      if (!card) return;
      const titleEl = card.querySelector('.cutout-product-title');
      const specEl = card.querySelector('.spec-weight-tag');
      const imgEl = card.querySelector('.cutout-card-image');
      const badgeEl = card.querySelector('.cutout-card-pin span');

      const title = titleEl ? titleEl.textContent.trim() : 'Joya de Oro La Bonita';
      const spec = specEl ? specEl.textContent.trim() : '';
      const category = (card.getAttribute('data-category') || 'cadenas').toLowerCase();
      const karat = (card.getAttribute('data-karat') || '14k').toLowerCase();
      const price = parseFloat(card.getAttribute('data-price')) || 1200;
      const weight = parseFloat(card.getAttribute('data-weight')) || 10.0;
      const size = card.getAttribute('data-size') || '22';
      const imgSrc = imgEl ? imgEl.getAttribute('src') : null;
      const badge = badgeEl ? badgeEl.textContent.trim() : 'Oro 100% Auténtico';

      currentModalProduct = {
        title,
        spec,
        category,
        baseKarat: karat,
        selectedKarat: karat,
        basePrice: price,
        baseWeight: weight,
        baseSize: size,
        selectedSize: size,
        qty: 1,
        imgSrc,
        badge
      };

      populateProductModalUI();

      const modal = document.getElementById('productModal');
      if (modal) {
        modal.classList.add('open');
        document.body.style.overflow = 'hidden';
      }
    }

    function closeProductModal() {
      const modal = document.getElementById('productModal');
      if (modal) {
        modal.classList.remove('open');
        document.body.style.overflow = '';
      }
    }

    function handleModalBackdropClick(e) {
      if (e.target.id === 'productModal') {
        closeProductModal();
      }
    }

    function populateProductModalUI() {
      if (!currentModalProduct) return;
      const p = currentModalProduct;

      // 1. Image & Badge
      const imgEl = document.getElementById('modalMainImg');
      const placeholderEl = document.getElementById('modalMockPlaceholder');
      const badgeEl = document.getElementById('modalBadge');

      if (p.imgSrc && p.imgSrc !== 'mock' && !p.imgSrc.includes('mock')) {
        if (imgEl) {
          imgEl.src = p.imgSrc;
          imgEl.alt = p.title;
          imgEl.style.display = 'block';
        }
        if (placeholderEl) placeholderEl.style.display = 'none';
      } else {
        if (imgEl) imgEl.style.display = 'none';
        if (placeholderEl) placeholderEl.style.display = 'flex';
      }

      if (badgeEl) badgeEl.textContent = p.badge || (p.selectedKarat.toUpperCase() + ' Sólido');

      // 2. Meta, Title
      const catTag = document.getElementById('modalCategoryTag');
      if (catTag) catTag.textContent = 'COLECCIÓN ' + p.category.toUpperCase() + ' · LA BONITA';

      const titleEl = document.getElementById('modalProductTitle');
      if (titleEl) titleEl.textContent = p.title;

      // 3. Karat Pills State
      const pill10 = document.getElementById('pillKarat10k');
      const pill14 = document.getElementById('pillKarat14k');
      if (pill10) pill10.classList.toggle('active', p.selectedKarat === '10k');
      if (pill14) pill14.classList.toggle('active', p.selectedKarat === '14k');

      const karatTxt = document.getElementById('modalSelectedKaratText');
      if (karatTxt) karatTxt.textContent = (p.selectedKarat === '14k') ? 'Oro 14K Sólido (58.5% Pureza)' : 'Oro 10K Sólido (41.7% Pureza)';

      // 4. Generate Size Pills dynamically
      const sizeContainer = document.getElementById('modalSizePills');
      const sizesList = CATEGORY_SIZES[p.category] || CATEGORY_SIZES.cadenas;

      if (sizeContainer) {
        sizeContainer.innerHTML = sizesList.map(s => {
          const isActive = (s.value === p.selectedSize || String(s.value).includes(p.selectedSize) || p.selectedSize.includes(String(s.value)));
          return `<button type="button" class="pdp-variant-pill ${isActive ? 'active' : ''}" onclick="selectModalSize('${s.value}')">${s.label}</button>`;
        }).join('');
      }

      const sizeTxt = document.getElementById('modalSelectedSizeText');
      if (sizeTxt) {
        const activeObj = sizesList.find(s => s.value === p.selectedSize) || sizesList[0];
        sizeTxt.textContent = activeObj ? activeObj.label : p.selectedSize;
      }

      // 5. Quantity Reset
      const qtyInput = document.getElementById('modalQtyInput');
      if (qtyInput) qtyInput.value = p.qty || 1;

      // 6. Recalculate Prices, Weight & Specs Table
      recalculateModalPricing();
    }

    function selectModalKarat(karat) {
      if (!currentModalProduct) return;
      currentModalProduct.selectedKarat = karat;
      populateProductModalUI();
    }

    function selectModalSize(sizeVal) {
      if (!currentModalProduct) return;
      currentModalProduct.selectedSize = sizeVal;
      populateProductModalUI();
    }

    function changeModalQty(delta) {
      if (!currentModalProduct) return;
      let newQty = (currentModalProduct.qty || 1) + delta;
      if (newQty < 1) newQty = 1;
      if (newQty > 10) newQty = 10;
      currentModalProduct.qty = newQty;
      const qtyInput = document.getElementById('modalQtyInput');
      if (qtyInput) qtyInput.value = newQty;
      recalculateModalPricing();
    }

    function recalculateModalPricing() {
      if (!currentModalProduct) return;
      const p = currentModalProduct;

      // Karat Multiplier (relative to base)
      let karatPriceFactor = 1.0;
      let karatWeightFactor = 1.0;

      if (p.baseKarat === '10k' && p.selectedKarat === '14k') {
        karatPriceFactor = 1.34;
        karatWeightFactor = 1.18;
      } else if (p.baseKarat === '14k' && p.selectedKarat === '10k') {
        karatPriceFactor = 0.746;
        karatWeightFactor = 0.847;
      }

      // Size Multiplier
      const sizesList = CATEGORY_SIZES[p.category] || CATEGORY_SIZES.cadenas;
      const activeSizeObj = sizesList.find(s => s.value === p.selectedSize) || sizesList[0];
      const sizeFactor = activeSizeObj ? activeSizeObj.factor : 1.0;

      const calcUnitPrice = Math.round(p.basePrice * karatPriceFactor * sizeFactor);
      const calcUnitWeight = (p.baseWeight * karatWeightFactor * sizeFactor).toFixed(2);
      const totalPrice = calcUnitPrice * (p.qty || 1);
      const oldPrice = Math.round(calcUnitPrice * 1.15);
      const monthlyAffirm = Math.round(totalPrice / 12);

      // DOM Updates
      const curPriceEl = document.getElementById('modalPriceCurrent');
      if (curPriceEl) curPriceEl.textContent = '$' + totalPrice.toLocaleString() + ' USD';

      const oldPriceEl = document.getElementById('modalPriceOld');
      if (oldPriceEl) oldPriceEl.textContent = '$' + (oldPrice * (p.qty || 1)).toLocaleString() + ' USD';

      const gramRateEl = document.getElementById('modalGramRate');
      if (gramRateEl) gramRateEl.textContent = `Oro ${p.selectedKarat.toUpperCase()} Macizo · ${calcUnitWeight} g`;

      const affirmMoEl = document.getElementById('modalAffirmMo');
      if (affirmMoEl) affirmMoEl.textContent = `$${monthlyAffirm}/mes`;

      // Specs Table Update
      const specKarat = document.getElementById('modalSpecKarat');
      if (specKarat) specKarat.textContent = `Oro ${p.selectedKarat.toUpperCase()} Sólido Garantizado (No Laminado)`;

      const specWeight = document.getElementById('modalSpecWeight');
      if (specWeight) specWeight.textContent = `${calcUnitWeight} gramos (Aprox.)`;

      const specSize = document.getElementById('modalSpecSize');
      if (specSize) specSize.textContent = activeSizeObj ? activeSizeObj.label : p.selectedSize;

      const specClasp = document.getElementById('modalSpecClasp');
      if (specClasp) {
        if (p.category === 'anillos') {
          specClasp.textContent = 'Engaste Suizo de Alta Precisión';
        } else if (p.category === 'aretes') {
          specClasp.textContent = 'Cierre Omega / Rosca de Seguridad';
        } else if (p.category === 'dijes') {
          specClasp.textContent = 'Asa Reforzada para Cadenas Pesadas';
        } else {
          specClasp.textContent = 'Caja con Doble Seguro de Presión';
        }
      }

      p.currentCalculatedPrice = calcUnitPrice;
      p.currentCalculatedWeight = calcUnitWeight;
    }

    function addModalProductToCart() {
      if (!currentModalProduct) return;
      const p = currentModalProduct;
      const title = `${p.title} (${p.selectedKarat.toUpperCase()})`;
      const spec = `${p.selectedSize} · ${p.currentCalculatedWeight} g · Oro ${p.selectedKarat.toUpperCase()} Sólido`;
      const unitPrice = p.currentCalculatedPrice || p.basePrice;
      const qty = p.qty || 1;

      addToCartItem(title, unitPrice, p.imgSrc, { spec, qty, karat: p.selectedKarat, size: p.selectedSize });
      closeProductModal();
    }

    // Attach card click delegation
    document.addEventListener('DOMContentLoaded', () => {
      renderCartItems();

      document.body.addEventListener('click', (e) => {
        const card = e.target.closest('.cutout-product-card, .product-shop-card');
        if (!card) return;

        // If user clicked heart wishlist, do not open modal
        if (e.target.closest('.cutout-card-wishlist')) return;

        // If user clicked direct add-to-cart button, do not open modal
        if (e.target.closest('.btn-add-cart-pill')) return;

        // Open modal
        openProductModalFromCard(card);
      });
    });

    let currentCatalogCategory = 'todos';

    function updateWeightDisplay(val) {
      const el = document.getElementById('filterWeightVal');
      if (el) {
        el.textContent = 'Hasta: ' + parseFloat(val).toFixed(1) + ' g';
      }
    }

    function handleSelectOption(type, val, txt) {
      if (type === 'karat') {
        const textEl = document.getElementById('selectedKaratText');
        if (textEl) textEl.textContent = txt;
      } else if (type === 'size') {
        const textEl = document.getElementById('selectedSizeText');
        if (textEl) textEl.textContent = txt;
      } else if (type === 'sort') {
        const textEl = document.getElementById('selectedSortText');
        if (textEl) textEl.textContent = txt;
      }

      // Close open dropdowns
      document.querySelectorAll('.uiverse-select').forEach(s => s.classList.remove('is-open'));

      // Apply the filter reactively
      applyCatalogFilters();
    }

    function applyCatalogFilters() {
      const karatRadio = document.querySelector('input[name="filter-karat"]:checked');
      const karat = karatRadio ? karatRadio.value : 'all';

      const sizeRadio = document.querySelector('input[name="filter-size"]:checked');
      const size = sizeRadio ? sizeRadio.value : 'all';

      const weightEl = document.getElementById('filterWeight');
      const maxWeight = weightEl ? parseFloat(weightEl.value) : 70;

      const sortRadio = document.querySelector('input[name="filter-sort"]:checked');
      const sortBy = sortRadio ? sortRadio.value : 'default';

      const grid = document.getElementById('catalogProductsGrid');
      if (!grid) return;

      const cards = Array.from(grid.querySelectorAll('.cutout-product-card'));
      let visibleCount = 0;

      // 1. Filter cards
      cards.forEach(card => {
        const cCat = card.getAttribute('data-category') || '';
        const cKarat = card.getAttribute('data-karat') || '';
        const cSize = card.getAttribute('data-size') || '';
        const cWeight = parseFloat(card.getAttribute('data-weight')) || 0;

        const matchCat = (currentCatalogCategory === 'todos' || cCat === currentCatalogCategory);
        const matchKarat = (karat === 'all' || cKarat === karat);
        const matchSize = (size === 'all' || cSize.indexOf(size) !== -1);
        const matchWeight = (cWeight <= maxWeight);

        if (matchCat && matchKarat && matchSize && matchWeight) {
          card.classList.remove('is-filtered-out');
          visibleCount++;
        } else {
          card.classList.add('is-filtered-out');
        }
      });

      // 2. Sort cards if needed
      if (sortBy !== 'default') {
        cards.sort((a, b) => {
          const aPrice = parseFloat(a.getAttribute('data-price')) || 0;
          const bPrice = parseFloat(b.getAttribute('data-price')) || 0;
          const aWeight = parseFloat(a.getAttribute('data-weight')) || 0;
          const bWeight = parseFloat(b.getAttribute('data-weight')) || 0;
          const aOrder = parseInt(a.getAttribute('data-default-order')) || 0;
          const bOrder = parseInt(b.getAttribute('data-default-order')) || 0;

          if (sortBy === 'price-asc') return aPrice - bPrice;
          if (sortBy === 'price-desc') return bPrice - aPrice;
          if (sortBy === 'weight-asc') return aWeight - bWeight;
          if (sortBy === 'weight-desc') return bWeight - aWeight;
          return aOrder - bOrder;
        });
      } else {
        cards.sort((a, b) => {
          const aOrder = parseInt(a.getAttribute('data-default-order')) || 0;
          const bOrder = parseInt(b.getAttribute('data-default-order')) || 0;
          return aOrder - bOrder;
        });
      }

      // Re-append sorted cards before empty state
      const emptyState = document.getElementById('catalogEmptyState');
      cards.forEach(card => {
        if (emptyState) {
          grid.insertBefore(card, emptyState);
        } else {
          grid.appendChild(card);
        }
      });

      // 3. Toggle empty state
      if (emptyState) {
        emptyState.style.display = (visibleCount === 0) ? 'flex' : 'none';
      }

      // 4. Update results counter
      const countEl = document.getElementById('filterCount');
      if (countEl) {
        if (visibleCount === 0) {
          countEl.textContent = '0 piezas encontradas';
        } else if (visibleCount === 1) {
          countEl.textContent = 'Mostrando 1 pieza de oro';
        } else {
          countEl.textContent = 'Mostrando ' + visibleCount + ' piezas de oro';
        }
      }

      // 5. Toggle reset button visibility
      const resetBtn = document.getElementById('btnFilterReset');
      if (resetBtn) {
        const isModified = (currentCatalogCategory !== 'todos') || (karat !== 'all') || (size !== 'all') || (maxWeight < 70) || (sortBy !== 'default');
        resetBtn.classList.toggle('active', isModified);
      }
    }

    function resetCatalogFilters() {
      currentCatalogCategory = 'todos';

      // Reset category tab active states
      document.querySelectorAll('.cat-tab-btn').forEach(btn => {
        btn.classList.toggle('active', btn.getAttribute('data-cat') === 'todos');
      });

      // Reset Uiverse custom selects
      const kAll = document.getElementById('karat-all');
      if (kAll) kAll.checked = true;
      const kTxt = document.getElementById('selectedKaratText');
      if (kTxt) kTxt.textContent = 'Todas las purezas';

      const sAll = document.getElementById('size-all');
      if (sAll) sAll.checked = true;
      const sTxt = document.getElementById('selectedSizeText');
      if (sTxt) sTxt.textContent = 'Todas las medidas';

      const sortDef = document.getElementById('sort-default');
      if (sortDef) sortDef.checked = true;
      const sortTxt = document.getElementById('selectedSortText');
      if (sortTxt) sortTxt.textContent = 'Destacados La Bonita';

      const w = document.getElementById('filterWeight');
      if (w) {
        w.value = 70;
        updateWeightDisplay(70);
      }

      applyCatalogFilters();
    }

    // Toggle dropdown on touch or click
    document.addEventListener('click', function(e) {
      const selectedEl = e.target.closest('.uiverse-select .selected');
      if (selectedEl) {
        const parentSelect = selectedEl.closest('.uiverse-select');
        const wasOpen = parentSelect.classList.contains('is-open');
        document.querySelectorAll('.uiverse-select').forEach(s => s.classList.remove('is-open'));
        if (!wasOpen) {
          parentSelect.classList.add('is-open');
        }
        return;
      }
      if (!e.target.closest('.uiverse-select')) {
        document.querySelectorAll('.uiverse-select').forEach(s => s.classList.remove('is-open'));
      }
    });

    function filterCatalog(category, tabBtn) {
      currentCatalogCategory = category;

      // Dynamic Editorial Collection Banners
      const titleEl = document.getElementById('catalogTitle');
      const subtitleEl = document.getElementById('catalogSubtitle');
      if (titleEl && subtitleEl) {
        if (category === 'cadenas') {
          titleEl.innerHTML = 'Cadenas <span class="accent-gold">Cubanas & Italianas</span>';
          subtitleEl.textContent = 'Eslabones macizos fundidos a mano en oro auténtico 10K y 14K con broche de seguridad.';
        } else if (category === 'anillos') {
          titleEl.innerHTML = 'Anillos de <span class="accent-gold">Compromiso & Sello</span>';
          subtitleEl.textContent = 'Piezas forjadas con acabados de alta orfebrería y piedras engastadas a mano.';
        } else if (category === 'aretes') {
          titleEl.innerHTML = 'Aretes & <span class="accent-gold">Arracadas de Lujo</span>';
          subtitleEl.textContent = 'Diseños italianos ligeros y cómodos para uso diario en oro sólido garantizado.';
        } else if (category === 'pulseras') {
          titleEl.innerHTML = 'Pulseras & <span class="accent-gold">Bangles Exclusivos</span>';
          subtitleEl.textContent = 'Manillas y brazaletes pesados con cierre de caja reforzado y oro certificado.';
        } else if (category === 'cuban') {
          titleEl.innerHTML = 'Especialidad <span class="accent-gold">Cuban Links</span>';
          subtitleEl.textContent = 'Nuestra firma insignia: cadenas y manillas Miami Cuban macizas garantizadas.';
        } else if (category === 'dijes') {
          titleEl.innerHTML = 'Dijes & <span class="accent-gold">Medallas Sagradas</span>';
          subtitleEl.textContent = 'Cruces, Cristos y medallas talladas en relieve con brillo diamantado superior.';
        } else {
          titleEl.innerHTML = 'Catálogo <span class="accent-gold">Exclusivo</span>';
          subtitleEl.textContent = 'Oro 100% auténtico 10K y 14K con peso garantizado y financiamiento Affirm.';
        }
      }

      if (tabBtn) {
        document.querySelectorAll('.cat-tab-btn').forEach(btn => btn.classList.remove('active'));
        tabBtn.classList.add('active');
      } else {
        document.querySelectorAll('.cat-tab-btn').forEach(btn => {
          const bCat = btn.getAttribute('data-cat');
          if (bCat === category) {
            document.querySelectorAll('.cat-tab-btn').forEach(b => b.classList.remove('active'));
            btn.classList.add('active');
          }
        });
      }

      applyCatalogFilters();

      const catalogEl = document.getElementById('catalogo');
      if (catalogEl && !tabBtn) {
        catalogEl.scrollIntoView({ behavior: 'smooth' });
      }
    }

    function toggleHeart(btn) {
      const path = btn.querySelector('path');
      if (!path) return;
      const isFilled = btn.classList.toggle('active');
      if (isFilled) {
        path.setAttribute('d', MUI_HEART_FILLED);
        btn.style.color = '#D1B054';
        showToast('Guardado en tus favoritos');
      } else {
        path.setAttribute('d', MUI_HEART_OUTLINE);
        btn.style.color = '';
        showToast('Eliminado de favoritos');
      }
    }

    function showToast(msg) {
      const t = document.getElementById('toastPill');
      t.textContent = msg;
      t.classList.add('show');
      setTimeout(() => t.classList.remove('show'), 2500);
    }

    function scrollToCatalog() {
      document.getElementById('catalogo').scrollIntoView({ behavior: 'smooth' });
    }

    /* Adaptive Notch Navigation Interactivity */
    function toggleMobileNotch() {
      const dd = document.getElementById('notchMobileDropdown');
      const ch = document.getElementById('mobileNotchChevron');
      if (dd) {
        dd.classList.toggle('open');
        if (ch) ch.style.transform = dd.classList.contains('open') ? 'rotate(180deg)' : 'rotate(0)';
      }
    }

    function closeMobileNotch(label) {
      const dd = document.getElementById('notchMobileDropdown');
      const ch = document.getElementById('mobileNotchChevron');
      const lb = document.getElementById('mobileNotchLabel');
      if (dd) dd.classList.remove('open');
      if (ch) ch.style.transform = 'rotate(0)';
      if (lb && label) lb.textContent = label;
    }

    document.querySelectorAll('.hero-nav-link, .notch-item-btn').forEach(btn => {
      btn.addEventListener('click', function() {
        document.querySelectorAll('.hero-nav-link, .notch-item-btn').forEach(b => b.classList.remove('active'));
        this.classList.add('active');
      });
    });

    function setActiveDock(el) {
      document.querySelectorAll('.dock-item').forEach(item => item.classList.remove('active'));
      el.classList.add('active');
    }

    /* Luxury Splash Screen Intro Controller */
    let gsapExperienceTriggered = false;

    function dismissSplashScreen() {
      const splash = document.getElementById('luxurySplashScreen');
      if (!splash || splash.classList.contains('splash-fading') || splash.classList.contains('splash-hidden')) return;
      splash.classList.add('splash-fading');
      setTimeout(() => {
        splash.classList.add('splash-hidden');
        if (!gsapExperienceTriggered) {
          gsapExperienceTriggered = true;
          initGSAPLuxuryExperience();
        }
      }, 400);
    }

    // Smooth reveal: auto-dismiss after intro golden logo animation
    window.addEventListener('load', () => {
      setTimeout(dismissSplashScreen, 2400);
      setTimeout(() => {
        if (!gsapExperienceTriggered) {
          gsapExperienceTriggered = true;
          initGSAPLuxuryExperience();
        }
      }, 3400);
    });

    // Fallback safety guarantee
    setTimeout(dismissSplashScreen, 3500);

    /* ==========================================================================
       GSAP 3 & SCROLLTRIGGER LUXURY ANIMATION ENGINE
       ========================================================================== */
    function initGSAPLuxuryExperience() {
      if (typeof gsap === 'undefined') return;
      if (typeof ScrollTrigger !== 'undefined') {
        gsap.registerPlugin(ScrollTrigger);
      }

      // 1. Hero Content Orchestrated Entrance Timeline
      const heroTimeline = gsap.timeline({
        delay: 0.1,
        defaults: { ease: 'power3.out' }
      });

      heroTimeline
        .from('.hero-main-headline', {
          y: 40,
          opacity: 0,
          duration: 1.15
        })
        .from('.hero-supporting-copy', {
          y: 25,
          opacity: 0,
          duration: 0.9
        }, '-=0.8')
        .from('.hero-cta-group a', {
          y: 20,
          opacity: 0,
          duration: 0.8,
          stagger: 0.12
        }, '-=0.65');

      /* Only animate cards entrance on desktop — on mobile the overlap technique
         conflicts with GSAP's translateY and causes a visible "blink + clip" */
      if (window.innerWidth > 768) {
        heroTimeline.from('.cat-square-card', {
          y: 55,
          opacity: 0,
          duration: 0.95,
          stagger: 0.1,
          ease: 'power2.out'
        }, '-=0.5');
      }

      if (typeof ScrollTrigger !== 'undefined') {
        // 1. Catalog Section: Editorial Narrative Reveal
        gsap.from('.middle-copy-col > *', {
          scrollTrigger: {
            trigger: '#catalogo',
            start: 'top 75%',
            toggleActions: 'play none none none'
          },
          y: 35,
          opacity: 0,
          duration: 0.9,
          stagger: 0.12,
          ease: 'power3.out'
        });

        // 2. Catalog Product Cards Stagger Reveal
        gsap.from('#catalogo .cutout-product-card', {
          scrollTrigger: {
            trigger: '#catalogo .middle-cards-grid',
            start: 'top 80%',
            toggleActions: 'play none none none'
          },
          y: 45,
          opacity: 0,
          duration: 0.85,
          stagger: 0.16,
          ease: 'power2.out'
        });

        // 3. Desktop Floating Header Elevation on Scroll
        ScrollTrigger.create({
          start: 'top -60',
          onUpdate: (self) => {
            const h = document.querySelector('.desktop-floating-header');
            if (h) {
              if (self.scroll() > 60) {
                h.style.background = 'rgba(255, 255, 255, 0.95)';
                h.style.boxShadow = '0 12px 30px rgba(8, 25, 91, 0.14)';
              } else {
                h.style.background = '';
                h.style.boxShadow = '';
              }
            }
          }
        });
      }

      // 8. Smooth GSAP Physics & Drag Inertia for Square Collection Slider
      const track = document.getElementById('catSliderTrack');
      const btnPrev = document.getElementById('catSliderPrev');
      const btnNext = document.getElementById('catSliderNext');

      if (track && btnNext && btnPrev) {
        function updateArrows() {
          const maxScroll = track.scrollWidth - track.clientWidth;
          if (track.scrollLeft <= 10) {
            btnPrev.classList.add('is-hidden');
          } else {
            btnPrev.classList.remove('is-hidden');
          }

          if (track.scrollLeft >= maxScroll - 10) {
            btnNext.classList.add('is-hidden');
          } else {
            btnNext.classList.remove('is-hidden');
          }
        }

        function gsapScrollStep(direction) {
          const firstCard = track.querySelector('.cat-square-card');
          const step = firstCard ? (firstCard.getBoundingClientRect().width + 20) : 320;
          const current = track.scrollLeft;
          const max = track.scrollWidth - track.clientWidth;
          const target = Math.max(0, Math.min(current + (direction * step), max));

          gsap.to(track, {
            scrollLeft: target,
            duration: 0.65,
            ease: 'power2.out',
            overwrite: 'auto',
            onUpdate: updateArrows
          });
        }

        btnNext.onclick = function(e) {
          e.preventDefault();
          gsapScrollStep(1);
        };

        btnPrev.onclick = function(e) {
          e.preventDefault();
          gsapScrollStep(-1);
        };

        // Desktop Mouse Drag to Scroll with Velocity
        let isDown = false;
        let startX = 0;
        let scrollLeftPos = 0;

        track.addEventListener('mousedown', (e) => {
          // ignore clicks on buttons or links directly to allow clicking
          isDown = true;
          track.style.cursor = 'grabbing';
          startX = e.pageX - track.offsetLeft;
          scrollLeftPos = track.scrollLeft;
        });

        window.addEventListener('mouseup', () => {
          if (isDown) {
            isDown = false;
            track.style.cursor = '';
          }
        });

        track.addEventListener('mousemove', (e) => {
          if (!isDown) return;
          e.preventDefault();
          const x = e.pageX - track.offsetLeft;
          const walk = (x - startX) * 1.3;
          track.scrollLeft = scrollLeftPos - walk;
          updateArrows();
        });

        track.addEventListener('scroll', updateArrows, { passive: true });
        window.addEventListener('resize', updateArrows);
        setTimeout(updateArrows, 150);
      }
    }
  </script>

  <!-- MOBILE LUXURY FLOATING BOTTOM DOCK (< 1024px) -->
