{{ 'editorial-luxury.css' | asset_url | stylesheet_tag }}

<section class="editorial-hero" id="Hero-{{ section.id }}">
  <div class="hero-layout">
    <div class="hero-copy">
      {%- if section.settings.kicker != blank -%}
        <span class="editorial-kicker">{{ section.settings.kicker }}</span>
      {%- endif -%}

      <h1 class="editorial-headline-large">
        {{ section.settings.headline }}
      </h1>

      {%- if section.settings.subtext != blank -%}
        <p class="editorial-lead" style="margin-top: 24px;">
          {{ section.settings.subtext }}
        </p>
      {%- endif -%}

      <div class="hero-actions">
        {%- if section.settings.btn_primary_label != blank -%}
          <a href="{{ section.settings.btn_primary_url | default: '/collections/all' }}" class="btn-editorial-primary">
            {{ section.settings.btn_primary_label }}
          </a>
        {%- endif -%}

        {%- if section.settings.btn_secondary_label != blank -%}
          <a href="{{ section.settings.btn_secondary_url | default: '/pages/about' }}" class="btn-editorial-secondary">
            {{ section.settings.btn_secondary_label }} →
          </a>
        {%- endif -%}
      </div>
    </div>

    <div class="hero-visual light-sweep-container">
      {%- if section.settings.video_url != blank -%}
        <video
          class="hero-video-element"
          autoplay
          loop
          muted
          playsinline
          poster="{{ section.settings.image | default: 'hero-macro-ring.jpg' | asset_url }}"
        >
          <source src="{{ section.settings.video_url }}" type="video/mp4">
        </video>
      {%- elsif section.settings.use_marble_sculpture_video -%}
        <video
          class="hero-video-element"
          autoplay
          loop
          muted
          playsinline
          poster="{{ 'luxury-hero-poster.jpg' | asset_url }}"
        >
          <source src="{{ 'Luxury_jewelry_video_loop_4K_20260915233606.mp4' | asset_url }}" type="video/mp4">
          <source src="{{ 'luxury-jewelry-hero-film.mp4' | asset_url }}" type="video/mp4">
        </video>
      {%- elsif section.settings.image != blank -%}
        <img
          src="{{ section.settings.image | image_url: width: 2000 }}"
          alt="{{ section.settings.headline | escape }}"
          loading="eager"
          width="2000"
          height="1400"
        >
      {%- else -%}
        <video
          class="hero-video-element"
          autoplay
          loop
          muted
          playsinline
          poster="{{ 'luxury-hero-poster.jpg' | asset_url }}"
        >
          <source src="{{ 'Luxury_jewelry_video_loop_4K_20260915233606.mp4' | asset_url }}" type="video/mp4">
          <source src="{{ 'luxury-jewelry-hero-film.mp4' | asset_url }}" type="video/mp4">
          <img
            src="{{ 'luxury-hero-poster.jpg' | asset_url }}"
            alt="Carrara marble sculpture wearing 14k gold luxury jewelry"
            loading="eager"
            width="2000"
            height="1400"
          >
        </video>
      {%- endif -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Editorial Hero",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "text",
      "id": "kicker",
      "label": "Small Label",
      "default": "ORO 100% AUTÉNTICO 10K & 14K • ENVÍOS A EE. UU. Y PUERTO RICO"
    },
    {
      "type": "textarea",
      "id": "headline",
      "label": "Headline",
      "default": "Brilla con Estilo,\nBrilla con Oro."
    },
    {
      "type": "textarea",
      "id": "subtext",
      "label": "Supporting text",
      "default": "Descubre joyas auténticas en oro de 10K y 14K con financiamiento y envío asegurado a todos los Estados Unidos y Puerto Rico."
    },
    {
      "type": "checkbox",
      "id": "use_marble_sculpture_video",
      "label": "Use Marble Sculpture Loop Video",
      "default": true
    },
    {
      "type": "text",
      "id": "video_url",
      "label": "Custom Video MP4 URL"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Marble Campaign Image / Poster"
    },
    {
      "type": "text",
      "id": "btn_primary_label",
      "label": "Primary CTA Label",
      "default": "Ver Colecciones"
    },
    {
      "type": "url",
      "id": "btn_primary_url",
      "label": "Primary CTA URL"
    },
    {
      "type": "text",
      "id": "btn_secondary_label",
      "label": "Secondary CTA Label",
      "default": "Financiamiento Affirm"
    },
    {
      "type": "url",
      "id": "btn_secondary_url",
      "label": "Secondary CTA URL"
    }
  ],
  "presets": [
    {
      "name": "Editorial Hero"
    }
  ]
}
{% endschema %}
