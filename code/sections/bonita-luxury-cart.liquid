{{ 'editorial-luxury.css' | asset_url | stylesheet_tag }}

<div class="bonita-luxury-cart-page" style="background: #FAF9F6; min-height: 100vh; padding: 24px 20px 80px; position: relative;">
  <div style="max-width: 1240px; margin: 0 auto;">

    <!-- Breadcrumb -->
    <nav class="product-luxury-breadcrumb" style="margin-bottom: 20px;" aria-label="Ruta de navegación">
      <a href="{{ routes.root_url }}">Inicio</a>
      <span class="breadcrumb-sep">/</span>
      <span class="breadcrumb-current">Bolsa de Compras</span>
    </nav>

    <!-- Cart Header -->
    <header style="text-align: center; margin-bottom: 32px;">
      <span style="font-family: 'Plus Jakarta Sans', sans-serif; font-size: 0.76rem; font-weight: 700; letter-spacing: 0.14em; color: #D1B054; text-transform: uppercase;">Alta Joyería en Oro 10K & 14K</span>
      <h1 style="font-family: 'Sentient', Georgia, serif; font-size: clamp(2.2rem, 4.5vw, 3.2rem); font-weight: 600; color: #08195B; margin: 6px 0 10px; line-height: 1.15;">
        Tu Bolsa de <span style="color: #D1B054; font-style: italic;">Compras</span>
      </h1>
      <p style="font-size: 0.88rem; color: #64748B; max-width: 600px; margin: 0 auto; line-height: 1.5;">
        Oro 100% auténtico con garantía certificada de por vida, peso garantizado y financiamiento flexible Affirm.
      </p>
    </header>

    {%- if cart == empty -%}
      <!-- EMPTY CART STATE -->
      <div style="background: #FFFFFF; border-radius: 24px; padding: 60px 24px; text-align: center; max-width: 640px; margin: 0 auto; box-shadow: 0 10px 30px rgba(8, 25, 91, 0.06); border: 1px solid rgba(209, 176, 84, 0.3);">
        <div style="width: 72px; height: 72px; margin: 0 auto 20px; background: rgba(209, 176, 84, 0.12); border-radius: 50%; display: flex; align-items: center; justify-content: center; color: #D1B054;">
          <svg width="36" height="36" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
            <path d="M6 2L3 6v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6l-3-4z"></path>
            <line x1="3" y1="6" x2="21" y2="6"></line>
            <path d="M16 10a4 4 0 0 1-8 0"></path>
          </svg>
        </div>
        <h2 style="font-family: 'Sentient', Georgia, serif; font-size: 1.8rem; color: #08195B; margin: 0 0 10px; font-weight: 600;">Tu bolsa de compras está vacía</h2>
        <p style="font-size: 0.9rem; color: #64748B; max-width: 420px; margin: 0 auto 28px; line-height: 1.5;">
          Descubre nuestras cadenas cubanas, anillos, aretes y pulseras en oro de 10K y 14K con envío asegurado.
        </p>
        <a href="/collections/all" style="display: inline-flex; align-items: center; justify-content: center; gap: 8px; background: #08195B; color: #FFFFFF; padding: 14px 32px; border-radius: 9999px; font-weight: 700; font-size: 0.88rem; text-decoration: none; box-shadow: 0 6px 20px rgba(8, 25, 91, 0.25); transition: all 0.25s ease;">
          <span>Explorar Catálogo Exclusivo</span>
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
        </a>
      </div>

    {%- else -%}
      <!-- FREE SHIPPING PROGRESS BAR -->
      {%- assign threshold_cents = 20000 -%}
      {%- assign current_total = cart.total_price -%}
      {%- assign progress_percent = current_total | times: 100 | divided_by: threshold_cents -%}
      {%- if progress_percent > 100 -%}{%- assign progress_percent = 100 -%}{%- endif -%}

      <div style="background: #FFFFFF; border-radius: 16px; padding: 16px 24px; margin-bottom: 28px; box-shadow: 0 4px 16px rgba(8, 25, 91, 0.05); border: 1px solid rgba(209, 176, 84, 0.25); text-align: center;">
        <div style="font-size: 0.85rem; font-weight: 700; color: #08195B; margin-bottom: 8px; display: flex; align-items: center; justify-content: center; gap: 6px;">
          {%- if current_total >= threshold_cents -%}
            <span style="color: #059669;">✦ ¡Felicidades! Tienes Envío Asegurado Totalmente GRATIS</span>
          {%- else -%}
            {%- assign diff_cents = threshold_cents | minus: current_total -%}
            <span>Agrega <strong>{{ diff_cents | money }}</strong> más para obtener <strong>Envío Gratis Asegurado</strong></span>
          {%- endif -%}
        </div>
        <div style="width: 100%; height: 6px; background: #ECEAE5; border-radius: 9999px; overflow: hidden;">
          <div style="width: {{ progress_percent }}%; height: 100%; background: linear-gradient(90deg, #D1B054, #F5D77F); border-radius: 9999px; transition: width 0.4s ease;"></div>
        </div>
      </div>

      <!-- CART MAIN GRID (2 COLUMNS: ITEMS + SUMMARY) -->
      <div style="display: grid; grid-template-columns: 1fr 380px; gap: 32px; align-items: start;" class="bonita-cart-grid">
        
        <!-- LEFT: CART ITEMS LIST -->
        <div class="bonita-cart-items-col">
          <div style="display: flex; flex-direction: column; gap: 16px;">
            {%- for item in cart.items -%}
              <div class="bonita-cart-item-card" data-key="{{ item.key }}" style="background: #FFFFFF; border-radius: 18px; padding: 18px; display: grid; grid-template-columns: 100px 1fr auto; gap: 18px; align-items: center; box-shadow: 0 4px 14px rgba(8, 25, 91, 0.05); border: 1px solid rgba(8, 25, 91, 0.08); transition: transform 0.25s ease, box-shadow 0.25s ease;">
                
                <!-- Product Thumbnail -->
                <a href="{{ item.url }}" style="display: block; width: 100px; height: 100px; aspect-ratio: 1/1; border-radius: 12px; overflow: hidden; background: #F8F7F3; flex-shrink: 0; border: 1px solid rgba(8, 25, 91, 0.06);">
                  {%- if item.image -%}
                    <img src="{{ item.image | image_url: width: 220 }}" alt="{{ item.title | escape }}" style="width: 100%; height: 100%; object-fit: cover; object-position: center; display: block;" loading="lazy">
                  {%- else -%}
                    {{ 'image' | placeholder_svg_tag: 'placeholder-svg' }}
                  {%- endif -%}
                </a>

                <!-- Product Info & Quantity -->
                <div style="display: flex; flex-direction: column; gap: 6px; min-width: 0;">
                  <a href="{{ item.url }}" style="font-family: 'Plus Jakarta Sans', sans-serif; font-size: 0.95rem; font-weight: 700; color: #08195B; text-decoration: none; line-height: 1.3; overflow: hidden; text-overflow: ellipsis; white-space: nowrap;">
                    {{ item.product.title }}
                  </a>
                  
                  {%- unless item.product.has_only_default_variant -%}
                    <span style="font-size: 0.74rem; color: #64748B; background: rgba(8, 25, 91, 0.05); padding: 2px 8px; border-radius: 6px; align-self: flex-start;">
                      {{ item.variant.title }}
                    </span>
                  {%- endunless -%}

                  <div style="display: flex; align-items: center; gap: 12px; margin-top: 4px; flex-wrap: wrap;">
                    <span style="font-size: 0.85rem; color: #08195B; font-weight: 700;">
                      {{ item.final_price | money }}
                    </span>
                    {%- if item.original_price > item.final_price -%}
                      <span style="font-size: 0.75rem; color: #94A3B8; text-decoration: line-through;">
                        {{ item.original_price | money }}
                      </span>
                    {%- endif -%}
                  </div>

                  <!-- Interactive Quantity Controls -->
                  <div style="display: flex; align-items: center; gap: 10px; margin-top: 6px;">
                    <div style="display: inline-flex; align-items: center; background: #F8F7F3; border: 1px solid rgba(8, 25, 91, 0.12); border-radius: 8px; overflow: hidden;">
                      <button type="button" onclick="changeCartQty('{{ item.key }}', {{ item.quantity | minus: 1 }})" style="width: 28px; height: 28px; border: none; background: transparent; color: #08195B; font-size: 1rem; font-weight: 700; cursor: pointer; display: flex; align-items: center; justify-content: center; transition: background 0.15s;" title="Disminuir">-</button>
                      <span style="width: 32px; text-align: center; font-size: 0.82rem; font-weight: 700; color: #08195B;">{{ item.quantity }}</span>
                      <button type="button" onclick="changeCartQty('{{ item.key }}', {{ item.quantity | plus: 1 }})" style="width: 28px; height: 28px; border: none; background: transparent; color: #08195B; font-size: 1rem; font-weight: 700; cursor: pointer; display: flex; align-items: center; justify-content: center; transition: background 0.15s;" title="Aumentar">+</button>
                    </div>

                    <button type="button" onclick="changeCartQty('{{ item.key }}', 0)" style="border: none; background: transparent; color: #94A3B8; font-size: 0.75rem; display: inline-flex; align-items: center; gap: 4px; cursor: pointer; padding: 4px 6px; border-radius: 6px; transition: color 0.2s;" onmouseover="this.style.color='#E11D48'" onmouseout="this.style.color='#94A3B8'">
                      <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M3 6h18M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2M10 11v6M14 11v6"/></svg>
                      <span>Eliminar</span>
                    </button>
                  </div>
                </div>

                <!-- Total Line Price -->
                <div style="text-align: right; font-family: 'Plus Jakarta Sans', sans-serif; font-size: 1.05rem; font-weight: 800; color: #08195B; white-space: nowrap;">
                  {{ item.final_line_price | money }}
                </div>

              </div>
            {%- endfor -%}
          </div>

          <!-- Bottom Actions / Notes -->
          <div style="display: flex; justify-content: space-between; align-items: center; margin-top: 24px; flex-wrap: wrap; gap: 16px;">
            <a href="/collections/all" style="display: inline-flex; align-items: center; gap: 6px; font-size: 0.82rem; font-weight: 700; color: #08195B; text-decoration: none; transition: color 0.2s;" onmouseover="this.style.color='#D1B054'" onmouseout="this.style.color='#08195B'">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2"><path d="M19 12H5M12 19l-7-7 7-7"/></svg>
              <span>Continuar Comprando Joyas</span>
            </a>
            
            <button type="button" onclick="clearFullCart()" style="border: none; background: transparent; color: #94A3B8; font-size: 0.78rem; font-weight: 600; cursor: pointer; transition: color 0.2s;" onmouseover="this.style.color='#E11D48'" onmouseout="this.style.color='#94A3B8'">
              Vaciar bolsa de compras
            </button>
          </div>
        </div>

        <!-- RIGHT: ORDER SUMMARY (STICKY LUXURY CARD) -->
        <div class="bonita-cart-summary-col" style="position: sticky; top: 110px;">
          <div style="background: #FFFFFF; border-radius: 20px; padding: 24px; box-shadow: 0 10px 30px rgba(8, 25, 91, 0.08); border: 1.5px solid rgba(209, 176, 84, 0.4);">
            
            <h3 style="font-family: 'Sentient', Georgia, serif; font-size: 1.5rem; font-weight: 700; color: #08195B; margin: 0 0 16px; border-bottom: 1px solid rgba(8, 25, 91, 0.08); padding-bottom: 12px;">
              Resumen del Pedido
            </h3>

            <!-- Summary Rows -->
            <div style="display: flex; flex-direction: column; gap: 12px; margin-bottom: 20px;">
              <div style="display: flex; justify-content: space-between; font-size: 0.88rem; color: #64748B;">
                <span>Subtotal ({{ cart.item_count }} artículos)</span>
                <span style="font-weight: 700; color: #08195B;">{{ cart.total_price | money }}</span>
              </div>
              
              <div style="display: flex; justify-content: space-between; font-size: 0.88rem; color: #64748B;">
                <span>Envío Asegurado FedEx</span>
                {%- if cart.total_price >= threshold_cents -%}
                  <span style="font-weight: 800; color: #059669;">GRATIS</span>
                {%- else -%}
                  <span style="font-size: 0.80rem; color: #64748B;">Calculado al pagar</span>
                {%- endif -%}
              </div>

              <div style="border-top: 1px dashed rgba(8, 25, 91, 0.12); margin-top: 6px; padding-top: 14px; display: flex; justify-content: space-between; align-items: baseline;">
                <span style="font-family: 'Plus Jakarta Sans', sans-serif; font-size: 1rem; font-weight: 800; color: #08195B;">Total Estimado</span>
                <span style="font-family: 'Plus Jakarta Sans', sans-serif; font-size: 1.4rem; font-weight: 800; color: #08195B;">
                  {{ cart.total_price | money_with_currency }}
                </span>
              </div>
            </div>

            <!-- Affirm Monthly Payment Promo -->
            {%- assign affirm_monthly = cart.total_price | divided_by: 12 -%}
            <div style="background: rgba(209, 176, 84, 0.10); border: 1px solid rgba(209, 176, 84, 0.35); border-radius: 10px; padding: 10px 12px; margin-bottom: 20px; font-size: 0.78rem; color: #08195B; display: flex; align-items: center; gap: 8px;">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#D1B054" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="flex-shrink:0;"><rect x="1" y="4" width="22" height="16" rx="2" ry="2"></rect><line x1="1" y1="10" x2="23" y2="10"></line></svg>
              <span>Paga desde <strong>{{ affirm_monthly | money }}/mes</strong> con <strong>Affirm</strong> sin cargos ocultos.</span>
            </div>

            <!-- Checkout Form & Primary Button -->
            <form action="{{ routes.cart_url }}" method="post" id="cart-checkout-form">
              <button type="submit" name="checkout" style="width: 100%; background: #08195B; color: #FFFFFF; border: none; padding: 16px 20px; border-radius: 12px; font-family: 'Plus Jakarta Sans', sans-serif; font-size: 0.95rem; font-weight: 800; letter-spacing: 0.04em; cursor: pointer; display: flex; align-items: center; justify-content: center; gap: 8px; box-shadow: 0 8px 24px rgba(8, 25, 91, 0.25); transition: all 0.25s ease;" onmouseover="this.style.background='#05103B'; this.style.transform='translateY(-2px)'" onmouseout="this.style.background='#08195B'; this.style.transform='translateY(0)'">
                <span>Proceder al Pago Seguro</span>
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>
              </button>

              {%- if content_for_additional_checkout_buttons -%}
                <div class="additional-checkout-buttons" style="margin-top: 12px;">
                  {{ content_for_additional_checkout_buttons }}
                </div>
              {%- endif -%}
            </form>

            <!-- Trust Badges List -->
            <div style="margin-top: 24px; border-top: 1px solid rgba(8, 25, 91, 0.08); padding-top: 16px; display: flex; flex-direction: column; gap: 10px;">
              <div style="display: flex; align-items: center; gap: 8px; font-size: 0.74rem; color: #475569;">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="#D1B054" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="flex-shrink:0;"><rect x="3" y="11" width="18" height="11" rx="2" ry="2"></rect><path d="M7 11V7a5 5 0 0 1 10 0v4"></path></svg>
                <span>Pago 100% Seguro con Encriptación SSL 256-bit</span>
              </div>
              <div style="display: flex; align-items: center; gap: 8px; font-size: 0.74rem; color: #475569;">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="#D1B054" style="flex-shrink:0;"><path d="M5 16L3 5l5.5 5L12 4l3.5 6L21 5l-2 11H5m14 3c0 .6-.4 1-1 1H6c-.6 0-1-.4-1-1v-1h14v1z"/></svg>
                <span>Oro 100% Auténtico 10K & 14K con Garantía de Peso</span>
              </div>
              <div style="display: flex; align-items: center; gap: 8px; font-size: 0.74rem; color: #475569;">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="#D1B054" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="flex-shrink:0;"><path d="M21 16V8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16z"></path><polyline points="3.27 6.96 12 12.01 20.73 6.96"></polyline><line x1="12" y1="22.08" x2="12" y2="12"></line></svg>
                <span>Envío Asegurado con Rastreo FedEx a todo EE.UU.</span>
              </div>
            </div>

          </div>
        </div>

      </div>
    {%- endif -%}

  </div>
</div>

<script>
  function changeCartQty(lineKey, newQty) {
    if (newQty < 0) return;
    
    // Show smooth loading state
    var card = document.querySelector('[data-key="' + lineKey + '"]');
    if (card) {
      card.style.opacity = '0.5';
      card.style.pointerEvents = 'none';
    }

    fetch('{{ routes.cart_change_url }}', {
      method: 'POST',
      headers: {
        'Content-Type': 'application/json',
        'Accept': 'application/json'
      },
      body: JSON.stringify({
        id: lineKey,
        quantity: newQty
      })
    })
    .then(function(res) { return res.json(); })
    .then(function(cartData) {
      // Reload page to reflect exact updated totals & discounts cleanly
      window.location.reload();
    })
    .catch(function(err) {
      console.error('Error updating cart:', err);
      window.location.reload();
    });
  }

  function clearFullCart() {
    if (!confirm('¿Estás seguro de que deseas vaciar tu bolsa de compras?')) return;
    
    fetch('{{ routes.cart_clear_url }}', {
      method: 'POST',
      headers: { 'Accept': 'application/json' }
    })
    .then(function() {
      window.location.reload();
    });
  }
</script>

<style>
  @media (max-width: 900px) {
    .bonita-cart-grid {
      grid-template-columns: 1fr !important;
      gap: 24px !important;
    }
    .bonita-cart-summary-col {
      position: static !important;
    }
    .bonita-cart-item-card {
      grid-template-columns: 80px 1fr !important;
      gap: 12px !important;
      padding: 14px !important;
    }
    .bonita-cart-item-card > a {
      width: 80px !important;
      height: 80px !important;
    }
    .bonita-cart-item-card > div:last-child {
      grid-column: span 2;
      text-align: left !important;
      display: flex;
      justify-content: space-between;
      border-top: 1px solid rgba(8, 25, 91, 0.06);
      padding-top: 10px;
      margin-top: 4px;
    }
  }
</style>

{% schema %}
{
  "name": "Bolsa de Compras Luxe",
  "settings": []
}
{% endschema %}
