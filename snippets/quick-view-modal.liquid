      </div>

      <div class="modal-trust-row">
        <span class="modal-trust-item">
          <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>
          <span>Oro 100% Genuino</span>
        </span>
        <span class="modal-trust-item">
          <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2"><rect x="1" y="3" width="15" height="13"></rect><polygon points="16 8 20 8 23 11 23 16 16 16 16 8"></polygon><circle cx="5.5" cy="18.5" r="2.5"></circle><circle cx="18.5" cy="18.5" r="2.5"></circle></svg>
          <span>Envío Asegurado Gratis</span>
        </span>
        <span class="modal-trust-item">
          <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="11" width="18" height="11" rx="2" ry="2"></rect><path d="M7 11V7a5 5 0 0 1 10 0v4"></path></svg>
          <span>Pago Seguro Cifrado</span>
        </span>
      </div>
    </div>
  </div>
</div>

<script>
  /* Intelligent Jewelry Characteristics Parser */
  function parseJewelrySpecs(title, productType) {
    title = title || '';
    var lowerTitle = title.toLowerCase();
    var lowerType = (productType || '').toLowerCase();

    var isRing = lowerTitle.indexOf('anillo') !== -1 || lowerType.indexOf('anillo') !== -1;
    var isWatch = !isRing && (lowerTitle.indexOf('reloj') !== -1 || lowerType.indexOf('reloj') !== -1 || lowerTitle.indexOf('invicta') !== -1 || lowerTitle.indexOf('seiko') !== -1);
    var isChain = lowerTitle.indexOf('cadena') !== -1 || lowerTitle.indexOf('collar') !== -1 || lowerTitle.indexOf('cuban') !== -1;
    var isBracelet = lowerTitle.indexOf('pulsera') !== -1 || lowerTitle.indexOf('esclava') !== -1 || lowerTitle.indexOf('brazalete') !== -1 || lowerTitle.indexOf('manilla') !== -1 || lowerTitle.indexOf('tobillera') !== -1;
    var isEarring = lowerTitle.indexOf('arete') !== -1 || lowerTitle.indexOf('arracada') !== -1 || lowerTitle.indexOf('topo') !== -1 || lowerTitle.indexOf('argolla') !== -1 || lowerTitle.indexOf('dormilon') !== -1;
    var isPendant = lowerTitle.indexOf('dije') !== -1 || lowerTitle.indexOf('medalla') !== -1 || lowerTitle.indexOf('cruz') !== -1;

    if (isWatch) {
      return { karat: null, size: 'Caja Estándar · Brazalete Ajustable', weight: null };
    }

    // Karat detection from title
    var karat = null;
    if (/\b10k\b/i.test(title)) karat = '10k';
    else if (/\b14k\b/i.test(title)) karat = '14k';

    // Strip karat out before extracting numbers
    var clean = title.replace(/\b10k\b|\b14k\b/gi, ' ');
    var numMatches = clean.match(/\b\d+(?:\.\d+)?(?:g|gr|gramos)?\b/gi) || [];

    var weight = null;
    var size = null;

    for (var i = 0; i < numMatches.length; i++) {
      if (/g|gr|gramos/i.test(numMatches[i])) {
        weight = parseFloat(numMatches[i]);
      }
    }

    var remaining = [];
    for (var j = 0; j < numMatches.length; j++) {
      var n = parseFloat(numMatches[j]);
      if (!isNaN(n) && n !== weight) {
        remaining.push(n);
      }
    }

    if (isRing) {
      if (remaining.length >= 2) {
        if (remaining[0] >= 3.5 && remaining[0] <= 14) {
          size = 'Talla ' + remaining[0];
          weight = weight || remaining[1];
        } else {
          weight = weight || remaining[0];
          size = 'Talla ' + remaining[1];
        }
      } else if (remaining.length === 1) {
        if (remaining[0] >= 4 && remaining[0] <= 14 && !weight) {
          size = 'Talla ' + remaining[0];
        } else if (remaining[0] >= 4 && remaining[0] <= 14) {
          size = 'Talla ' + remaining[0];
        } else {
          weight = weight || remaining[0];
        }
      }
    } else if (isChain) {
      if (remaining.length >= 2) {
        var len = null;
        for (var k = 0; k < remaining.length; k++) {
          var r = Math.round(remaining[k]);
          if ([16, 18, 20, 22, 24, 26, 28, 30].indexOf(r) !== -1) {
            len = remaining[k];
            break;
          }
        }
        if (len) {
          size = len + '" (' + Math.round(len * 2.54) + ' cm)';
          for (var l = 0; l < remaining.length; l++) {
            if (remaining[l] !== len) {
              weight = weight || remaining[l];
            }
          }
        } else {
          size = remaining[0] + '"';
          weight = weight || remaining[1];
        }
      } else if (remaining.length === 1) {
        var r1 = Math.round(remaining[0]);
        if ([16, 18, 20, 22, 24, 26, 28, 30].indexOf(r1) !== -1) {
          size = remaining[0] + '" (' + Math.round(remaining[0] * 2.54) + ' cm)';
        } else {
          weight = weight || remaining[0];
        }
      }
    } else if (isBracelet) {
      if (remaining.length >= 2) {
        size = remaining[0] + '"';
        weight = weight || remaining[1];
      } else if (remaining.length === 1) {
        if (remaining[0] >= 6 && remaining[0] <= 10) {
          size = remaining[0] + '"';
        } else {
          weight = weight || remaining[0];
        }
      }
    } else {
      if (remaining.length >= 2) {
        size = remaining[0] + ' mm';
        weight = weight || remaining[1];
      } else if (remaining.length === 1 && !weight) {
        weight = weight || remaining[0];
      }
    }

    return { karat: karat, size: size, weight: weight };
  }

  var currentModalProduct = null;

  function openProductModalFromCard(card) {
    if (!card) return;
    var titleEl = card.querySelector('.cutout-product-title');
    var imgEl = card.querySelector('.cutout-card-img') || card.querySelector('img');
    var badgeEl = card.querySelector('.cutout-card-pin span');
    var priceEl = card.querySelector('.price-now');

    var title = titleEl ? titleEl.textContent.trim() : 'Joya de Oro La Bonita';
    var category = (card.getAttribute('data-category') || 'joyas').toLowerCase();

    // Parse real characteristics from the product title
    var parsed = parseJewelrySpecs(title, category);

    var karat = card.getAttribute('data-karat') || '';
    if (parsed.karat) {
      karat = parsed.karat;
    } else if (!karat || karat === 'all') {
      karat = '14k';
    }
    karat = karat.toLowerCase();

    var price = parseFloat(card.getAttribute('data-price')) || (priceEl ? parseFloat(priceEl.textContent.replace(/[^0-9.]/g, '')) : 500);
    var priceWasEl = card.querySelector('.price-was');
    var comparePrice = priceWasEl ? parseFloat(priceWasEl.textContent.replace(/[^0-9.]/g, '')) : null;

    // Prefer exact gram weight parsed from title (e.g. "1.56g") over Shopify's converted variant weight
    var rawWeightAttr = card.getAttribute('data-weight');
    var weight = null;
    if (parsed.weight && parsed.weight > 0) {
      weight = parsed.weight;
    } else if (rawWeightAttr && rawWeightAttr !== '15.0' && parseFloat(rawWeightAttr) > 0) {
      weight = parseFloat(rawWeightAttr);
    }

    // Dynamic size from inventory or title (never hardcode 24 for rings)
    var rawSizeAttr = card.getAttribute('data-size');
    var size = null;
    if (rawSizeAttr && rawSizeAttr !== '24' && rawSizeAttr.trim() !== '') {
      size = rawSizeAttr.trim();
    } else if (parsed.size) {
      size = parsed.size;
    } else {
      size = 'Estándar';
    }

    var variantId = card.getAttribute('data-variant-id') || null;
    var linkEl = card.querySelector('a[href*="/products/"]');
    var productUrl = card.getAttribute('data-url') || (linkEl ? linkEl.getAttribute('href') : '') || '';
    var imgSrc = imgEl ? imgEl.getAttribute('src') : null;
    if (imgSrc) {
      imgSrc = imgSrc.replace(/width=\d+/, 'width=1200');
    }

    var rawImagesAttr = card.getAttribute('data-images') || '';
    var imagesList = rawImagesAttr
      ? rawImagesAttr.split('|').map(function(u) { return u.trim(); }).filter(Boolean)
      : (imgSrc ? [imgSrc] : []);
    if (imagesList.length === 0 && imgSrc) {
      imagesList = [imgSrc];
    }

    var initialIdx = parseInt(card.getAttribute('data-active-img-idx')) || 0;
    if (initialIdx < 0 || initialIdx >= imagesList.length) initialIdx = 0;

    var badge = 'Oro ' + karat.toUpperCase() + ' Sólido';

    currentModalProduct = {
      title: title,
      category: category,
      baseKarat: karat,
      selectedKarat: karat,
      basePrice: price,
      comparePrice: comparePrice,
      baseWeight: weight,
      baseSize: size,
      selectedSize: size,
      qty: 1,
      imgSrc: imagesList[initialIdx] || imagesList[0] || imgSrc,
      images: imagesList,
      activeImageIdx: initialIdx,
      badge: badge,
      variantId: variantId,
      url: productUrl,
      hasMultipleKaratVariants: false
    };

    populateProductModalUI();

    var modal = document.getElementById('productModal');
    if (modal) {
      modal.classList.add('open');
      document.body.style.overflow = 'hidden';
    }
  }

  function selectModalImage(idx) {
    if (!currentModalProduct || !currentModalProduct.images || !currentModalProduct.images.length) return;
    var total = currentModalProduct.images.length;
    var safeIdx = ((idx % total) + total) % total;
    currentModalProduct.activeImageIdx = safeIdx;
    currentModalProduct.imgSrc = currentModalProduct.images[safeIdx];
    var imgEl = document.getElementById('modalMainImg');
    if (imgEl) {
      imgEl.src = currentModalProduct.imgSrc;
    }
    var thumbsRow = document.getElementById('modalThumbsRow');
    if (thumbsRow) {
      var btns = thumbsRow.querySelectorAll('.modal-thumb-btn');
      btns.forEach(function(b, i) {
        if (i === safeIdx) b.classList.add('active');
        else b.classList.remove('active');
      });
    }
  }

  function stepModalImage(delta) {
    if (!currentModalProduct || !currentModalProduct.images) return;
    selectModalImage((currentModalProduct.activeImageIdx || 0) + delta);
  }

  function closeProductModal() {
    var modal = document.getElementById('productModal');
    if (modal) {
      modal.classList.remove('open');
      document.body.style.overflow = '';
    }
  }

  function handleModalBackdropClick(e) {
    if (e.target.id === 'productModal') {
      closeProductModal();
    }
  }

  function populateProductModalUI() {
    if (!currentModalProduct) return;
    var p = currentModalProduct;

    // Image & Gallery Controls
    var imgEl = document.getElementById('modalMainImg');
    var placeholderEl = document.getElementById('modalMockPlaceholder');
    var badgeEl = document.getElementById('modalBadge');
    var prevBtn = document.getElementById('modalPrevImgBtn');
    var nextBtn = document.getElementById('modalNextImgBtn');
    var thumbsRow = document.getElementById('modalThumbsRow');

    if (p.imgSrc && !p.imgSrc.includes('mock')) {
      if (imgEl) {
        imgEl.src = p.imgSrc;
        imgEl.alt = p.title;
        imgEl.style.display = 'block';
        imgEl.style.position = 'absolute';
        imgEl.style.inset = '0';
        imgEl.style.width = '100%';
        imgEl.style.height = '100%';
        imgEl.style.objectFit = 'cover';
        imgEl.style.objectPosition = 'center center';
        imgEl.style.padding = '0';
      }
      if (placeholderEl) placeholderEl.style.display = 'none';
    } else {
      if (imgEl) imgEl.style.display = 'none';
      if (placeholderEl) placeholderEl.style.display = 'flex';
    }

    if (p.images && p.images.length > 1) {
      var activeIdx = p.activeImageIdx || 0;
      if (prevBtn) prevBtn.style.display = 'inline-flex';
      if (nextBtn) nextBtn.style.display = 'inline-flex';
      if (thumbsRow) {
        thumbsRow.innerHTML = '';
        p.images.forEach(function(url, idx) {
          var btn = document.createElement('button');
          btn.type = 'button';
          btn.className = 'modal-thumb-btn' + (idx === activeIdx ? ' active' : '');
          btn.setAttribute('aria-label', 'Vista ' + (idx + 1));
          btn.onclick = function(ev) {
            ev.stopPropagation();
            selectModalImage(idx);
          };
          var tImg = document.createElement('img');
          tImg.src = url.replace(/width=\d+/, 'width=200');
          tImg.alt = 'Vista ' + (idx + 1);
          btn.appendChild(tImg);
          thumbsRow.appendChild(btn);
        });
        thumbsRow.style.display = 'inline-flex';
      }
    } else {
      if (prevBtn) prevBtn.style.display = 'none';
      if (nextBtn) nextBtn.style.display = 'none';
      if (thumbsRow) {
        thumbsRow.innerHTML = '';
        thumbsRow.style.display = 'none';
      }
    }

    var isWatchModal = (p.category && p.category.indexOf('reloj') !== -1) || /reloj|invicta|seiko/i.test(p.title || '');

    if (badgeEl) {
      badgeEl.textContent = isWatchModal ? 'Relojería Automática' : ('Oro ' + p.selectedKarat.toUpperCase() + ' Sólido');
    }

    // Title & Meta
    var catTag = document.getElementById('modalCategoryTag');
    if (catTag) catTag.textContent = 'COLECCIÓN ' + p.category.toUpperCase() + ' · LA BONITA';

    var titleEl = document.getElementById('modalProductTitle');
    if (titleEl) titleEl.textContent = p.title;

    // Pricing
    var priceCurrentEl = document.getElementById('modalPriceCurrent');
    if (priceCurrentEl) {
      priceCurrentEl.textContent = '$' + p.basePrice.toLocaleString('en-US', { minimumFractionDigits: 2, maximumFractionDigits: 2 }) + ' USD';
    }

    var priceOldEl = document.getElementById('modalPriceOld');
    if (priceOldEl) {
      if (p.comparePrice && p.comparePrice > p.basePrice) {
        var pct = Math.round(((p.comparePrice - p.basePrice) / p.comparePrice) * 100);
        priceOldEl.innerHTML = '<span style="text-decoration:line-through;color:#94A3B8;font-size:0.95rem;">$' + p.comparePrice.toLocaleString('en-US', { minimumFractionDigits: 2, maximumFractionDigits: 2 }) + '</span> <span style="display:inline-block;background:linear-gradient(135deg,#DC2626,#991B1B);color:#FFFFFF;font-size:0.7rem;font-weight:800;padding:2px 8px;border-radius:999px;margin-left:6px;text-decoration:none;">-' + pct + '% OFF</span>';
        priceOldEl.style.display = 'inline-flex';
        priceOldEl.style.alignItems = 'center';
        priceOldEl.style.textDecoration = 'none';
      } else {
        priceOldEl.innerHTML = '';
        priceOldEl.style.display = 'none';
      }
    }

    var gramRateEl = document.getElementById('modalGramRate');
    if (gramRateEl) {
      gramRateEl.textContent = isWatchModal ? 'Acero Inoxidable' : ('Oro ' + p.selectedKarat.toUpperCase() + ' Macizo');
    }

    var affirmMoEl = document.getElementById('modalAffirmMo');
    if (affirmMoEl) {
      var mo = Math.max(35, Math.round(p.basePrice / 12));
      affirmMoEl.textContent = '$' + mo + '/mes';
    }

    // Karat Selector (Shows only the real registered karat, or Stainless Steel for watches)
    var karatGroupLabel = document.querySelector('#modalKaratGroup .pdp-option-label span:first-child');
    if (karatGroupLabel) {
      karatGroupLabel.textContent = isWatchModal ? 'Material de Caja y Pulso' : 'Pureza del Oro';
    }
    var karatPillsContainer = document.getElementById('modalKaratPills');
    var karatText = document.getElementById('modalSelectedKaratText');
    if (karatPillsContainer) {
      karatPillsContainer.innerHTML = '';
      if (isWatchModal) {
        var watchPill = document.createElement('span');
        watchPill.className = 'pdp-variant-pill active';
        watchPill.style.cursor = 'default';
        watchPill.style.pointerEvents = 'none';
        watchPill.textContent = 'Acero Inoxidable · Tono Dorado';
        karatPillsContainer.appendChild(watchPill);
      } else if (p.hasMultipleKaratVariants) {
        var btn10 = document.createElement('button');
        btn10.type = 'button';
        btn10.className = 'pdp-variant-pill' + (p.selectedKarat === '10k' ? ' active' : '');
        btn10.textContent = 'Oro 10K';
        btn10.onclick = function() { selectModalKarat('10k'); };
        karatPillsContainer.appendChild(btn10);

        var btn14 = document.createElement('button');
        btn14.type = 'button';
        btn14.className = 'pdp-variant-pill' + (p.selectedKarat === '14k' ? ' active' : '');
        btn14.textContent = 'Oro 14K';
        btn14.onclick = function() { selectModalKarat('14k'); };
        karatPillsContainer.appendChild(btn14);
      } else {
        var singlePill = document.createElement('span');
        singlePill.className = 'pdp-variant-pill active';
        singlePill.style.cursor = 'default';
        singlePill.style.pointerEvents = 'none';
        singlePill.textContent = 'Oro ' + p.selectedKarat.toUpperCase() + ' Auténtico';
        karatPillsContainer.appendChild(singlePill);
      }
    }
    if (karatText) {
      karatText.textContent = isWatchModal ? 'Acabado Dorado de Alta Resistencia' : ('Oro ' + p.selectedKarat.toUpperCase() + ' Sólido Garantizado');
    }

    // Size Selector
    var sizePillsContainer = document.getElementById('modalSizePills');
    var sizeText = document.getElementById('modalSelectedSizeText');
    var sizeLabel = document.getElementById('modalSizeLabel');
    if (sizeText) {
      sizeText.textContent = p.selectedSize || 'Estándar';
    }
    if (sizeLabel) {
      if (isWatchModal) sizeLabel.textContent = 'Caja y Brazalete';
      else if (p.category === 'anillos') sizeLabel.textContent = 'Talla de Anillo';
      else if (p.category === 'cadenas') sizeLabel.textContent = 'Largo de Cadena';
      else if (p.category === 'pulseras') sizeLabel.textContent = 'Largo de Pulsera';
      else sizeLabel.textContent = 'Medida / Dimensión';
    }
    if (sizePillsContainer) {
      sizePillsContainer.innerHTML = '';
      if (p.selectedSize && p.selectedSize !== 'Estándar') {
        var sizePill = document.createElement('span');
        sizePill.className = 'pdp-variant-pill active';
        sizePill.style.cursor = 'default';
        sizePill.style.pointerEvents = 'none';
        sizePill.textContent = p.selectedSize;
        sizePillsContainer.appendChild(sizePill);
      } else {
        var defPill = document.createElement('span');
        defPill.className = 'pdp-variant-pill active';
        defPill.style.cursor = 'default';
        defPill.style.pointerEvents = 'none';
        defPill.textContent = 'Medida Estándar / Ajustable';
        sizePillsContainer.appendChild(defPill);
      }
    }

    // Specs Table
    var specKarat = document.getElementById('modalSpecKarat');
    if (specKarat) {
      specKarat.textContent = isWatchModal ? 'Acero Inoxidable (No es Oro)' : ('Oro ' + p.selectedKarat.toUpperCase() + ' Sólido Garantizado');
    }

    var specWeight = document.getElementById('modalSpecWeight');
    if (specWeight) {
      if (isWatchModal) {
        specWeight.textContent = 'Movimiento Automático de Precisión';
      } else if (p.baseWeight && p.baseWeight > 0) {
        specWeight.textContent = p.baseWeight + ' g';
      } else {
        specWeight.textContent = 'Oro Genuino Certificado';
      }
    }

    var specSize = document.getElementById('modalSpecSize');
    if (specSize) {
      specSize.textContent = p.selectedSize || 'Estándar / Ajustable';
    }

    // Reset Qty
    var qtyInput = document.getElementById('modalQtyInput');
    if (qtyInput) qtyInput.value = '1';

    // Reset Share Btn
    var shareBtn = document.getElementById('modalShareBtn');
    if (shareBtn) {
      shareBtn.classList.remove('copied');
      var shareSpan = shareBtn.querySelector('span');
      if (shareSpan) shareSpan.textContent = 'Compartir';
    }
  }

  function selectModalKarat(k) {
    if (!currentModalProduct) return;
    currentModalProduct.selectedKarat = k;
    populateProductModalUI();
  }

  function changeModalQty(delta) {
    var input = document.getElementById('modalQtyInput');
    if (!input) return;
    var val = parseInt(input.value) || 1;
    var next = Math.max(1, Math.min(10, val + delta));
    input.value = next;
    if (currentModalProduct) currentModalProduct.qty = next;
  }

  function addModalProductToCart() {
    if (!currentModalProduct) return;
    var p = currentModalProduct;
    var btn = document.getElementById('modalAddToCartBtn');
    var qtyInput = document.getElementById('modalQtyInput');
    var qty = parseInt(qtyInput ? qtyInput.value : 1) || 1;
    var variantId = p.variantId;

    if (!variantId) {
      window.location.href = '/collections/all';
      return;
    }

    if (btn) {
      btn.disabled = true;
      btn.innerHTML = '<span>Agregando...</span>';
    }

    var cartAddJsUrl = '{{ routes.cart_add_url | default: "/cart/add" }}.js';
    var cartAddPostUrl = '{{ routes.cart_add_url | default: "/cart/add" }}';
    var cartPageUrl = '{{ routes.cart_url | default: "/cart" }}';

    fetch(cartAddJsUrl, {
      method: 'POST',
      credentials: 'same-origin',
      headers: {
        'Content-Type': 'application/json',
        'Accept': 'application/json',
        'X-Requested-With': 'XMLHttpRequest'
      },
      body: JSON.stringify({ id: Number(variantId), quantity: qty })
    })
    .then(function(res) {
      if (!res.ok) throw new Error('Add to cart failed: ' + res.status);
      return res.json();
    })
    .then(function(item) {
      if (btn) {
        btn.innerHTML = '<span>✓ ¡Agregado con Éxito!</span>';
        btn.style.background = '#059669';
      }
      setTimeout(function() {
        closeProductModal();
        if (typeof window.openCartDrawer === 'function') {
          window.openCartDrawer();
        } else {
          window.location.href = cartPageUrl;
        }
      }, 600);
    })
    .catch(function(err) {
      console.warn('Direct POST add to cart fallback:', err);
      try {
        var f = document.createElement('form');
        f.method = 'POST';
        f.action = cartAddPostUrl;
        f.style.display = 'none';
        var iId = document.createElement('input');
        iId.type = 'hidden';
        iId.name = 'id';
        iId.value = String(variantId);
        var iQty = document.createElement('input');
        iQty.type = 'hidden';
        iQty.name = 'quantity';
        iQty.value = String(qty);
        f.appendChild(iId);
        f.appendChild(iQty);
        document.body.appendChild(f);
        f.submit();
      } catch (e2) {
        window.location.href = cartPageUrl;
      }
    });
  }

  /* Product Link Share & Copy System */
  function showBonitaShareToast(msg) {
    var existingToast = document.getElementById('toastPill');
    var existingMsg = document.getElementById('toastMsg');
    if (existingToast && existingMsg) {
      existingMsg.textContent = msg;
      existingToast.classList.add('show');
      clearTimeout(window._bonitaToastTimer);
      window._bonitaToastTimer = setTimeout(function() {
        existingToast.classList.remove('show');
      }, 2800);
      return;
    }
    var toast = document.getElementById('bonitaShareToast');
    if (!toast) {
      toast = document.createElement('div');
      toast.id = 'bonitaShareToast';
      toast.className = 'bonita-share-toast';
      document.body.appendChild(toast);
    }
    toast.textContent = msg;
    toast.classList.add('show');
    clearTimeout(window._bonitaToastTimer);
    window._bonitaToastTimer = setTimeout(function() {
      toast.classList.remove('show');
    }, 2800);
  }

  function copyTextToClipboardFallback(text) {
    try {
      var ta = document.createElement('textarea');
      ta.value = text;
      ta.setAttribute('readonly', '');
      ta.style.position = 'fixed';
      ta.style.opacity = '0';
      document.body.appendChild(ta);
      ta.select();
      document.execCommand('copy');
      document.body.removeChild(ta);
    } catch (e) {}
  }

  function copyAndShareProductUrl(rawUrl, title, btnEl, ev) {
    if (ev) {
      ev.preventDefault();
      ev.stopPropagation();
    }
    var fullUrl = rawUrl || window.location.href;
    if (fullUrl.indexOf('http') !== 0) {
      fullUrl = window.location.origin + (fullUrl.charAt(0) === '/' ? '' : '/') + fullUrl;
    }
    var shareTitle = title || 'La Bonita Joyería';

    // Always copy link to clipboard first so user immediately has it
    if (navigator.clipboard && navigator.clipboard.writeText) {
      navigator.clipboard.writeText(fullUrl).catch(function() {
        copyTextToClipboardFallback(fullUrl);
      });
    } else {
      copyTextToClipboardFallback(fullUrl);
    }

    // Visual button feedback
    if (btnEl) {
      var origHtml = btnEl._origShareHtml || btnEl.innerHTML;
      btnEl._origShareHtml = origHtml;
      btnEl.classList.add('copied');
      if (btnEl.classList.contains('btn-share-product-pill')) {
        btnEl.innerHTML = '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"></polyline></svg>';
      } else {
        btnEl.innerHTML = '<svg viewBox="0 0 24 24" width="17" height="17" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"></polyline></svg><span>¡Copiado!</span>';
      }
      clearTimeout(btnEl._shareResetTimer);
      btnEl._shareResetTimer = setTimeout(function() {
        btnEl.classList.remove('copied');
        btnEl.innerHTML = origHtml;
      }, 2200);
    }

    showBonitaShareToast('✓ Enlace copiado para compartir');

    // On mobile/touch devices, also open native share sheet (WhatsApp, iMessage, etc.)
    if (navigator.share && window.matchMedia && window.matchMedia('(pointer: coarse)').matches) {
      navigator.share({
        title: shareTitle,
        text: shareTitle + ' — La Bonita Joyería',
        url: fullUrl
      }).catch(function() {});
    }
  }

  function shareCardProduct(btnEl, ev) {
    if (ev) {
      ev.preventDefault();
      ev.stopPropagation();
    }
    var card = btnEl ? btnEl.closest('.product-shop-card') : null;
    if (!card) return;
    var titleEl = card.querySelector('.cutout-product-title');
    var title = titleEl ? titleEl.textContent.trim() : 'Joya de Oro La Bonita';
    var linkEl = card.querySelector('a[href*="/products/"]');
    var rawUrl = card.getAttribute('data-url') || (linkEl ? linkEl.getAttribute('href') : '') || window.location.pathname;
    copyAndShareProductUrl(rawUrl, title, btnEl, ev);
  }

  function shareModalProduct(btnEl, ev) {
    if (ev) {
      ev.preventDefault();
      ev.stopPropagation();
    }
    var rawUrl = (currentModalProduct && currentModalProduct.url) ? currentModalProduct.url : window.location.href;
    var title = (currentModalProduct && currentModalProduct.title) ? currentModalProduct.title : 'Joya de Oro La Bonita';
    copyAndShareProductUrl(rawUrl, title, btnEl, ev);
  }

  window.copyAndShareProductUrl = copyAndShareProductUrl;
  window.shareCardProduct = shareCardProduct;
  window.shareModalProduct = shareModalProduct;

  /* Interactive Card-Level Image Switcher on Product Cards */
  function setCardImageIdx(card, idx) {
    if (!card) return;
    var raw = card.getAttribute('data-images') || '';
    var list = raw.split('|').map(function(u) { return u.trim(); }).filter(Boolean);
    if (list.length <= 1) return;
    var total = list.length;
    var safeIdx = ((idx % total) + total) % total;
    card.setAttribute('data-active-img-idx', String(safeIdx));
    var imgEl = card.querySelector('.cutout-card-img') || card.querySelector('img');
    if (imgEl) {
      imgEl.src = list[safeIdx].replace(/width=\d+/, 'width=600');
    }
    var dots = card.querySelectorAll('.card-inline-dot');
    dots.forEach(function(d, i) {
      if (i === safeIdx) d.classList.add('active');
      else d.classList.remove('active');
    });
  }

  function initCardInlineGalleries() {
    // Ensure all product cards (including static fallbacks) have a share button
    var allCards = document.querySelectorAll('.cutout-product-card');
    allCards.forEach(function(card) {
      if (!card.querySelector('.btn-share-product-pill')) {
        var addBtn = card.querySelector('.btn-add-cart-pill');
        if (addBtn && addBtn.parentNode) {
          var group = document.createElement('div');
          group.className = 'card-action-pills-group';
          var shareB = document.createElement('button');
          shareB.type = 'button';
          shareB.className = 'btn-share-product-pill';
          shareB.title = 'Compartir enlace';
          shareB.setAttribute('aria-label', 'Compartir enlace');
          shareB.innerHTML = '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="18" cy="5" r="3"></circle><circle cx="6" cy="12" r="3"></circle><circle cx="18" cy="19" r="3"></circle><line x1="8.59" y1="13.51" x2="15.42" y2="17.49"></line><line x1="15.41" y1="6.51" x2="8.59" y2="10.49"></line></svg>';
          shareB.onclick = function(ev) { shareCardProduct(shareB, ev); };
          addBtn.parentNode.insertBefore(group, addBtn);
          group.appendChild(shareB);
          group.appendChild(addBtn);
        }
      }
    });

    var cards = document.querySelectorAll('.cutout-product-card[data-images]');
    cards.forEach(function(card) {
      if (card._hasInlineGallery) return;
      var raw = card.getAttribute('data-images') || '';
      var list = raw.split('|').map(function(u) { return u.trim(); }).filter(Boolean);
      if (list.length <= 1) return;
      var media = card.querySelector('.cutout-card-media');
      if (!media) return;
      card._hasInlineGallery = true;

      // Prev/Next arrows on card media
      var navWrap = document.createElement('div');
      navWrap.className = 'card-inline-gallery-nav';

      var prevB = document.createElement('button');
      prevB.type = 'button';
      prevB.className = 'card-inline-arrow prev';
      prevB.setAttribute('aria-label', 'Foto anterior');
      prevB.innerHTML = '<svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round"><polyline points="15 18 9 12 15 6"></polyline></svg>';
      prevB.onclick = function(ev) {
        ev.preventDefault();
        ev.stopPropagation();
        var cur = parseInt(card.getAttribute('data-active-img-idx')) || 0;
        setCardImageIdx(card, cur - 1);
      };

      var nextB = document.createElement('button');
      nextB.type = 'button';
      nextB.className = 'card-inline-arrow next';
      nextB.setAttribute('aria-label', 'Siguiente foto');
      nextB.innerHTML = '<svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round"><polyline points="9 18 15 12 9 6"></polyline></svg>';
      nextB.onclick = function(ev) {
        ev.preventDefault();
        ev.stopPropagation();
        var cur = parseInt(card.getAttribute('data-active-img-idx')) || 0;
        setCardImageIdx(card, cur + 1);
      };

      navWrap.appendChild(prevB);
      navWrap.appendChild(nextB);
      media.appendChild(navWrap);

      // Clean floating dots on card media (no container pill)
      var dotsWrap = document.createElement('div');
      dotsWrap.className = 'card-inline-dots';
      dotsWrap.onclick = function(ev) {
        ev.preventDefault();
        ev.stopPropagation();
      };
      list.forEach(function(_, idx) {
        var dot = document.createElement('button');
        dot.type = 'button';
        dot.className = 'card-inline-dot' + (idx === 0 ? ' active' : '');
        dot.setAttribute('aria-label', 'Vista ' + (idx + 1));
        dot.onclick = function(ev) {
          ev.preventDefault();
          ev.stopPropagation();
          setCardImageIdx(card, idx);
        };
        dotsWrap.appendChild(dot);
      });
      media.appendChild(dotsWrap);
    });
  }

  document.addEventListener('DOMContentLoaded', initCardInlineGalleries);
  window.addEventListener('load', initCardInlineGalleries);
