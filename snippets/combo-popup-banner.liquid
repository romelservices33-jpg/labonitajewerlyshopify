            {%- assign slide_idx = slide_idx | plus: 1 -%}
          {%- endif -%}
        </div>
      </div>

      <div class="lb-carousel-footer">
        {%- if active_promos_count > 1 -%}
          {%- assign thumb_idx = 0 -%}
          <div class="lb-carousel-thumbs" style="grid-template-columns: repeat(auto-fit, minmax(110px, 1fr));">
            {%- if combo_liso_in_stock -%}
              <button type="button" class="lb-carousel-thumb {% if thumb_idx == 0 %}is-active{% endif %}" data-goto-slide="{{ thumb_idx }}">
                <img src="{{ combo_liso_img }}" alt="Combo Set Liso 10K">
                <span class="lb-carousel-thumb-meta">
                  <span class="lb-carousel-thumb-title">{{ thumb_idx | plus: 1 }}. Set Liso 10K</span>
                  <span class="lb-carousel-thumb-price">$999 (-$406)</span>
                </span>
              </button>
              {%- assign thumb_idx = thumb_idx | plus: 1 -%}
            {%- endif -%}

            {%- if combo_pave_in_stock -%}
              <button type="button" class="lb-carousel-thumb {% if thumb_idx == 0 %}is-active{% endif %}" data-goto-slide="{{ thumb_idx }}">
                <img src="{{ combo_pave_img }}" alt="Combo Set Pavé 10K">
                <span class="lb-carousel-thumb-meta">
                  <span class="lb-carousel-thumb-title">{{ thumb_idx | plus: 1 }}. Set Pavé 10K</span>
                  <span class="lb-carousel-thumb-price">$999 (-$446)</span>
                </span>
              </button>
              {%- assign thumb_idx = thumb_idx | plus: 1 -%}
            {%- endif -%}

            {%- if combo3_in_stock -%}
              <button type="button" class="lb-carousel-thumb {% if thumb_idx == 0 %}is-active{% endif %}" data-goto-slide="{{ thumb_idx }}">
                <img src="{{ combo3_img }}" alt="Combo Capilla 10K + Reloj">
                <span class="lb-carousel-thumb-meta">
                  <span class="lb-carousel-thumb-title">{{ thumb_idx | plus: 1 }}. Capilla 10K + Reloj</span>
                  <span class="lb-carousel-thumb-price">$1,699 (-$1,090)</span>
                </span>
              </button>
              {%- assign thumb_idx = thumb_idx | plus: 1 -%}
            {%- endif -%}

            {%- if combo2_in_stock -%}
              <button type="button" class="lb-carousel-thumb {% if thumb_idx == 0 %}is-active{% endif %}" data-goto-slide="{{ thumb_idx }}">
                <img src="{{ combo2_img }}" alt="Combo Iniciales 10K">
                <span class="lb-carousel-thumb-meta">
                  <span class="lb-carousel-thumb-title">{{ thumb_idx | plus: 1 }}. Inicial + Argollas</span>
                  <span class="lb-carousel-thumb-price">$599.00 (-$211)</span>
                </span>
              </button>
              {%- assign thumb_idx = thumb_idx | plus: 1 -%}
            {%- endif -%}

            {%- if combo1_in_stock -%}
              <button type="button" class="lb-carousel-thumb {% if thumb_idx == 0 %}is-active{% endif %}" data-goto-slide="{{ thumb_idx }}">
                <img src="{{ combo1_img }}" alt="Combo Seiko + 3 Argollas">
                <span class="lb-carousel-thumb-meta">
                  <span class="lb-carousel-thumb-title">{{ thumb_idx | plus: 1 }}. Seiko + 3 Argollas</span>
                  <span class="lb-carousel-thumb-price">$749.00 (-$300)</span>
                </span>
              </button>
              {%- assign thumb_idx = thumb_idx | plus: 1 -%}
            {%- endif -%}
          </div>

          <div class="lb-carousel-dots-row">
            {%- assign dot_max = active_promos_count | minus: 1 -%}
            {%- for i in (0..dot_max) -%}
              <button type="button" class="lb-carousel-dot {% if i == 0 %}is-active{% endif %}" data-goto-slide="{{ i }}" aria-label="Ir a promoción {{ i | plus: 1 }}"></button>
            {%- endfor -%}
            <span class="lb-carousel-swipe-hint">‹ Desliza para ver las {{ active_promos_count }} promociones ›</span>
          </div>
        {%- endif -%}

        <button type="button" class="lb-combo-popup-dismiss" id="lbComboPopupDismiss">
          Continuar viendo la tienda
        </button>
      </div>
    </div>
  </div>

  <script>
    (function () {
      var STORAGE_KEY = 'lb_carousel_combos_popup_seen_v6';
      var popup = document.getElementById('lbComboPopup');
      var card = document.getElementById('lbComboPopupCard');
      var closeBtn = document.getElementById('lbComboPopupClose');
      var dismissBtn = document.getElementById('lbComboPopupDismiss');
      var viewport = document.getElementById('lbCarouselViewport');
      var track = document.getElementById('lbCarouselTrack');
      var prevBtn = document.getElementById('lbCarouselPrev');
      var nextBtn = document.getElementById('lbCarouselNext');
      var counterEl = document.getElementById('lbCarouselCounter');
      var progressBar = document.getElementById('lbCarouselProgressBar');
      if (!popup || !track) return;

      var slides = Array.prototype.slice.call(track.querySelectorAll('.lb-carousel-slide'));
      var dots = Array.prototype.slice.call(popup.querySelectorAll('.lb-carousel-dot'));
      var thumbs = Array.prototype.slice.call(popup.querySelectorAll('.lb-carousel-thumb'));
      var totalSlides = slides.length;
      var currentIndex = 0;

      var AUTOPLAY_MS = 5500;
      var elapsedMs = 0;
      var tickInterval = null;
      var isPaused = false;

      function updateTrackPosition() {
        if (totalSlides <= 1) {
          if (counterEl) counterEl.textContent = 'Oferta Especial';
          return;
        }
        var viewportWidth = viewport ? viewport.clientWidth : 440;
        var slideEl = slides[0];
        var slideWidth = slideEl ? slideEl.offsetWidth : viewportWidth * 0.84;
        var gap = 12;
        if (window.innerWidth <= 480) gap = 10;

        // Center the active slide while leaving the adjacent slide visibly peeking
        var centerOffset = (viewportWidth - slideWidth) / 2;
        var translateX = centerOffset - currentIndex * (slideWidth + gap);
        track.style.transform = 'translate3d(' + translateX + 'px, 0, 0)';

        slides.forEach(function (s, idx) {
          s.classList.toggle('is-active', idx === currentIndex);
        });
        dots.forEach(function (d, idx) {
          d.classList.toggle('is-active', idx === currentIndex);
        });
        thumbs.forEach(function (t, idx) {
          t.classList.toggle('is-active', idx === currentIndex);
        });
        if (counterEl) {
          counterEl.textContent = 'Promoción ' + (currentIndex + 1) + ' de ' + totalSlides;
        }
      }

      function goToSlide(idx, resetTimer) {
        if (totalSlides <= 1) return;
        currentIndex = (idx + totalSlides) % totalSlides;
        updateTrackPosition();
        if (resetTimer) {
          elapsedMs = 0;
          if (progressBar) progressBar.style.width = '0%';
        }
      }

      function startAutoplay() {
        if (totalSlides <= 1) return;
        stopAutoplay();
        tickInterval = setInterval(function () {
          if (isPaused || !popup.classList.contains('is-open')) return;
          elapsedMs += 100;
          if (progressBar) {
            var pct = Math.min(100, (elapsedMs / AUTOPLAY_MS) * 100);
            progressBar.style.width = pct + '%';
          }
          if (elapsedMs >= AUTOPLAY_MS) {
            elapsedMs = 0;
            goToSlide(currentIndex + 1, false);
          }
        }, 100);
      }

      function stopAutoplay() {
        if (tickInterval) {
          clearInterval(tickInterval);
          tickInterval = null;
        }
      }

      if (prevBtn) {
        prevBtn.addEventListener('click', function (e) {
          e.stopPropagation();
          goToSlide(currentIndex - 1, true);
        });
      }
      if (nextBtn) {
        nextBtn.addEventListener('click', function (e) {
          e.stopPropagation();
          goToSlide(currentIndex + 1, true);
        });
      }

      dots.forEach(function (dot) {
        dot.addEventListener('click', function () {
          goToSlide(parseInt(dot.getAttribute('data-goto-slide'), 10) || 0, true);
        });
      });

      thumbs.forEach(function (thumb) {
        thumb.addEventListener('click', function () {
          goToSlide(parseInt(thumb.getAttribute('data-goto-slide'), 10) || 0, true);
        });
      });

      slides.forEach(function (slide, idx) {
        slide.addEventListener('click', function (e) {
          if (idx !== currentIndex) {
            e.preventDefault();
            e.stopPropagation();
            goToSlide(idx, true);
          }
        });
      });

      var touchStartX = 0;
      var touchDeltaX = 0;
      if (viewport && totalSlides > 1) {
        viewport.addEventListener('touchstart', function (e) {
          if (!e.touches || !e.touches.length) return;
          touchStartX = e.touches[0].clientX;
          touchDeltaX = 0;
          isPaused = true;
        }, { passive: true });

        viewport.addEventListener('touchmove', function (e) {
          if (!e.touches || !e.touches.length) return;
          touchDeltaX = e.touches[0].clientX - touchStartX;
        }, { passive: true });

        viewport.addEventListener('touchend', function () {
          isPaused = false;
          if (Math.abs(touchDeltaX) > 42) {
            if (touchDeltaX < 0) {
              goToSlide(currentIndex + 1, true);
            } else {
              goToSlide(currentIndex - 1, true);
            }
          }
        });
      }

      if (card) {
        card.addEventListener('mouseenter', function () { isPaused = true; });
        card.addEventListener('mouseleave', function () { isPaused = false; });
      }
      window.addEventListener('resize', updateTrackPosition);

      var path = window.location.pathname || '';
      var isOnComboLisoPage = path.indexOf('combo-set-collar-pulsera-aretes-ovalado-liso-oro-10k') !== -1;
      var isOnComboPavePage = path.indexOf('combo-set-collar-pulsera-aretes-ovalado-pave-oro-10k') !== -1;
      var isOnCombo1Page = path.indexOf('combo-reloj-seiko-5-3-argollas-oro-10k') !== -1;
      var isOnCombo2Page =
        path.indexOf('combo-argollas-oro-10k-cadena-fina-dije-inicial-corona') !== -1 ||
        path.indexOf('combo-argollas-oro-10k-cadena-cubana-dije-inicial-corona') !== -1;
      var isOnCombo3Page = path.indexOf('combo-cadena-cubana-capilla-oro-10k-reloj-hombre-1435') !== -1;
      var isOnAnyComboPage =
        isOnComboLisoPage ||
        isOnComboPavePage ||
        isOnCombo1Page ||
        isOnCombo2Page ||
        isOnCombo3Page ||
        path.indexOf('/products/combo-') !== -1;
      var isCartOrCheckoutPage = path.indexOf('/cart') !== -1 || path.indexOf('/checkouts') !== -1;

      function markPopupSeen() {
        try {
          sessionStorage.setItem(STORAGE_KEY, '1');
        } catch (e) {}
        try {
          localStorage.setItem(STORAGE_KEY, '1');
        } catch (e) {}
      }

      function hasSeenPopup() {
        try {
          if (sessionStorage.getItem(STORAGE_KEY) === '1') return true;
        } catch (e) {}
        try {
          if (localStorage.getItem(STORAGE_KEY) === '1') return true;
        } catch (e) {}
        return false;
      }

      function openPopup() {
        markPopupSeen();
        popup.classList.add('is-open');
        setTimeout(updateTrackPosition, 30);
        startAutoplay();
      }

      function closePopup() {
        markPopupSeen();
        popup.classList.remove('is-open');
        stopAutoplay();
      }

      var promoLinks = Array.prototype.slice.call(
        popup.querySelectorAll('.lb-combo-popup-image-link, .lb-combo-popup-cta')
      );
      promoLinks.forEach(function (link) {
        link.addEventListener('click', function () {
          markPopupSeen();
        });
      });

      if (closeBtn) closeBtn.addEventListener('click', closePopup);
      if (dismissBtn) dismissBtn.addEventListener('click', closePopup);
      popup.addEventListener('click', function (e) {
        if (e.target === popup) closePopup();
      });
      document.addEventListener('keydown', function (e) {
        if (!popup.classList.contains('is-open')) return;
        if (e.key === 'Escape') closePopup();
        if (e.key === 'ArrowRight') goToSlide(currentIndex + 1, true);
        if (e.key === 'ArrowLeft') goToSlide(currentIndex - 1, true);
      });

      if (!isOnAnyComboPage && !isCartOrCheckoutPage) {
        if (!hasSeenPopup()) {
          setTimeout(openPopup, 1500);
        }
      } else if (isOnAnyComboPage) {
        markPopupSeen();
        var priceEl = document.querySelector('.price__container, .product__price, [id^="price-"], .pdp-pricing-row-single');
        if (priceEl && !document.getElementById('lbComboSaveBadge')) {
          var badge = document.createElement('div');
          badge.id = 'lbComboSaveBadge';
          badge.style.cssText = 'display:inline-flex;align-items:center;gap:8px;margin-top:8px;padding:6px 14px;border-radius:999px;background:linear-gradient(135deg,#d4af37 0%,#f3d77d 50%,#b88917 100%);color:#120f0a;font-weight:800;font-size:13px;letter-spacing:0.05em;text-transform:uppercase;box-shadow:0 4px 14px rgba(212,175,55,0.3);';
          badge.innerHTML = isOnComboLisoPage
            ? '<span>★ OFERTA SET 3 PIEZAS LISO 10K &middot; AHORRA $406</span>'
            : (isOnComboPavePage
              ? '<span>★ OFERTA SET 3 PIEZAS PAVÉ 10K &middot; AHORRA $446</span>'
              : (isOnCombo3Page
                ? '<span>★ OFERTA COMBO CAPILLA 10K + RELOJ &middot; AHORRA +$1,090</span>'
                : (isOnCombo2Page
                  ? '<span>★ OFERTA COMBO 3 PRENDAS &middot; AHORRA +$225</span>'
                  : '<span>★ OFERTA COMBO 4 PRENDAS &middot; AHORRA +$300</span>')));
          priceEl.appendChild(badge);
        }
      }
    })();
  </script>
{%- endif -%}
