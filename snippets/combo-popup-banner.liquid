{%- comment -%}
  Push-Up / Pop-Up Promotional Banner Carousel 1:1 — Multi-Promo Peek Carousel
  1) Combo Exclusivo 3 Prendas ($564.99): Argollas Torcidas Talla 1 (3480) + Cadena Fina 20" (4270) + Dije Inicial con Corona 10K
  2) Combo Exclusivo 4 Prendas ($749.00): Reloj Seiko 5 Automático Dorado (2209) + 3 Pares de Argollas Torcidas Nevadas Oro 10K (3667, 3668, 3669)
  Sincronizado en tiempo real con el inventario de las prendas individuales.
{%- endcomment -%}

{%- assign combo1_product = all_products['combo-reloj-seiko-5-3-argollas-oro-10k'] -%}
{%- assign comp_watch = all_products['reloj-seiko-automatico-no-metal'] -%}
{%- assign comp_hoop1 = all_products['aretes-hollow-10k-1x4mm-1-46'] -%}
{%- assign comp_hoop2 = all_products['aretes-hollow-10k-2x4mm-1-76'] -%}
{%- assign comp_hoop3 = all_products['aretes-hollow-10k-3x4mm-2-13'] -%}

{%- assign combo1_in_stock = false -%}
{%- if combo1_product != blank and combo1_product.available and comp_watch.available and comp_hoop1.available and comp_hoop2.available and comp_hoop3.available -%}
  {%- assign combo1_in_stock = true -%}
{%- endif -%}

{%- assign combo2_product = all_products['combo-argollas-oro-10k-cadena-fina-dije-inicial-corona'] -%}
{%- if combo2_product == blank -%}
  {%- assign combo2_product = all_products['combo-argollas-oro-10k-cadena-cubana-dije-inicial-corona'] -%}
{%- endif -%}

{%- assign combo2_in_stock = false -%}
{%- if combo2_product != blank and combo2_product.available -%}
  {%- assign combo2_in_stock = true -%}
{%- endif -%}

{%- assign combo1_url = combo1_product.url | default: '/products/combo-reloj-seiko-5-3-argollas-oro-10k' -%}
{%- assign combo1_img = 'https://cdn.shopify.com/s/files/1/0621/5450/6336/files/combo-seiko-argollas-banner.jpg?v=1792854606' -%}

{%- assign combo2_url = combo2_product.url | default: '/products/combo-argollas-oro-10k-cadena-fina-dije-inicial-corona' -%}
{%- assign combo2_img = 'https://cdn.shopify.com/s/files/1/0621/5450/6336/files/combo_iniciales_banner_fino_1792861697249.jpg?v=1792862545' -%}

{%- if combo1_in_stock or combo2_in_stock -%}
  <style>
    .lb-combo-popup-backdrop {
      position: fixed;
      inset: 0;
      z-index: 99999;
      background: rgba(6, 5, 4, 0.82);
      backdrop-filter: blur(9px);
      -webkit-backdrop-filter: blur(9px);
      display: flex;
      align-items: center;
      justify-content: center;
      padding: 14px;
      opacity: 0;
      visibility: hidden;
      pointer-events: none;
      transition: opacity 0.38s cubic-bezier(0.22, 1, 0.36, 1), visibility 0.38s ease;
    }
    .lb-combo-popup-backdrop.is-open {
      opacity: 1;
      visibility: visible;
      pointer-events: auto;
    }
    .lb-combo-popup-card {
      position: relative;
      width: 100%;
      max-width: 480px;
      background: #100e0b;
      border: 1.5px solid rgba(212, 175, 55, 0.65);
      border-radius: 20px;
      overflow: hidden;
      box-shadow: 0 28px 70px rgba(0, 0, 0, 0.85), 0 0 0 1px rgba(255, 255, 255, 0.06) inset;
      transform: translateY(28px) scale(0.96);
      transition: transform 0.42s cubic-bezier(0.22, 1, 0.36, 1);
    }
    .lb-combo-popup-backdrop.is-open .lb-combo-popup-card {
      transform: translateY(0) scale(1);
    }

    /* Header Bar with Promo Counter */
    .lb-carousel-header {
      display: flex;
      align-items: center;
      justify-content: space-between;
      padding: 10px 14px;
      background: linear-gradient(90deg, #17130d 0%, #211b11 50%, #17130d 100%);
      border-bottom: 1px solid rgba(212, 175, 55, 0.28);
    }
    .lb-carousel-header-left {
      display: flex;
      align-items: center;
      gap: 8px;
    }
    .lb-carousel-badge {
      display: inline-flex;
      align-items: center;
      gap: 5px;
      padding: 4px 10px;
      border-radius: 999px;
      background: rgba(212, 175, 55, 0.16);
      border: 1px solid rgba(212, 175, 55, 0.55);
      color: #f5df98;
      font-size: 11px;
      font-weight: 800;
      letter-spacing: 0.06em;
      text-transform: uppercase;
    }
    .lb-carousel-counter {
      color: rgba(248, 241, 223, 0.85);
      font-size: 11.5px;
      font-weight: 700;
      letter-spacing: 0.04em;
    }
    .lb-combo-popup-close {
      width: 32px;
      height: 32px;
      border-radius: 50%;
      border: 1px solid rgba(212, 175, 55, 0.55);
      background: rgba(15, 13, 10, 0.9);
      color: #f8f1df;
      display: flex;
      align-items: center;
      justify-content: center;
      cursor: pointer;
      padding: 0;
      font-size: 19px;
      line-height: 1;
      transition: background 0.2s ease, transform 0.2s ease;
    }
    .lb-combo-popup-close:hover {
      background: rgba(212, 175, 55, 0.95);
      color: #110f0c;
      transform: scale(1.06);
    }

    /* Animated Autoplay Progress Bar */
    .lb-carousel-progress-wrap {
      width: 100%;
      height: 3px;
      background: rgba(255, 255, 255, 0.08);
      overflow: hidden;
    }
    .lb-carousel-progress-bar {
      height: 100%;
      width: 0%;
      background: linear-gradient(90deg, #d4af37, #fff1b8, #d4af37);
      transition: width 0.1s linear;
    }

    /* Horizontal Peek Carousel Viewport */
    .lb-carousel-viewport {
      position: relative;
      width: 100%;
      overflow: hidden;
      padding: 12px 0 6px;
      background: radial-gradient(circle at center, #1f1911 0%, #0f0d0a 100%);
      touch-action: pan-y;
      user-select: none;
    }
    .lb-carousel-track {
      display: flex;
      align-items: stretch;
      transition: transform 0.52s cubic-bezier(0.22, 1, 0.36, 1);
      will-change: transform;
    }
    /* When multiple slides exist, each slide takes 84% width so the next promo visibly peeks in on the side */
    .lb-carousel-viewport.is-multi .lb-carousel-slide {
      flex: 0 0 84%;
      width: 84%;
      margin-right: 12px;
      border-radius: 14px;
      overflow: hidden;
      border: 1.5px solid rgba(212, 175, 55, 0.35);
      background: #14110d;
      transform: scale(0.94);
      opacity: 0.58;
      transition: transform 0.48s cubic-bezier(0.22, 1, 0.36, 1), opacity 0.48s ease, border-color 0.48s ease, box-shadow 0.48s ease;
      cursor: pointer;
    }
    .lb-carousel-viewport.is-multi .lb-carousel-slide.is-active {
      transform: scale(1);
      opacity: 1;
      border-color: #f3d77d;
      box-shadow: 0 12px 32px rgba(0, 0, 0, 0.65), 0 0 18px rgba(212, 175, 55, 0.22);
      cursor: default;
    }
    .lb-carousel-viewport.is-single .lb-carousel-slide {
      flex: 0 0 92%;
      width: 92%;
      margin: 0 auto;
      border-radius: 14px;
      overflow: hidden;
      border: 1.5px solid #f3d77d;
      background: #14110d;
    }

    .lb-combo-popup-image-link {
      display: block;
      width: 100%;
      aspect-ratio: 1 / 1;
      background: #1a1612;
      position: relative;
      overflow: hidden;
      text-decoration: none;
    }
    .lb-combo-popup-image-link img {
      width: 100%;
      height: 100%;
      object-fit: cover;
      display: block;
      pointer-events: none;
    }
    .lb-slide-corner-pill {
      position: absolute;
      top: 10px;
      left: 10px;
      z-index: 2;
      background: rgba(12, 10, 8, 0.84);
      border: 1px solid rgba(212, 175, 55, 0.75);
      color: #f7e39c;
      font-size: 10.5px;
      font-weight: 800;
      padding: 4px 9px;
      border-radius: 999px;
      letter-spacing: 0.05em;
      text-transform: uppercase;
      backdrop-filter: blur(4px);
    }

    .lb-slide-body {
      padding: 11px 12px 12px;
      background: linear-gradient(180deg, #17130e 0%, #0e0c09 100%);
      text-align: center;
      border-top: 1px solid rgba(212, 175, 55, 0.25);
    }
    .lb-combo-popup-cta {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      width: 100%;
      padding: 12px 14px;
      border-radius: 10px;
      background: linear-gradient(135deg, #d4af37 0%, #f3d77d 50%, #b88917 100%);
      color: #120f0a !important;
      font-weight: 800;
      font-size: 13.5px;
      letter-spacing: 0.04em;
      text-transform: uppercase;
      text-decoration: none;
      box-shadow: 0 6px 18px rgba(212, 175, 55, 0.35);
      transition: transform 0.2s ease, box-shadow 0.2s ease;
    }
    .lb-combo-popup-cta:hover {
      transform: translateY(-1px);
      box-shadow: 0 10px 24px rgba(212, 175, 55, 0.5);
    }

    /* Prominent Floating Left/Right Carousel Arrows */
    .lb-carousel-arrow {
      position: absolute;
      top: 44%;
      transform: translateY(-50%);
      z-index: 6;
      width: 40px;
      height: 40px;
      border-radius: 50%;
      border: 1.5px solid #f3d77d;
      background: rgba(14, 12, 9, 0.9);
      color: #f7e39c;
      display: flex;
      align-items: center;
      justify-content: center;
      cursor: pointer;
      box-shadow: 0 6px 18px rgba(0, 0, 0, 0.75), 0 0 12px rgba(212, 175, 55, 0.35);
      transition: all 0.2s ease;
      padding: 0;
    }
    .lb-carousel-arrow:hover {
      background: linear-gradient(135deg, #d4af37 0%, #f3d77d 100%);
      color: #120f0a;
      transform: translateY(-50%) scale(1.08);
    }
    .lb-carousel-arrow--prev {
      left: 8px;
    }
    .lb-carousel-arrow--next {
      right: 8px;
      animation: lbArrowNudge 1.8s infinite ease-in-out;
    }
    @keyframes lbArrowNudge {
      0%, 100% { transform: translateY(-50%) translateX(0); }
      50% { transform: translateY(-50%) translateX(3px); }
    }
    .lb-carousel-arrow svg {
      width: 20px;
      height: 20px;
      stroke: currentColor;
      stroke-width: 2.5;
      fill: none;
    }

    /* Bottom Carousel Controls: Mini-Thumbnails + Dots + Dismiss */
    .lb-carousel-footer {
      padding: 10px 14px 13px;
      background: #0d0b08;
      border-top: 1px solid rgba(212, 175, 55, 0.22);
      text-align: center;
    }
    .lb-carousel-thumbs {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 8px;
      margin-bottom: 8px;
    }
    .lb-carousel-thumb {
      display: flex;
      align-items: center;
      gap: 8px;
      padding: 5px 8px;
      border-radius: 10px;
      border: 1px solid rgba(212, 175, 55, 0.28);
      background: rgba(255, 255, 255, 0.03);
      color: rgba(248, 241, 223, 0.75);
      cursor: pointer;
      text-align: left;
      transition: all 0.2s ease;
    }
    .lb-carousel-thumb.is-active {
      border-color: #f3d77d;
      background: rgba(212, 175, 55, 0.16);
      color: #fff6dc;
      box-shadow: 0 0 0 1px rgba(243, 215, 125, 0.35);
    }
    .lb-carousel-thumb img {
      width: 34px;
      height: 34px;
      border-radius: 6px;
      object-fit: cover;
      flex-shrink: 0;
      border: 1px solid rgba(212, 175, 55, 0.4);
    }
    .lb-carousel-thumb-meta {
      min-width: 0;
      flex: 1;
      line-height: 1.2;
    }
    .lb-carousel-thumb-title {
      display: block;
      font-size: 10.5px;
      font-weight: 700;
      white-space: nowrap;
      overflow: hidden;
      text-overflow: ellipsis;
    }
    .lb-carousel-thumb-price {
      display: block;
      font-size: 11px;
      font-weight: 800;
      color: #f3d77d;
    }

    .lb-carousel-dots-row {
      display: flex;
      align-items: center;
      justify-content: center;
      gap: 8px;
      margin-bottom: 4px;
    }
    .lb-carousel-dot {
      width: 8px;
      height: 8px;
      border-radius: 999px;
      background: rgba(212, 175, 55, 0.32);
      border: none;
      padding: 0;
      cursor: pointer;
      transition: all 0.28s ease;
    }
    .lb-carousel-dot.is-active {
      width: 24px;
      background: linear-gradient(90deg, #d4af37, #f3d77d);
    }
    .lb-carousel-swipe-hint {
      font-size: 11px;
      color: rgba(243, 215, 125, 0.78);
      font-weight: 600;
      letter-spacing: 0.02em;
    }

    .lb-combo-popup-dismiss {
      display: inline-block;
      margin-top: 5px;
      background: none;
      border: none;
      color: rgba(245, 238, 220, 0.62);
      font-size: 11.5px;
      cursor: pointer;
      text-decoration: underline;
      padding: 2px 6px;
    }
    .lb-combo-popup-dismiss:hover {
      color: #f5eedc;
    }

    /* Floating Pill Re-opener */
    .lb-combo-floating-pill {
      position: fixed;
      bottom: 20px;
      left: 18px;
      z-index: 9998;
      display: none;
      align-items: center;
      gap: 8px;
      padding: 9px 14px;
      border-radius: 999px;
      background: rgba(17, 15, 12, 0.94);
      border: 1px solid rgba(212, 175, 55, 0.65);
      color: #f5e6c4;
      font-size: 12.5px;
      font-weight: 700;
      letter-spacing: 0.03em;
      cursor: pointer;
      box-shadow: 0 10px 26px rgba(0, 0, 0, 0.55);
      transition: transform 0.2s ease, border-color 0.2s ease;
    }
    .lb-combo-floating-pill.is-visible {
      display: inline-flex;
    }
    .lb-combo-floating-pill:hover {
      transform: translateY(-2px);
      border-color: #f3d77d;
    }
    .lb-combo-floating-dot {
      width: 8px;
      height: 8px;
      border-radius: 50%;
      background: #d4af37;
      box-shadow: 0 0 8px #d4af37;
    }

    @media (max-width: 480px) {
      .lb-combo-popup-card {
        max-width: 95vw;
        border-radius: 16px;
      }
      .lb-carousel-viewport.is-multi .lb-carousel-slide {
        flex: 0 0 83%;
        width: 83%;
        margin-right: 10px;
      }
      .lb-carousel-arrow {
        width: 36px;
        height: 36px;
      }
      .lb-combo-popup-cta {
        font-size: 12.5px;
        padding: 11px 10px;
      }
      .lb-combo-floating-pill {
        bottom: 14px;
        left: 12px;
        font-size: 11.5px;
        padding: 8px 12px;
      }
    }
  </style>

  <div id="lbComboPopup" class="lb-combo-popup-backdrop" role="dialog" aria-modal="true" aria-label="Carrusel de Combos Exclusivos en Oro 10K">
    <div class="lb-combo-popup-card" id="lbComboPopupCard">
      <div class="lb-carousel-header">
        <div class="lb-carousel-header-left">
          <span class="lb-carousel-badge">★ Combos Exclusivos</span>
          <span class="lb-carousel-counter" id="lbCarouselCounter">Promoción 1 de 2</span>
        </div>
        <button type="button" class="lb-combo-popup-close" id="lbComboPopupClose" aria-label="Cerrar ofertas">&times;</button>
      </div>

      {%- if combo1_in_stock and combo2_in_stock -%}
        <div class="lb-carousel-progress-wrap">
          <div class="lb-carousel-progress-bar" id="lbCarouselProgressBar"></div>
        </div>
      {%- endif -%}

      <div class="lb-carousel-viewport {% if combo1_in_stock and combo2_in_stock %}is-multi{% else %}is-single{% endif %}" id="lbCarouselViewport">
        {%- if combo1_in_stock and combo2_in_stock -%}
          <button type="button" class="lb-carousel-arrow lb-carousel-arrow--prev" id="lbCarouselPrev" aria-label="Promoción anterior">
            <svg viewBox="0 0 24 24"><polyline points="15 18 9 12 15 6"></polyline></svg>
          </button>
          <button type="button" class="lb-carousel-arrow lb-carousel-arrow--next" id="lbCarouselNext" aria-label="Siguiente promoción">
            <svg viewBox="0 0 24 24"><polyline points="9 18 15 12 9 6"></polyline></svg>
          </button>
        {%- endif -%}

        <div class="lb-carousel-track" id="lbCarouselTrack">
          {%- if combo2_in_stock -%}
            <div class="lb-carousel-slide is-active" data-slide-index="0">
              <a href="{{ combo2_url }}" class="lb-combo-popup-image-link">
                <span class="lb-slide-corner-pill">Promo #1 &middot; 3 Prendas 10K</span>
                <img
                  src="{{ combo2_img }}"
                  alt="Combo Exclusivo 3 Prendas ($564.99): Argollas Torcidas Talla 1 + Cadena Fina 20 Pulgadas + Dije Inicial con Corona en Oro 10K"
                  width="1024"
                  height="1024"
                  loading="eager"
                >
              </a>
              <div class="lb-slide-body">
                <a href="{{ combo2_url }}" class="lb-combo-popup-cta">
                  Elegir Mi Letra Inicial &mdash; Solo $564.99
                </a>
              </div>
            </div>
          {%- endif -%}

          {%- if combo1_in_stock -%}
            <div class="lb-carousel-slide {% unless combo2_in_stock %}is-active{% endunless %}" data-slide-index="{% if combo2_in_stock %}1{% else %}0{% endif %}">
              <a href="{{ combo1_url }}" class="lb-combo-popup-image-link">
                <span class="lb-slide-corner-pill">Promo #{% if combo2_in_stock %}2{% else %}1{% endif %} &middot; 4 Prendas</span>
                <img
                  src="{{ combo1_img }}"
                  alt="Combo Exclusivo 4 Prendas ($749): Reloj Seiko 5 Automático Dorado + 3 Pares de Argollas Oro 10K"
                  width="1024"
                  height="1024"
                  loading="eager"
                >
              </a>
              <div class="lb-slide-body">
                <a href="{{ combo1_url }}" class="lb-combo-popup-cta">
                  Ver Combo Seiko + 3 Argollas &mdash; $749
                </a>
              </div>
            </div>
          {%- endif -%}
        </div>
      </div>

      <div class="lb-carousel-footer">
        {%- if combo1_in_stock and combo2_in_stock -%}
          <div class="lb-carousel-thumbs">
            <button type="button" class="lb-carousel-thumb is-active" data-goto-slide="0">
              <img src="{{ combo2_img }}" alt="Combo Iniciales 10K">
              <span class="lb-carousel-thumb-meta">
                <span class="lb-carousel-thumb-title">1. Cadena + Inicial + Argollas</span>
                <span class="lb-carousel-thumb-price">$564.99 (Ahorra +$225)</span>
              </span>
            </button>
            <button type="button" class="lb-carousel-thumb" data-goto-slide="1">
              <img src="{{ combo1_img }}" alt="Combo Seiko + 3 Argollas">
              <span class="lb-carousel-thumb-meta">
                <span class="lb-carousel-thumb-title">2. Seiko 5 + 3 Argollas 10K</span>
                <span class="lb-carousel-thumb-price">$749.00 (Ahorra +$300)</span>
              </span>
            </button>
          </div>
          <div class="lb-carousel-dots-row">
            <button type="button" class="lb-carousel-dot is-active" data-goto-slide="0" aria-label="Ir a promoción 1"></button>
            <button type="button" class="lb-carousel-dot" data-goto-slide="1" aria-label="Ir a promoción 2"></button>
            <span class="lb-carousel-swipe-hint">‹ Desliza para ver más promociones ›</span>
