        <button type="button" class="lb-combo-popup-dismiss" id="lbComboPopupDismiss">
          Continuar viendo la tienda
        </button>
      </div>
    </div>
  </div>

  <button type="button" id="lbComboFloatingPill" class="lb-combo-floating-pill" aria-label="Ver Carrusel de Combos Exclusivos">
