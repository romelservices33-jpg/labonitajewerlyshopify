{%- comment -%}
  Barra de Progreso de Combos Progresivos Exclusivos (solo para piezas de los combos existentes en `elegibles-combo-progresivo`:
  2 piezas = 10% OFF, 3 piezas = 15% OFF, 4+ piezas = 20% OFF automático — nunca aparece en prendas fuera de combos)
{%- endcomment -%}
{%- assign prog_eligible_ids = ',' -%}
{%- if collections['elegibles-combo-progresivo'] != blank -%}
  {%- for ep in collections['elegibles-combo-progresivo'].products -%}
    {%- assign prog_eligible_ids = prog_eligible_ids | append: ep.id | append: ',' -%}
  {%- endfor -%}
{%- endif -%}

{%- assign prog_qty = 0 -%}
{%- for item in cart.items -%}
  {%- assign pid_tok = ',' | append: item.product.id | append: ',' -%}
  {%- if prog_eligible_ids contains pid_tok -%}
    {%- assign prog_qty = prog_qty | plus: item.quantity -%}
  {%- endif -%}
{%- endfor -%}

{%- if prog_qty > 0 -%}
  {%- assign prog_bar_w = 25 -%}
  {%- if prog_qty >= 4 -%}
    {%- assign prog_bar_w = 100 -%}
  {%- elsif prog_qty == 3 -%}
    {%- assign prog_bar_w = 75 -%}
  {%- elsif prog_qty == 2 -%}
    {%- assign prog_bar_w = 50 -%}
  {%- endif -%}

  <div class="lb-prog-combo-card" style="background: linear-gradient(135deg, #08195B 0%, #0D247A 100%); border: 1.5px solid rgba(209, 176, 84, 0.55); border-radius: {% if compact %}12px{% else %}16px{% endif %}; padding: {% if compact %}10px 12px{% else %}14px 20px{% endif %}; margin-bottom: {% if compact %}12px{% else %}20px{% endif %}; color: #FFFFFF; box-shadow: 0 6px 18px rgba(8, 25, 91, 0.14);">
    <div style="display: flex; align-items: center; justify-content: space-between; gap: 8px; flex-wrap: wrap; margin-bottom: 8px;">
      <div style="font-size: {% if compact %}0.78rem{% else %}0.88rem{% endif %}; font-weight: 700; line-height: 1.35;">
        {%- if prog_qty == 1 -%}
          <span>★ Llevas <strong>1 pieza de combo</strong> — agrega <strong>1 más</strong> de la selección de combos para <strong style="color:#F5D77F;">10% OFF automático</strong></span>
        {%- elsif prog_qty == 2 -%}
          <span>✦ ¡<strong style="color:#F5D77F;">Combo Progresivo x2 activo (10% OFF)</strong>! Agrega <strong>1 pieza más</strong> y sube a <strong style="color:#F5D77F;">15% OFF</strong></span>
        {%- elsif prog_qty == 3 -%}
          <span>✦ ¡<strong style="color:#F5D77F;">Combo Progresivo x3 activo (15% OFF)</strong>! Agrega <strong>1 más</strong> para lograr <strong style="color:#F5D77F;">20% OFF</strong></span>
        {%- else -%}
          <span>✦ <strong style="color:#F5D77F;">¡COMBO PROGRESIVO MÁXIMO ACTIVO (20% OFF automático en piezas de combos)!</strong></span>
        {%- endif -%}
      </div>
      {%- if prog_qty < 4 and compact != true -%}
        <a href="/collections/elegibles-combo-progresivo" style="font-size: 0.74rem; font-weight: 800; text-transform: uppercase; letter-spacing: 0.05em; color: #08195B; background: linear-gradient(135deg, #F5D77F, #D1B054); padding: 6px 12px; border-radius: 999px; text-decoration: none; white-space: nowrap;">+ Pieza de Combo</a>
      {%- endif -%}
    </div>

    <div style="width: 100%; height: 6px; background: rgba(255, 255, 255, 0.18); border-radius: 999px; overflow: hidden; margin-bottom: 8px;">
      <div style="display: block !important; width: {{ prog_bar_w }}%; height: 100%; background: linear-gradient(90deg, #D1B054, #F7E39C); border-radius: 999px; transition: width 0.35s ease;"></div>
    </div>

    <div style="display: grid; grid-template-columns: repeat(3, 1fr); gap: 6px; text-align: center; font-size: {% if compact %}0.68rem{% else %}0.75rem{% endif %}; font-weight: 700;">
      <span style="padding: 3px 6px; border-radius: 6px; background: {% if prog_qty >= 2 %}rgba(245, 215, 127, 0.22){% else %}rgba(255, 255, 255, 0.07){% endif %}; color: {% if prog_qty >= 2 %}#F7E39C{% else %}rgba(255, 255, 255, 0.72){% endif %}; border: 1px solid {% if prog_qty >= 2 %}rgba(245, 215, 127, 0.6){% else %}transparent{% endif %};">2 piezas · 10% OFF</span>
      <span style="padding: 3px 6px; border-radius: 6px; background: {% if prog_qty >= 3 %}rgba(245, 215, 127, 0.22){% else %}rgba(255, 255, 255, 0.07){% endif %}; color: {% if prog_qty >= 3 %}#F7E39C{% else %}rgba(255, 255, 255, 0.72){% endif %}; border: 1px solid {% if prog_qty >= 3 %}rgba(245, 215, 127, 0.6){% else %}transparent{% endif %};">3 piezas · 15% OFF</span>
      <span style="padding: 3px 6px; border-radius: 6px; background: {% if prog_qty >= 4 %}rgba(245, 215, 127, 0.22){% else %}rgba(255, 255, 255, 0.07){% endif %}; color: {% if prog_qty >= 4 %}#F7E39C{% else %}rgba(255, 255, 255, 0.72){% endif %}; border: 1px solid {% if prog_qty >= 4 %}rgba(245, 215, 127, 0.6){% else %}transparent{% endif %};">4+ piezas · 20% OFF</span>
    </div>
  </div>
{%- endif -%}
