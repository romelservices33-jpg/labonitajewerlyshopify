{%- comment -%}
  Barra de Progreso de Combo Progresivo (2 prendas = 5%, 3 prendas = 10%, 4+ prendas = 15% OFF automático)
  Parámetro opcional: compact (true para Cart Drawer, false para Cart Page)
{%- endcomment -%}
{%- assign prog_qty = 0 -%}
{%- for item in cart.items -%}
  {%- unless item.product.tags contains 'cat:combos' or item.product.handle contains 'combo-' -%}
    {%- assign prog_qty = prog_qty | plus: item.quantity -%}
  {%- endunless -%}
{%- endfor -%}

{%- assign prog_pct_discount = 0 -%}
{%- assign prog_bar_w = 0 -%}
{%- if prog_qty >= 4 -%}
  {%- assign prog_pct_discount = 15 -%}
  {%- assign prog_bar_w = 100 -%}
{%- elsif prog_qty == 3 -%}
  {%- assign prog_pct_discount = 10 -%}
  {%- assign prog_bar_w = 75 -%}
{%- elsif prog_qty == 2 -%}
  {%- assign prog_pct_discount = 5 -%}
  {%- assign prog_bar_w = 50 -%}
{%- elsif prog_qty == 1 -%}
  {%- assign prog_bar_w = 25 -%}
{%- endif -%}

<div class="lb-prog-combo-card" style="background: linear-gradient(135deg, #08195B 0%, #0D247A 100%); border: 1.5px solid rgba(209, 176, 84, 0.55); border-radius: {% if compact %}12px{% else %}16px{% endif %}; padding: {% if compact %}10px 12px{% else %}14px 20px{% endif %}; margin-bottom: {% if compact %}12px{% else %}20px{% endif %}; color: #FFFFFF; box-shadow: 0 6px 18px rgba(8, 25, 91, 0.14);">
  <div style="display: flex; align-items: center; justify-content: space-between; gap: 8px; flex-wrap: wrap; margin-bottom: 8px;">
    <div style="font-size: {% if compact %}0.78rem{% else %}0.88rem{% endif %}; font-weight: 700; line-height: 1.35;">
      {%- if prog_qty == 0 -%}
        <span>★ <strong>Arma tu Combo Progresivo:</strong> agrega 2 joyas para <strong>5% OFF</strong>, 3 para <strong>10% OFF</strong> o 4+ para <strong>15% OFF</strong></span>
      {%- elsif prog_qty == 1 -%}
        <span>★ ¡Llevas 1 joya! Agrega <strong>1 prenda más</strong> para activar <strong style="color:#F5D77F;">5% OFF automático</strong></span>
      {%- elsif prog_qty == 2 -%}
        <span>✦ ¡<strong style="color:#F5D77F;">Combo x2 activo (5% OFF)</strong>! Agrega <strong>1 más</strong> y sube a <strong style="color:#F5D77F;">10% OFF</strong></span>
      {%- elsif prog_qty == 3 -%}
        <span>✦ ¡<strong style="color:#F5D77F;">Combo x3 activo (10% OFF)</strong>! Agrega <strong>1 más</strong> para lograr el <strong style="color:#F5D77F;">15% OFF VIP</strong></span>
      {%- else -%}
        <span>✦ <strong style="color:#F5D77F;">¡COMBO PROGRESIVO MÁXIMO ACTIVO (15% OFF automático)!</strong></span>
      {%- endif -%}
    </div>
    {%- if prog_qty < 4 and compact != true -%}
      <a href="/collections/all" style="font-size: 0.74rem; font-weight: 800; text-transform: uppercase; letter-spacing: 0.05em; color: #08195B; background: linear-gradient(135deg, #F5D77F, #D1B054); padding: 6px 12px; border-radius: 999px; text-decoration: none; white-space: nowrap;">+ Agregar Joya</a>
    {%- endif -%}
  </div>

  <div style="width: 100%; height: 6px; background: rgba(255, 255, 255, 0.18); border-radius: 999px; overflow: hidden; margin-bottom: 8px;">
    <div style="display: block !important; width: {{ prog_bar_w }}%; height: 100%; background: linear-gradient(90deg, #D1B054, #F7E39C); border-radius: 999px; transition: width 0.35s ease;"></div>
  </div>

  <div style="display: grid; grid-template-columns: repeat(3, 1fr); gap: 6px; text-align: center; font-size: {% if compact %}0.68rem{% else %}0.75rem{% endif %}; font-weight: 700;">
    <span style="padding: 3px 6px; border-radius: 6px; background: {% if prog_qty >= 2 %}rgba(245, 215, 127, 0.22){% else %}rgba(255, 255, 255, 0.07){% endif %}; color: {% if prog_qty >= 2 %}#F7E39C{% else %}rgba(255, 255, 255, 0.72){% endif %}; border: 1px solid {% if prog_qty >= 2 %}rgba(245, 215, 127, 0.6){% else %}transparent{% endif %};">2 prendas · 5% OFF</span>
    <span style="padding: 3px 6px; border-radius: 6px; background: {% if prog_qty >= 3 %}rgba(245, 215, 127, 0.22){% else %}rgba(255, 255, 255, 0.07){% endif %}; color: {% if prog_qty >= 3 %}#F7E39C{% else %}rgba(255, 255, 255, 0.72){% endif %}; border: 1px solid {% if prog_qty >= 3 %}rgba(245, 215, 127, 0.6){% else %}transparent{% endif %};">3 prendas · 10% OFF</span>
    <span style="padding: 3px 6px; border-radius: 6px; background: {% if prog_qty >= 4 %}rgba(245, 215, 127, 0.22){% else %}rgba(255, 255, 255, 0.07){% endif %}; color: {% if prog_qty >= 4 %}#F7E39C{% else %}rgba(255, 255, 255, 0.72){% endif %}; border: 1px solid {% if prog_qty >= 4 %}rgba(245, 215, 127, 0.6){% else %}transparent{% endif %};">4+ prendas · 15% OFF</span>
  </div>
</div>
