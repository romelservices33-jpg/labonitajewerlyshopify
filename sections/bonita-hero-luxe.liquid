{{ 'luxury-bonita.css' | asset_url | stylesheet_tag }}

<section class="bonita-hero-section" id="Hero-{{ section.id }}">
  {%- if section.settings.image != blank -%}
    <img
      src="{{ section.settings.image | image_url: width: 2000 }}"
      alt="{{ section.settings.title | escape }}"
      class="bonita-hero-bg"
      loading="eager"
      width="2000"
      height="1200"
    >
  {%- else -%}
    <img
      src="https://images.unsplash.com/photo-1599643478518-a784e5dc4c8f?auto=format&fit=crop&w=2000&q=80"
      alt="La Bonita Joyería Oro 10k"
      class="bonita-hero-bg"
      loading="eager"
      width="2000"
      height="1200"
    >
  {%- endif -%}

  <div class="bonita-hero-overlay"></div>

  <div class="bonita-hero-container">
    <!-- Left Column: Copy & CTAs -->
    <div class="bonita-hero-content">
      {%- if section.settings.badge_text != blank -%}
        <div class="bonita-hero-badge">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor">
            <polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"></polygon>
          </svg>
          <span>{{ section.settings.badge_text }}</span>
        </div>
      {%- endif -%}

      <h1 class="bonita-hero-title">
        {{ section.settings.title_prefix }}
        <span class="bonita-gold-text">{{ section.settings.title_highlight }}</span>
        {{ section.settings.title_suffix }}
      </h1>

      {%- if section.settings.subtitle != blank -%}
        <p class="bonita-hero-subtitle">{{ section.settings.subtitle }}</p>
      {%- endif -%}

      <div class="bonita-hero-actions">
        {%- if section.settings.btn_1_text != blank -%}
          <a href="{{ section.settings.btn_1_url }}" class="bonita-shimmer-btn">
            <span>{{ section.settings.btn_1_text }}</span>
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
              <line x1="5" y1="12" x2="19" y2="12"></line>
              <polyline points="12 5 19 12 12 19"></polyline>
            </svg>
          </a>
        {%- endif -%}

        {%- if section.settings.btn_2_text != blank -%}
          <a href="{{ section.settings.btn_2_url }}" class="bonita-outline-btn">
            <span>{{ section.settings.btn_2_text }}</span>
          </a>
        {%- endif -%}
      </div>

      <!-- Trust Stats -->
      <div class="bonita-hero-stats">
        <div>
          <span class="bonita-hero-stat-number">10K & 14K</span>
          <span class="bonita-hero-stat-label">Oro 100% Real</span>
        </div>
        <div>
          <span class="bonita-hero-stat-number">$0 DOWN</span>
          <span class="bonita-hero-stat-label">Financiamiento</span>
        </div>
        <div>
          <span class="bonita-hero-stat-number">FEDEX / UPS</span>
          <span class="bonita-hero-stat-label">Envío Asegurado</span>
        </div>
      </div>
    </div>

    <!-- Right Column: 3D Floating Showcase Card -->
    <div class="bonita-hero-visual">
      <div class="bonita-hero-card">
        <div class="bonita-hero-card-img-wrapper">
          <span class="bonita-hero-card-pill">Colección Insignia</span>
          {%- if section.settings.card_image != blank -%}
            <img
              src="{{ section.settings.card_image | image_url: width: 800 }}"
              alt="{{ section.settings.card_title }}"
              class="bonita-hero-card-img"
              width="800"
              height="800"
            >
          {%- else -%}
            <img
              src="https://images.unsplash.com/photo-1611591475850-538965f7cba4?auto=format&fit=crop&w=800&q=80"
              alt="Cadena Cubana Miami"
              class="bonita-hero-card-img"
              width="800"
              height="800"
            >
          {%- endif -%}
        </div>
        <div class="bonita-hero-card-info">
          <div>
            <h3 class="bonita-hero-card-title">{{ section.settings.card_title | default: 'Miami Cuban Link 10K' }}</h3>
            <p class="bonita-hero-card-sub">{{ section.settings.card_subtitle | default: 'Oro Sólido • Hecho a Mano' }}</p>
          </div>
          <div>
            <div class="bonita-hero-card-price">{{ section.settings.card_price | default: 'Desde $499' }}</div>
            <div class="bonita-hero-card-financing">o 4 cuotas con Klarna</div>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Hero Luxe Bonita",
  "settings": [
    {
      "type": "image_picker",
      "id": "image",
      "label": "Imagen de Fondo"
    },
    {
      "type": "text",
      "id": "badge_text",
      "label": "Texto de Insignia",
      "default": "Alta Joyería • Oro 10k y 14k Garantizado"
    },
    {
      "type": "text",
      "id": "title_prefix",
      "label": "Título (Prefijo)",
      "default": "EL LUJO DEL ORO"
    },
    {
      "type": "text",
      "id": "title_highlight",
      "label": "Título (Resaltado Dorado)",
      "default": "AUTÉNTICO"
    },
    {
      "type": "text",
      "id": "title_suffix",
      "label": "Título (Sufijo)",
      "default": "A TU ALCANCE"
    },
    {
      "type": "textarea",
      "id": "subtitle",
      "label": "Subtítulo",
      "default": "Cadenas Cubanas Miami hechas con eslabón sólido, dijes exclusivos y piezas personalizadas en oro real 10k y 14k. Estrena hoy y paga en cuotas sin afectar tu crédito."
    },
    {
      "type": "text",
      "id": "btn_1_text",
      "label": "Botón 1 (Texto)",
      "default": "Ver Cadenas Cubanas"
    },
    {
      "type": "url",
      "id": "btn_1_url",
      "label": "Botón 1 (Enlace)",
      "default": "/collections/all"
    },
    {
      "type": "text",
      "id": "btn_2_text",
      "label": "Botón 2 (Texto)",
      "default": "Piezas Personalizadas"
    },
    {
      "type": "url",
      "id": "btn_2_url",
      "label": "Botón 2 (Enlace)",
      "default": "/pages/contact"
    },
    {
      "type": "header",
      "content": "Tarjeta Destacada (Columna Derecha)"
    },
    {
      "type": "image_picker",
      "id": "card_image",
      "label": "Imagen de la Tarjeta"
    },
    {
      "type": "text",
      "id": "card_title",
      "label": "Título de la Tarjeta",
      "default": "Miami Cuban Link 10K"
    },
    {
      "type": "text",
      "id": "card_subtitle",
      "label": "Subtítulo de la Tarjeta",
      "default": "Eslabón Sólido • Calidad Miami"
    },
    {
      "type": "text",
      "id": "card_price",
      "label": "Precio de la Tarjeta",
      "default": "Desde $499"
    }
  ],
  "presets": [
    {
      "name": "Hero Luxe Bonita"
    }
  ]
}
{% endschema %}
