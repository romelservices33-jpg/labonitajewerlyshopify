{{ 'editorial-luxury.css' | asset_url | stylesheet_tag }}

<!-- ========================================================================= -->
<!-- ROYAL BLUE GRADIENT LUXURY FOOTER (Watermelon/Shadcn footer-7 style)      -->
<!-- ========================================================================= -->
<footer class="site-luxury-royal-footer" id="contacto" role="contentinfo" aria-label="Pie de página La Bonita Jewelry">
  <div class="luxury-footer-container">
    
    <!-- 1. VIP NEWSLETTER & CLUB ACCENT BAR -->
    <div class="footer-vip-newsletter-bar">
      <div class="footer-newsletter-info">
        <span class="vip-kicker">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor">
            <path d="M5 16L3 5l5.5 5L12 4l3.5 6L21 5l-2 11H5m14 3c0 .6-.4 1-1 1H6c-.6 0-1-.4-1-1v-1h14v1z"/>
          </svg>
          CLUB PRIVADO LA BONITA · ACCESO VIP
        </span>
        <h3 class="newsletter-headline">Recibe Preventas Exclusivas y Joyas Nuevas</h3>
        <p class="newsletter-sub">Sé el primero en conocer nuestros lanzamientos en Oro Auténtico 10K y 14K, descuentos para miembros y eventos privados.</p>
      </div>

      <div class="footer-newsletter-form-wrap">
        {% form 'customer', class: 'footer-newsletter-form' %}
          <input type="hidden" name="contact[tags]" value="newsletter, vip_club">
          <div class="newsletter-input-group">
            <input 
              type="email" 
              name="contact[email]" 
              id="FooterNewsletterEmail" 
              class="newsletter-input" 
              placeholder="Ingresa tu correo electrónico..." 
              required
              aria-label="Correo electrónico para suscripción VIP"
              autocomplete="email"
            >
            <button type="submit" class="newsletter-submit-btn" aria-label="Unirme al Club Privado">
              <span>UNIRME AL CLUB</span>
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
                <line x1="5" y1="12" x2="19" y2="12"></line>
                <polyline points="12 5 19 12 12 19"></polyline>
              </svg>
            </button>
          </div>
          {%- if form.posted_successfully? -%}
            <p class="newsletter-success-msg">¡Bienvenido al Club Privado! Te hemos enviado una confirmación.</p>
          {%- endif -%}
        {% endform %}
      </div>
    </div>

    <!-- 2. MAIN 4-COLUMN LUXURY GRID -->
    <div class="footer-main-grid-royal">
      
      <!-- Col 1: Brand Showcase & Concierge -->
      <div class="footer-col-brand-royal">
        <a href="{{ routes.root_url }}" class="footer-brand-logo-link" title="La Bonita Jewelry">
          <img src="{{ 'logo-completo.svg' | asset_url }}" alt="La Bonita Jewelry" class="footer-brand-img">
        </a>
        <p class="footer-brand-desc">
          Maestría artesanal en alta joyería de <strong>Oro Auténtico 10K y 14K</strong>. Calidad certificada de por vida, envíos asegurados a todo EE. UU. y Puerto Rico, y facilidades de pago a plazos.
        </p>

        <!-- Direct Concierge Button -->
        <a href="https://wa.me/15025994250" target="_blank" rel="noopener" class="footer-whatsapp-concierge-btn">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor">
            <path d="M12.04 2c-5.46 0-9.91 4.45-9.91 9.91 0 1.75.46 3.45 1.32 4.95L2.05 22l5.25-1.38c1.45.79 3.08 1.21 4.74 1.21 5.46 0 9.91-4.45 9.91-9.91 0-2.65-1.03-5.14-2.9-7.01A9.816 9.816 0 0012.04 2zm0 18.06c-1.49 0-2.95-.4-4.22-1.16l-.3-.18-3.13.82.83-3.05-.2-.31a8.13 8.13 0 01-1.25-4.28c0-4.51 3.67-8.17 8.18-8.17 2.18 0 4.24.85 5.78 2.39 1.54 1.54 2.39 3.6 2.39 5.78 0 4.51-3.67 8.16-8.18 8.16zm4.49-6.13c-.25-.12-1.47-.72-1.7-.81-.23-.08-.39-.12-.56.12-.17.25-.64.81-.79.97-.14.17-.29.19-.54.06-.25-.12-1.05-.39-2-1.23-.74-.66-1.24-1.47-1.39-1.72-.14-.25-.02-.38.11-.5.11-.11.25-.29.37-.43.12-.14.17-.25.25-.41.08-.17.04-.31-.02-.43s-.56-1.34-.76-1.84c-.2-.48-.41-.42-.56-.43h-.48c-.17 0-.44.06-.67.31-.23.25-.88.86-.88 2.1 0 1.24.9 2.44 1.03 2.61.12.17 1.77 2.71 4.3 3.79.6.26 1.07.41 1.44.53.61.19 1.16.17 1.6.1.49-.07 1.47-.6 1.68-1.18.21-.58.21-1.07.14-1.18-.06-.11-.23-.17-.48-.29z"/>
          </svg>
          <span>Asesoría VIP por WhatsApp</span>
        </a>

        <!-- Social Media Icons Row -->
        <div class="footer-social-links-row">
          <a href="https://instagram.com" target="_blank" rel="noopener" class="footer-social-icon-btn" aria-label="Instagram">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <rect x="2" y="2" width="20" height="20" rx="5" ry="5"></rect>
              <path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"></path>
              <line x1="17.5" y1="6.5" x2="17.51" y2="6.5"></line>
            </svg>
          </a>
          <a href="https://facebook.com" target="_blank" rel="noopener" class="footer-social-icon-btn" aria-label="Facebook">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor">
              <path d="M22.675 0h-21.35C.597 0 0 .597 0 1.325v21.351C0 23.403.597 24 1.325 24H12.82v-9.294H9.692v-3.622h3.128V8.413c0-3.1 1.893-4.788 4.659-4.788 1.325 0 2.463.099 2.795.143v3.24l-1.918.001c-1.504 0-1.795.715-1.795 1.763v2.313h3.587l-.467 3.622h-3.12V24h6.116c.73 0 1.323-.597 1.323-1.324V1.325C24 .597 23.403 0 22.675 0z"/>
            </svg>
          </a>
          <a href="https://tiktok.com" target="_blank" rel="noopener" class="footer-social-icon-btn" aria-label="TikTok">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor">
              <path d="M12.525.02c1.31 0 2.57.34 3.68.96-.06.77-.14 1.54-.25 2.3-.92-.5-1.95-.78-3.03-.78V14.1c0 2.65-2.15 4.8-4.8 4.8-2.65 0-4.8-2.15-4.8-4.8 0-2.65 2.15-4.8 4.8-4.8.36 0 .71.04 1.04.12v2.53c-.32-.14-.67-.22-1.04-.22-1.31 0-2.37 1.06-2.37 2.37s1.06 2.37 2.37 2.37 2.37-1.06 2.37-2.37V0h2.03z"/>
            </svg>
          </a>
          <a href="https://wa.me/15025994250" target="_blank" rel="noopener" class="footer-social-icon-btn" aria-label="WhatsApp">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor">
              <path d="M12.04 2c-5.46 0-9.91 4.45-9.91 9.91 0 1.75.46 3.45 1.32 4.95L2.05 22l5.25-1.38c1.45.79 3.08 1.21 4.74 1.21 5.46 0 9.91-4.45 9.91-9.91 0-2.65-1.03-5.14-2.9-7.01A9.816 9.816 0 0012.04 2zm0 18.06c-1.49 0-2.95-.4-4.22-1.16l-.3-.18-3.13.82.83-3.05-.2-.31a8.13 8.13 0 01-1.25-4.28c0-4.51 3.67-8.17 8.18-8.17 2.18 0 4.24.85 5.78 2.39 1.54 1.54 2.39 3.6 2.39 5.78 0 4.51-3.67 8.16-8.18 8.16z"/>
            </svg>
          </a>
        </div>
      </div>

      <!-- Col 2: Colecciones Exclusivas -->
      <div class="footer-col-nav-royal">
        <h4 class="footer-col-title">
          <span>Colecciones</span>
          <span class="gold-dot"></span>
        </h4>
        <ul class="footer-links-list">
          <li><a href="/collections/cadenas">Cadenas de Oro 10K & 14K</a></li>
          <li><a href="/collections/cuban">Especialidad Cuban Links</a></li>
          <li><a href="/collections/anillos">Anillos & Sortijas de Compromiso</a></li>
          <li><a href="/collections/aretes">Aretes, Broqueles & Arracadas</a></li>
          <li><a href="/collections/pulseras">Pulseras & Esclavas de Lujo</a></li>
          <li><a href="/collections/dijes">Dijes & Medallas Religiosas</a></li>
        </ul>
      </div>

      <!-- Col 3: Confianza, Affirm & Garantía -->
      <div class="footer-col-nav-royal">
        <h4 class="footer-col-title">
          <span>Servicio & Confianza</span>
          <span class="gold-dot"></span>
        </h4>
        <ul class="footer-links-list">
          <li><a href="#financiamiento">Financiamiento con Affirm (0% APR)</a></li>
          <li><a href="#garantia">Certificado de Autenticidad de por Vida</a></li>
          <li><a href="#envios">Envíos Asegurados a Todo USA & PR</a></li>
          <li><a href="#guia-tallas">Guía de Tallas y Cuidado del Oro</a></li>
          <li><a href="#faq">Preguntas Frecuentes (FAQ)</a></li>
          <li><a href="#garantia">Política de Garantía y Devolución</a></li>
        </ul>
      </div>

      <!-- Col 4: Contacto Directo & Sede -->
      <div class="footer-col-nav-royal">
        <h4 class="footer-col-title">
          <span>Contacto & Sede</span>
          <span class="gold-dot"></span>
        </h4>
        <ul class="footer-contact-items">
          <li>
            <span class="contact-icon-wrap">
              <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"></path>
                <circle cx="12" cy="10" r="3"></circle>
              </svg>
            </span>
            <div class="contact-text">
              <strong>Sede Principal:</strong>
              <span>Louisville, Kentucky, USA</span>
            </div>
          </li>
          <li>
            <span class="contact-icon-wrap">
              <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"></path>
              </svg>
            </span>
            <div class="contact-text">
              <strong>Línea Telefónica:</strong>
              <a href="tel:5025994250">+1 (502) 599-4250</a>
            </div>
          </li>
          <li>
            <span class="contact-icon-wrap">
              <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"></path>
                <polyline points="22,6 12,13 2,6"></polyline>
              </svg>
            </span>
            <div class="contact-text">
              <strong>Email de Atención:</strong>
              <a href="mailto:romelservices33@gmail.com">romelservices33@gmail.com</a>
            </div>
          </li>
          <li>
            <span class="contact-icon-wrap">
              <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <circle cx="12" cy="12" r="10"></circle>
                <polyline points="12 6 12 12 16 14"></polyline>
              </svg>
            </span>
            <div class="contact-text">
              <strong>Horario VIP:</strong>
              <span>Lun - Sáb: 10:00 AM - 8:00 PM EST</span>
            </div>
          </li>
        </ul>
      </div>

    </div>

    <!-- 3. BOTTOM LEGAL, COPYRIGHT & PAYMENT BADGES -->
    <div class="footer-bottom-bar-royal">
      <div class="footer-copyright-col">
        <p class="copyright-text">
          © {{ 'now' | date: '%Y' }} <strong>La Bonita Jewelry LLC</strong>. Todos los derechos reservados. Oro Auténtico 10K & 14K con Garantía Certificada.
        </p>
        <div class="footer-legal-links">
          <a href="/policies/terms-of-service">Términos del Servicio</a>
          <span class="legal-sep">·</span>
          <a href="/policies/privacy-policy">Política de Privacidad</a>
          <span class="legal-sep">·</span>
          <a href="/policies/shipping-policy">Envíos & Devoluciones</a>
        </div>
      </div>

      <!-- Frosted Payment Pills (Glassmorphism) -->
      <div class="footer-payment-badges-wrap">
        <span class="pay-pill">VISA</span>
        <span class="pay-pill">MASTERCARD</span>
        <span class="pay-pill">AMEX</span>
        <span class="pay-pill">DISCOVER</span>
        <span class="pay-pill pay-pill-gold">AFFIRM</span>
        <span class="pay-pill">APPLE PAY</span>
        <span class="pay-pill">GOOGLE PAY</span>
        <span class="pay-pill">SHOP PAY</span>
      </div>
    </div>

  </div>
</footer>

