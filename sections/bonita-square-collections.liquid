{{ 'editorial-luxury.css' | asset_url | stylesheet_tag }}

<section class="bonita-square-collections-section" id="SquareCollections-{{ section.id }}">
  <div class="hero-overlapping-cards-wrap">
    <div class="cat-slider-container">
      <!-- Previous Button -->
      <button type="button" class="cat-slider-arrow prev is-hidden" id="catSliderPrev-{{ section.id }}" aria-label="Colección anterior">
        <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
          <polyline points="15 18 9 12 15 6"></polyline>
        </svg>
      </button>

      <!-- Slider Track: Square 1:1 Cards -->
      <div class="cat-slider-track" id="catSliderTrack-{{ section.id }}">
        {%- if section.blocks.size > 0 -%}
          {%- for block in section.blocks -%}
            <a href="{{ block.settings.link | default: '#catalogo' }}" onclick="if(typeof window.filterCatalog==='function'){var t='{{ block.settings.title | downcase }}'; if(t.includes('cadena'))window.filterCatalog('cadenas');else if(t.includes('anillo'))window.filterCatalog('anillos');else if(t.includes('arete'))window.filterCatalog('aretes');else if(t.includes('pulsera'))window.filterCatalog('pulseras');else if(t.includes('cuban'))window.filterCatalog('cuban');else if(t.includes('dije')||t.includes('medalla'))window.filterCatalog('dijes');else window.filterCatalog('todos'); return false;}" class="cat-square-card" {{ block.shopify_attributes }}>
              <div class="cat-card-header">
                <span class="cat-card-label">{{ block.settings.label | default: 'Categorías' }}</span>
                <h3 class="cat-card-title">{{ block.settings.title }}</h3>
              </div>
              <div class="cat-card-img-wrap">
                {%- if block.settings.image != blank -%}
                  <img
                    src="{{ block.settings.image | image_url: width: 800 }}"
                    alt="{{ block.settings.title | escape }}"
                    class="cat-square-img"
                    loading="lazy"
                    width="800"
                    height="800"
                  >
                {%- else -%}
                  {{ 'image' | placeholder_svg_tag: 'cat-square-img' }}
                {%- endif -%}
              </div>
              <div class="cat-card-footer">
                <span class="cat-pill-btn">
                  <span>{{ block.settings.btn_label | default: 'Ver Colección' }}</span>
                  <svg class="cat-pill-arrow" viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M5 12h14M12 5l7 7-7 7"/>
                  </svg>
                </span>
              </div>
            </a>
          {%- endfor -%}
        {%- else -%}
          <!-- Default 9 Luxury Categories -->
          <a href="#catalogo" onclick="if(typeof window.filterCatalog==='function'){window.filterCatalog('cadenas');return false;}" class="cat-square-card">
            <div class="cat-card-header">
              <span class="cat-card-label">Categorías</span>
              <h3 class="cat-card-title">Cadenas</h3>
            </div>
            <div class="cat-card-img-wrap">
              <img src="{{ 'collection-cuban.jpg' | asset_url }}" alt="Cadenas de Oro 10K y 14K" class="cat-square-img" loading="lazy">
            </div>
            <div class="cat-card-footer">
              <span class="cat-pill-btn">
                <span>Ver Colección</span>
                <svg class="cat-pill-arrow" viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
              </span>
            </div>
          </a>

          <a href="#catalogo" onclick="if(typeof window.filterCatalog==='function'){window.filterCatalog('cuban');return false;}" class="cat-square-card">
            <div class="cat-card-header">
              <span class="cat-card-label">Especialidad</span>
              <h3 class="cat-card-title">Cadenas Cubanas</h3>
            </div>
            <div class="cat-card-img-wrap">
              <img src="{{ 'collection-cadenas.jpg' | asset_url }}" alt="