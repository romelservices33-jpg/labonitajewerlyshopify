{{ 'luxury-bonita.css' | asset_url | stylesheet_tag }}

<section class="bonita-categories-section" id="Categories-{{ section.id }}">
  <div class="bonita-section-header">
    {%- if section.settings.subtitle != blank -%}
      <span class="bonita-section-subtitle">{{ section.settings.subtitle }}</span>
    {%- endif -%}
    <h2 class="bonita-section-title">
      {{ section.settings.title_prefix }}
      <span class="bonita-gold-text">{{ section.settings.title_highlight }}</span>
    </h2>
    {%- if section.settings.description != blank -%}
      <p class="bonita-section-desc">{{ section.settings.description }}</p>
    {%- endif -%}
  </div>

  <div class="bonita-categories-grid">
    <!-- Card 1: Featured Cuban Links (Span 8) -->
    <a href="{{ section.settings.cat_1_link | default: '/collections/all' }}" class="bonita-cat-card featured">
      {%- if section.settings.cat_1_image != blank -%}
        <img
          src="{{ section.settings.cat_1_image | image_url: width: 1200 }}"
          alt="{{ section.settings.cat_1_title }}"
          class="bonita-cat-bg"
          loading="lazy"
          width="1200"
          height="800"
        >
      {%- else -%}
        <img
          src="{{ 'collection-cadenas.jpg' | asset_url }}"
          alt="Cadenas Cubanas y Collares de Oro"
          class="bonita-cat-bg"
          loading="lazy"
          width="1200"
          height="800"
        >
      {%- endif -%}
      <div class="bonita-cat-overlay"></div>
      <div class="bonita-cat-content">
        <h3 class="bonita-cat-title">{{ section.settings.cat_1_title | default: 'Cadenas' }}</h3>
        <span class="bonita-cat-cta">
          <span>Explorar</span>
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
            <line x1="5" y1="12" x2="19" y2="12"></line>
            <polyline points="12 5 19 12 12 19"></polyline>
          </svg>
        </span>
      </div>
    </a>

    <!-- Card 2: Pulseras & Brazaletes (Span 4) -->
    <a href="{{ section.settings.cat_2_link | default: '/collections/all' }}" class="bonita-cat-card regular">
      {%- if section.settings.cat_2_image != blank -%}
        <img
          src="{{ section.settings.cat_2_image | image_url: width: 800 }}"
          alt="{{ section.settings.cat_2_title }}"
          class="bonita-cat-bg"
          loading="lazy"
          width="800"
          height="800"
        >
      {%- else -%}
        <img
          src="{{ 'collection-pulseras.jpg' | asset_url }}"
          alt="Pulseras de Oro"
          class="bonita-cat-bg"
          loading="lazy"
          width="800"
          height="800"
        >
      {%- endif -%}
      <div class="bonita-cat-overlay"></div>
      <div class="bonita-cat-content">
        <h3 class="bonita-cat-title">{{ section.settings.cat_2_title | default: 'Pulseras' }}</h3>
        <span class="bonita-cat-cta">
          <span>Explorar</span>
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
            <line x1="5" y1="12" x2="19" y2="12"></line>
            <polyline points="12 5 19 12 12 19"></polyline>
          </svg>
        </span>
      </div>
    </a>

    <!-- Card 3: Aretes & Dijes (Span 6) -->
    <a href="{{ section.settings.cat_3_link | default: '/collections/all' }}" class="bonita-cat-card half">
      {%- if section.settings.cat_3_image != blank -%}
        <img
          src="{{ section.settings.cat_3_image | image_url: width: 900 }}"
          alt="{{ section.settings.cat_3_title }}"
          class="bonita-cat-bg"
          loading="lazy"
          width="900"
          height="700"
        >
      {%- else -%}
        <img
          src="{{ 'collection-aretes.jpg' | asset_url }}"
          alt="Aretes y Arracadas"
          class="bonita-cat-bg"
          loading="lazy"
          width="900"
          height="700"
        >
      {%- endif -%}
      <div class="bonita-cat-overlay"></div>
      <div class="bonita-cat-content">
        <h3 class="bonita-cat-title">{{ section.settings.cat_3_title | default: 'Aretes' }}</h3>
        <span class="bonita-cat-cta">
          <span>Explorar</span>
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
            <line x1="5" y1="12" x2="19" y2="12"></line>
            <polyline points="12 5 19 12 12 19"></polyline>
          </svg>
        </span>
      </div>
    </a>

    <!-- Card 4: Anillos & Sellos (Span 6) -->
    <a href="{{ section.settings.cat_4_link | default: '/collections/all' }}" class="bonita-cat-card half">
      {%- if section.settings.cat_4_image != blank -%}
        <img
          src="{{ section.settings.cat_4_image | image_url: width: 900 }}"
          alt="{{ section.settings.cat_4_title }}"
          class="bonita-cat-bg"
          loading="lazy"
          width="900"
          height="700"
        >
      {%- else -%}
        <img
          src="{{ 'collection-anillos.jpg' | asset_url }}"
          alt="Anillos de Oro"
          class="bonita-cat-bg"
          loading="lazy"
          width="900"
          height="700"
        >
      {%- endif -%}
      <div class="bonita-cat-overlay"></div>
      <div class="bonita-cat-content">
        <h3 class="bonita-cat-title">{{ section.settings.cat_4_title | default: 'Anillos' }}</h3>
        <span class="bonita-cat-cta">
          <span>Explorar</span>
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
            <line x1="5" y1="12" x2="19" y2="12"></line>
            <polyline points="12 5 19 12 12 19"></polyline>
          </svg>
        </span>
      </div>
    </a>
  </div>
</section>

{% schema %}
{
  "name": "Categorías de Lujo",
  "settings": [
    {
      "type": "text",
      "id": "subtitle",
      "label": "Subtítulo de Sección",
      "default": "COLECCIONES EXCLUSIVAS"
    },
    {
      "type": "text",
      "id": "title_prefix",
      "label": "Título Principal",
      "default": "EXPLORA NUESTRO"
    },
    {
      "type": "text",
      "id": "title_highlight",
      "label": "Título Resaltado",
      "default": "CATÁLOGO DE ORO"
    },
    {
      "type": "textarea",
      "id": "description",
      "label": "Descripción",
      "default": "Cada pieza está fabricada con oro sólido y certificada en pureza, garantizando el brillo, peso y durabilidad que mereces."
    },
    {
      "type": "header",
      "content": "Categoría 1 (Destacada Cadenas)"
    },
    {
      "type": "image_picker",
      "id": "cat_1_image",
      "label": "Imagen Cadenas"
    },
    {
      "type": "text",
      "id": "cat_1_tag",
      "label": "Etiqueta",
      "default": "La Especialidad de Miami"
    },
    {
      "type": "text",
      "id": "cat_1_title",
      "label": "Título",
      "default": "Cadenas Cubanas (Cuban Link)"
    },
    {
      "type": "url",
      "id": "cat_1_link",
      "label": "Enlace de Colección"
    },
    {
      "type": "header",
      "content": "Categoría 2 (Pulseras)"
    },
    {
      "type": "image_picker",
      "id": "cat_2_image",
      "label": "Imagen Pulseras"
    },
    {
      "type": "text",
      "id": "cat_2_tag",
      "label": "Etiqueta",
      "default": "Oro Sólido 10k & 14k"
    },
    {
      "type": "text",
      "id": "cat_2_title",
      "label": "Título",
      "default": "Pulseras & Manillas"
    },
    {
      "type": "url",
      "id": "cat_2_link",
      "label": "Enlace de Colección"
    },
    {
      "type": "header",
      "content": "Categoría 3 (Dijes)"
    },
    {
      "type": "image_picker",
      "id": "cat_3_image",
      "label": "Imagen Dijes"
    },
    {
      "type": "text",
      "id": "cat_3_tag",
      "label": "Etiqueta",
      "default": "Religiosos & Exclusivos"
    },
    {
      "type": "text",
      "id": "cat_3_title",
      "label": "Título",
      "default": "Dijes & Medallas"
    },
    {
      "type": "url",
      "id": "cat_3_link",
      "label": "Enlace de Colección"
    },
    {
      "type": "header",
      "content": "Categoría 4 (Anillos)"
    },
    {
      "type": "image_picker",
      "id": "cat_4_image",
      "label": "Imagen Anillos"
    },
    {
      "type": "text",
      "id": "cat_4_tag",
      "label": "Etiqueta",
      "default": "Sellos, Coronas & Circones"
    },
    {
      "type": "text",
      "id": "cat_4_title",
      "label": "Título",
      "default": "Anillos de Caballero & Dama"
    },
    {
      "type": "url",
      "id": "cat_4_link",
      "label": "Enlace de Colección"
    }
  ],
  "presets": [
    {
      "name": "Categorías de Lujo"
    }
  ]
}
{% endschema %}
