<!-- DESKTOP FLOATING HEADER -->
<header class="desktop-floating-header" role="banner" aria-label="Navegación principal">
  <!-- Left: Brand Logo -->
  <a href="{{ routes.root_url }}" class="desktop-header-logo" title="La Bonita Jewelry">
    <img src="{{ 'logo-completo.svg' | asset_url }}" alt="La Bonita Jewelry">
  </a>

  <!-- Center: Floating Centered Independent Navbar -->
  <nav class="hero-floating-nav" aria-label="Navegación de colecciones">
    <ul class="hero-nav-track">
      <li><a href="{{ routes.root_url }}" class="hero-nav-link {% if template.name == 'index' %}active{% endif %}">Inicio</a></li>
      <li><a href="{{ routes.root_url }}#cadenas" class="hero-nav-link">Cadenas</a></li>
      <li><a href="{{ routes.root_url }}#anillos" class="hero-nav-link">Anillos</a></li>
      <li><a href="{{ routes.root_url }}#aretes" class="hero-nav-link">Aretes</a></li>
      <li><a href="{{ routes.root_url }}#pulseras" class="hero-nav-link">Pulseras</a></li>
      <li><a href="{{ routes.root_url }}#dijes" class="hero-nav-link">Dijes</a></li>
      <li><a href="{{ routes.root_url }}#contacto" class="hero-nav-link">Contacto</a></li>
    </ul>
  </nav>

  <!-- Right: Actions Outside (WhatsApp & Carrito) -->
  <div class="desktop-header-actions" aria-label="Acciones de contacto y carrito">
    <a href="https://wa.me/15025994250" target="_blank" rel="noopener" class="header-action-link" title="Contactar por WhatsApp">
      <svg width="15" height="15" viewBox="0 0 24 24" fill="currentColor" style="flex-shrink:0;">
        <path d="M12.04 2c-5.46 0-9.91 4.45-9.91 9.91 0 1.75.46 3.45 1.32 4.95L2.05 22l5.25-1.38c1.45.79 3.08 1.21 4.74 1.21 5.46 0 9.91-4.45 9.91-9.91 0-2.65-1.03-5.14-2.9-7.01A9.816 9.816 0 0012.04 2zm0 18.06c-1.49 0-2.95-.4-4.22-1.16l-.3-.18-3.13.82.83-3.05-.2-.31a8.13 8.13 0 01-1.25-4.28c0-4.51 3.67-8.17 8.18-8.17 2.18 0 4.24.85 5.78 2.39 1.54 1.54 2.39 3.6 2.39 5.78 0 4.51-3.67 8.16-8.18 8.16zm4.49-6.13c-.25-.12-1.47-.72-1.7-.81-.23-.08-.39-.12-.56.12-.17.25-.64.81-.79.97-.14.17-.29.19-.54.06-.25-.12-1.05-.39-2-1.23-.74-.66-1.24-1.47-1.39-1.72-.14-.25-.02-.38.11-.5.11-.11.25-.29.37-.43.12-.14.17-.25.25-.41.08-.17.04-.31-.02-.43s-.56-1.34-.76-1.84c-.2-.48-.41-.42-.56-.43h-.48c-.17 0-.44.06-.67.31-.23.25-.88.86-.88 2.1 0 1.24.9 2.44 1.03 2.61.12.17 1.77 2.71 4.3 3.79.6.26 1.07.41 1.44.53.61.19 1.16.17 1.6.1.49-.07 1.47-.6 1.68-1.18.21-.58.21-1.07.14-1.18-.06-.11-.23-.17-.48-.29z"/>
      </svg>
      <span>WhatsApp</span>
    </a>

    <span class="header-action-divider"></span>

    <a href="{{ routes.cart_url }}" class="header-action-btn" title="Ver carrito" id="luxuryHeaderCartBtn">
      <svg viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
        <path d="M15.9996 8C15.9996 9.06087 15.5782 10.0783 14.828 10.8284C14.0779 11.5786 13.0605 12 11.9996 12C10.9387 12 9.92131 11.5786 9.17116 10.8284C8.42102 10.0783 7.99959 9.06087 7.99959 8M3.63281 7.40138L2.93281 15.8014C2.78243 17.6059 2.70724 18.5082 3.01227 19.2042C3.28027 19.8157 3.74462 20.3204 4.33177 20.6382C5.00006 21 5.90545 21 7.71623 21H16.283C18.0937 21 18.9991 21 19.6674 20.6382C20.2546 20.3204 20.7189 19.8157 20.9869 19.2042C21.2919 18.5082 21.2167 17.6059 21.0664 15.8014L20.3664 7.40138C20.237 5.84875 20.1723 5.07243 19.8285 4.48486C19.5257 3.96744 19.0748 3.5526 18.5341 3.29385C17.92 3 17.141 3 15.583 3L8.41623 3C6.85821 3 6.07921 3 5.4651 3.29384C4.92433 3.5526 4.47349 3.96744 4.17071 4.48486C3.82689 5.07243 3.76219 5.84875 3.63281 7.40138Z" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
      </svg>
      <span>Carrito (<span id="cartCountBadge">{{ cart.item_count }}</span>)</span>
    </a>
  </div>
</header>

<!-- MOBILE COMPACT NOTCH ISLAND (< 1180px) -->
<div class="notch-mobile-island">
  <svg aria-hidden="true" width="16" height="16" viewBox="0 0 20 20" fill="none" class="notch-wing notch-wing-left">
    <path d="M 0 0 C 11.046 0 20 8.954 20 20 H 21 V -1 H 0 Z" fill="currentColor"></path>
  </svg>
  <div class="notch-mobile-bar">
    <a href="{{ routes.root_url }}" title="La Bonita Jewelry">
      <img src="{{ 'logo-completo.svg' | asset_url }}" alt="La Bonita Jewelry" style="height:22px; width:auto;">
    </a>
    <button type="button" class="notch-item-btn" onclick="toggleMobileNotch()" style="font-size:0.8rem; font-weight:500;">
      <span id="mobileNotchLabel">Colecciones</span>
      <svg id="mobileNotchChevron" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" style="transition:transform 0.2s;">
        <polyline points="6 9 12 15 18 9"></polyline>
      </svg>
    </button>
    <a href="{{ routes.cart_url }}" class="notch-action-btn" style="padding:4px 6px;">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" style="width:16px; height:16px;">
        <path d="M15.9996 8C15.9996 9.06087 15.5782 10.0783 14.828 10.8284C14.0779 11.5786 13.0605 12 11.9996 12C10.9387 12 9.92131 11.5786 9.17116 10.8284C8.42102 10.0783 7.99959 9.06087 7.99959 8M3.63281 7.40138L2.93281 15.8014C2.78243 17.6059 2.70724 18.5082 3.01227 19.2042C3.28027 19.8157 3.74462 20.3204 4.33177 20.6382C5.00006 21 5.90545 21 7.71623 21H16.283C18.0937 21 18.9991 21 19.6674 20.6382C20.2546 20.3204 20.7189 19.8157 20.9869 19.2042C21.2919 18.5082 21.2167 17.6059 21.0664 15.8014L20.3664 7.40138C20.237 5.84875 20.1723 5.07243 19.8285 4.48486C19.5257 3.96744 19.0748 3.5526 18.5341 3.29385C17.92 3 17.141 3 15.583 3L8.41623 3C6.85821 3 6.07921 3 5.4651 3.29384C4.92433 3.5526 4.47349 3.96744 4.17071 4.48486C3.82689 5.07243 3.76219 5.84875 3.63281 7.40138Z" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
      </svg>
    </a>
  </div>
  <div class="notch-mobile-dropdown" id="notchMobileDropdown">
    <a href="{{ routes.root_url }}">Inicio</a>
    <a href="{{ routes.root_url }}#cadenas">Cadenas</a>
    <a href="{{ routes.root_url }}#anillos">Anillos</a>
    <a href="{{ routes.root_url }}#aretes">Aretes</a>
    <a href="{{ routes.root_url }}#pulseras">Pulseras</a>
    <a href="{{ routes.root_url }}#dijes">Dijes</a>
    <a href="{{ routes.root_url }}#contacto">Contacto</a>
  </div>
  <svg aria-hidden="true" width="16" height="16" viewBox="0 0 20 20" fill="none" class="notch-wing notch-wing-right">
    <path d="M 20 0 C 8.954 0 0 8.954 0 20 H -1 V -1 H 20 Z" fill="currentColor"></path>
  </svg>
</div>

<script>
  function toggleMobileNotch() {
    var dd = document.getElementById('notchMobileDropdown');
    var ch = document.getElementById('mobileNotchChevron');
    if (!dd) return;
    var isOpen = dd.classList.toggle('show');
    if (ch) ch.style.transform = isOpen ? 'rotate(180deg)' : 'rotate(0deg)';
  }
</script>

