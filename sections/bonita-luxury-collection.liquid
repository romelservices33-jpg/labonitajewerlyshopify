{{ 'editorial-luxury.css' | asset_url | stylesheet_tag }}

{%- paginate collection.products by 250 -%}
<div class="bonita-collection-page-wrap" style="background:#FAF9F6; min-height:100vh; padding: 20px 20px 60px;">
  <div style="max-width:1240px; margin:0 auto;">
    
    <!-- Breadcrumbs -->
    <nav class="product-luxury-breadcrumb" style="margin-bottom:16px;" aria-label="Ruta de navegación">
      <a href="{{ routes.root_url }}">Inicio</a>
      <span class="breadcrumb-sep">/</span>
      <a href="/collections/all">Colecciones</a>
      <span class="breadcrumb-sep">/</span>
      <span class="breadcrumb-current">{{ collection.title }}</span>
    </nav>

    <!-- Collection Header Banner -->
    <header class="collection-editorial-hero" style="text-align:center; margin-bottom:28px;">
      <span class="hero-kicker" style="font-family:'Plus Jakarta Sans', sans-serif; font-size:0.75rem; font-weight:700; letter-spacing:0.14em; color:#D1B054; text-transform:uppercase;">Colección de Oro Auténtico 10K & 14K</span>
      <h1 style="font-family:'Sentient', Georgia, serif; font-size:clamp(2rem, 4vw, 3rem); font-weight:600; color:#08195B; margin:6px 0 10px; line-height:1.15;">{{ collection.title }}</h1>
      {%- if collection.description != blank -%}
        <p style="font-size:0.88rem; color:#64748B; max-width:640px; margin:0 auto 10px; line-height:1.5;">{{ collection.description | strip_html }}</p>
      {%- else -%}
        <p style="font-size:0.88rem; color:#64748B; max-width:640px; margin:0 auto 10px; line-height:1.5;">Explora piezas exclusivas garantizadas de por vida con especificación exacta de quilataje y peso en gramos.</p>
      {%- endif -%}
      <div style="display:inline-flex; align-items:center; gap:6px; font-size:0.75rem; color:#059669; font-weight:700;">
        <span style="width:6px; height:6px; background:#059669; border-radius:50%;"></span>
        <span>{{ collection.products_count | default: collection.products.size }} Joyas Disponibles · Envío Inmediato</span>
      </div>
    </header>

    <!-- Category Navigation Tabs + Seamless Filter Bar -->
    <div class="catalog-filter-bar" id="collectionFilterBar" style="max-width:1060px; margin:0 auto 28px;">
      <div class="category-tabs-scroll" role="navigation" aria-label="Categorías de joyería" style="margin-bottom:18px;">
        <a href="/collections/all" class="cat-tab-btn {% if collection.handle == 'all' %}active{% endif %}" style="text-decoration:none;">Todas</a>
        <a href="/collections/cadenas" class="cat-tab-btn {% if collection.handle == 'cadenas' %}active{% endif %}" style="text-decoration:none;">Cadenas</a>
        <a href="/collections/cuban" class="cat-tab-btn {% if collection.handle == 'cuban' or collection.handle == 'cadenas-cubanas' %}active{% endif %}" style="text-decoration:none;">Cadenas Cubanas</a>
        <a href="/collections/anillos" class="cat-tab-btn {% if collection.handle == 'anillos' %}active{% endif %}" style="text-decoration:none;">Anillos</a>
        <a href="/collections/aretes" class="cat-tab-btn {% if collection.handle == 'aretes' %}active{% endif %}" style="text-decoration:none;">Aretes</a>
        <a href="/collections/pulseras" class="cat-tab-btn {% if collection.handle == 'pulseras' %}active{% endif %}" style="text-decoration:none;">Pulseras</a>
        <a href="/collections/dijes" class="cat-tab-btn {% if collection.handle == 'dijes' %}active{% endif %}" style="text-decoration:none;">Dijes & Medallas</a>
        <a href="/collections/piercings" class="cat-tab-btn {% if collection.handle == 'piercings' %}active{% endif %}" style="text-decoration:none;">Piercings</a>
        <a href="/collections/relojes" class="cat-tab-btn {% if collection.handle == 'relojes' %}active{% endif %}" style="text-decoration:none;">Relojes</a>
      </div>

      <div class="filter-dropdowns-row">
        <!-- Pureza -->
        <div class="filter-item-wrap">
          <span class="filter-label">Pureza de Oro</span>
          <div class="select uiverse-select" id="selectCollectionKarat" tabindex="0">
            <div class="selected">
              <span class="selected-text" id="selectedCollectionKaratText">Todas las purezas</span>
              <svg class="arrow" viewBox="0 0 512 512"><path d="M233.4 406.6c12.5 12.5 32.8 12.5 45.3 0l192-192c12.5-12.5 12.5-32.8 0-45.3s-32.8-12.5-45.3 0L256 338.7 86.6 169.4c-12.5-12.5-32.8-12.5-45.3 0s-12.5 32.8 0 45.3l192 192z"/></svg>
            </div>
            <div class="options">
              <div title="all">
                <input id="ckarat-all" name="cfilter-karat" type="radio" value="all" checked onchange="filterCollectionProducts('karat', 'all', 'Todas las purezas')">
                <label class="option" for="ckarat-all" data-txt="Todas las purezas"></label>
              </div>
              <div title="14k">
                <input id="ckarat-14k" name="cfilter-karat" type="radio" value="14k" onchange="filterCollectionProducts('karat', '14k', 'Oro 14K Auténtico')">
                <label class="option" for="ckarat-14k" data-txt="Oro 14K Auténtico"></label>
              </div>
              <div title="10k">
                <input id="ckarat-10k" name="cfilter-karat" type="radio" value="10k" onchange="filterCollectionProducts('karat', '10k', 'Oro 10K Auténtico')">
                <label class="option" for="ckarat-10k" data-txt="Oro 10K Auténtico"></label>
              </div>
            </div>
          </div>
        </div>

        <!-- Ordenar -->
        <div class="filter-item-wrap">
          <span class="filter-label">Ordenar Por</span>
          <div class="select uiverse-select" id="selectCollectionSort" tabindex="0">
            <div class="selected">
              <span class="selected-text" id="selectedCollectionSortText">Destacados</span>
              <svg class="arrow" viewBox="0 0 512 512"><path d="M233.4 406.6c12.5 12.5 32.8 12.5 45.3 0l192-192c12.5-12.5 12.5-32.8 0-45.3s-32.8-12.5-45.3 0L256 338.7 86.6 169.4c-12.5-12.5-32.8-12.5-45.3 0s-12.5 32.8 0 45.3l192 192z"/></svg>
            </div>
            <div class="options">
              <div title="default">
                <input id="csort-default" name="cfilter-sort" type="radio" value="default" checked onchange="filterCollectionProducts('sort', 'default', 'Destacados')">
                <label class="option" for="csort-default" data-txt="Destacados"></label>
              </div>
              <div title="price-asc">
                <input id="csort-price-asc" name="cfilter-sort" type="radio" value="price-asc" onchange="filterCollectionProducts('sort', 'price-asc', 'Precio: Menor a Mayor')">
                <label class="option" for="csort-price-asc" data-txt="Precio: Menor a Mayor"></label>
              </div>
              <div title="price-desc">
                <input id="csort-price-desc" name="cfilter-sort" type="radio" value="price-desc" onchange="filterCollectionProducts('sort', 'price-desc', 'Precio: Mayor a Menor')">
                <label class="option" for="csort-price-desc" data-txt="Precio: Mayor a Menor"></label>
              </div>
            </div>
          </div>
        </div>
      </div>

      <!-- Status Line -->
      <div class="filter-meta-bar">
        <span class="filter-results-count" id="collectionCountText">Mostrando joyas disponibles</span>
        <button class="btn-filter-reset" onclick="resetCollectionFilters()" type="button">Limpiar filtros</button>
      </div>
    </div>

    <!-- Products Grid (8 on Desktop, 6 on Mobile) -->
    <div class="catalog-products-grid" id="collectionProductsGrid">
      {%- for product in collection.products -%}
        {%- assign ptype_down = product.type | downcase -%}
        {%- assign ptitle_down = product.title | downcase -%}
        {%- assign cat_tag = product.type | default: collection.title | downcase -%}
        {%- assign cat_label = product.type | default: collection.title -%}
        {%- if product.tags contains 'cat:relojes' -%}
          {%- assign cat_tag = 'relojes' -%}
          {%- assign cat_label = 'Relojes' -%}
        {%- elsif product.tags contains 'cat:aretes' or ptype_down contains 'arete' or ptitle_down contains 'arete' or ptitle_down contains 'dormilon' -%}
          {%- assign cat_tag = 'aretes' -%}
          {%- assign cat_label = 'Aretes' -%}
        {%- elsif product.tags contains 'cat:piercings' -%}
          {%- assign cat_tag = 'piercings' -%}
          {%- assign cat_label = 'Piercings' -%}
        {%- elsif product.tags contains 'cat:pulseras' -%}
          {%- assign cat_tag = 'pulseras' -%}
          {%- assign cat_label = 'Pulseras' -%}
        {%- elsif product.tags contains 'cat:anillos' -%}
          {%- assign cat_tag = 'anillos' -%}
          {%- assign cat_label = 'Anillos' -%}
        {%- elsif product.tags contains 'cat:dijes' -%}
          {%- assign cat_tag = 'dijes' -%}
          {%- assign cat_label = 'Dijes' -%}
        {%- elsif product.tags contains 'cat:cuban' -%}
          {%- assign cat_tag = 'cuban' -%}
          {%- assign cat_label = 'Cadena Cubana' -%}
        {%- elsif product.tags contains 'cat:cadenas' -%}
          {%- assign cat_tag = 'cadenas' -%}
          {%- assign cat_label = 'Cadenas' -%}
        {%- elsif ptype_down contains 'reloj' or ptitle_down contains 'invicta' or ptitle_down contains 'seiko' -%}
          {%- assign cat_tag = 'relojes' -%}
          {%- assign cat_label = 'Relojes' -%}
        {%- elsif ptype_down contains 'piercing' or ptitle_down contains 'piercing' -%}
          {%- assign cat_tag = 'piercings' -%}
          {%- assign cat_label = 'Piercings' -%}
        {%- elsif ptype_down contains 'pulsera' or ptype_down contains 'manilla' or ptitle_down contains 'pulsera' or ptitle_down contains 'manilla' or ptitle_down contains 'esclava' or ptitle_down contains 'brazalete' or ptitle_down contains 'semanario' or ptitle_down contains 'tobillera' -%}
          {%- assign cat_tag = 'pulseras' -%}
          {%- assign cat_label = 'Pulseras' -%}
        {%- elsif ptype_down contains 'anillo' or ptitle_down contains 'anillo' or ptitle_down contains 'alianza' or ptitle_down contains 'sortija' or ptitle_down contains 'solitario' or ptitle_down contains 'compromiso' -%}
          {%- assign cat_tag = 'anillos' -%}
          {%- assign cat_label = 'Anillos' -%}
        {%- elsif ptitle_down contains 'arracada' or ptitle_down contains 'argolla' or ptitle_down contains 'huggie' or ptitle_down contains 'broquel' or ptitle_down contains 'topo' -%}
          {%- assign cat_tag = 'aretes' -%}
          {%- assign cat_label = 'Aretes' -%}
        {%- elsif ptype_down contains 'dije' or ptitle_down contains 'medalla' or ptitle_down contains 'guardapelo' or ptitle_down contains 'relicario' or ptitle_down contains 'charm' or ptitle_down contains 'prendedor' -%}
          {%- assign cat_tag = 'dijes' -%}
          {%- assign cat_label = 'Dijes' -%}
        {%- elsif ptype_down contains 'cuban' or ptitle_down contains 'cuban' or ptitle_down contains 'miami' or ptitle_down contains 'mónaco' or ptitle_down contains 'monaco' -%}
          {%- assign cat_tag = 'cuban' -%}
          {%- assign cat_label = 'Cadena Cubana' -%}
        {%- elsif ptype_down contains 'cadena' or ptitle_down contains 'cadena' or ptitle_down contains 'collar' or ptitle_down contains 'gargantilla' or ptitle_down contains 'rosario' -%}
          {%- assign cat_tag = 'cadenas' -%}
          {%- assign cat_label = 'Cadenas' -%}
        {%- endif -%}
        {%- assign karat_tag = '10k' -%}
        {%- if product.tags contains '14k' or product.tags contains '14K' or product.title contains '14K' or product.title contains '14k' -%}
          {%- assign karat_tag = '14k' -%}
        {%- endif -%}
        {%- assign monthly_affirm = product.price | divided_by: 1200 -%}
        {%- if monthly_affirm < 20 -%}{%- assign monthly_affirm = 20 -%}{%- endif -%}
        {%- assign product_weight = '' -%}
        {%- if product.variants.first.weight > 0 -%}
          {%- assign raw_w = product.variants.first.weight | divided_by: 1.0 -%}
          {%- if raw_w > 500 -%}{%- assign raw_w = raw_w | divided_by: 1000.0 -%}{%- endif -%}
          {%- assign product_weight = raw_w -%}
        {%- endif -%}
        {%- assign product_size = '' -%}
        {%- for opt in product.options_with_values -%}
          {%- assign opt_name = opt.name | downcase -%}
          {%- if opt_name contains 'talla' or opt_name contains 'size' or opt_name contains 'medida' or opt_name contains 'largo' or opt_name contains 'longitud' -%}
            {%- assign product_size = opt.values.first -%}
          {%- endif -%}
        {%- endfor -%}
        {%- if product_size == blank and product.variants.first.title != 'Default Title' -%}
          {%- assign product_size = product.variants.first.title -%}
        {%- endif -%}
        <div class="product-shop-card cutout-product-card" data-category="{{ cat_tag }}" data-karat="{{ karat_tag }}" data-price="{{ product.price | divided_by: 100.0 }}" data-weight="{{ product_weight }}" data-size="{{ product_size | escape }}" data-default-order="{{ forloop.index }}" data-variant-id="{{ product.variants.first.id }}" data-images="{%- for img in product.images -%}{{ img | image_url: width: 1200 }}{%- unless forloop.last -%}|{%- endunless -%}{%- endfor -%}" onclick="openProductModalFromCard(this)">
          <div class="cutout-card-media">
            <a href="{{ product.url }}" onclick="event.preventDefault(); openProductModalFromCard(this.closest('.product-shop-card'));">
              {%- if product.featured_image != blank -%}
                <img src="{{ product.featured_image | image_url: width: 600 }}" alt="{{ product.title | escape }}" class="cutout-card-img" loading="lazy">
              {%- else -%}
                <img src="{{ 'collection-cadenas.jpg' | asset_url }}" alt="{{ product.title | escape }}" class="cutout-card-img" loading="lazy">
              {%- endif -%}
            </a>
            {%- if product.compare_at_price > product.price -%}
              {%- assign promo_pct_top = product.compare_at_price | minus: product.price | times: 100.0 | divided_by: product.compare_at_price | round -%}
              <span style="position:absolute;top:10px;left:10px;z-index:5;background:linear-gradient(135deg,#DC2626,#991B1B);color:#FFF;font-size:0.65rem;font-weight:800;padding:4px 9px;border-radius:999px;letter-spacing:0.04em;box-shadow:0 4px 10px rgba(220,38,38,0.28);">✦ -{{ promo_pct_top }}% PROMO</span>
            {%- endif -%}
            <div class="cutout-card-pin">
              <span>{{ karat_tag | upcase }} ORO</span>
              <svg class="cutout-corner cutout-corner-pin-left" width="24" height="32" viewBox="0 0 24 32" fill="none"><path d="M0 0 H24 V32 C17.38 32 12 24.83 12 16 C12 7.17 6.63 0 0 0 Z" fill="currentColor"/></svg>
            </div>
            <div class="cutout-card-inset-label">
              <span class="cutout-label-text">{{ cat_label }}</span>
              <svg class="cutout-corner cutout-corner-label-right" width="24" height="32" viewBox="0 0 24 32" fill="none"><path d="M0 0 C6.63 0 12 7.17 12 16 C12 24.83 17.38 32 24 32 H0 V0 Z" fill="currentColor"/></svg>
            </div>
          </div>
          <div class="cutout-card-content">
            <div class="cutout-title-row">
              <h4 class="cutout-product-title"><a href="{{ product.url }}" onclick="event.preventDefault(); openProductModalFromCard(this.closest('.product-shop-card'));" style="color:inherit; text-decoration:none;">{{ product.title }}</a></h4>
              <span class="spec-weight-tag">{{ karat_tag | upcase }} Oro Auténtico · Envío Asegurado</span>
            </div>
            <div class="product-card-pricing-row">
              <div class="pricing-amounts">
                <div class="pricing-numbers-row">
                  <span class="price-now">{{ product.price | money }}</span>
                  {%- if product.compare_at_price > product.price -%}
                    {%- assign promo_pct = product.compare_at_price | minus: product.price | times: 100.0 | divided_by: product.compare_at_price | round -%}
                    <span class="price-was">{{ product.compare_at_price | money }}</span>
                    <span class="promo-badge-20" style="background:linear-gradient(135deg,#DC2626,#991B1B);color:#FFF;font-size:0.65rem;font-weight:800;padding:2px 7px;border-radius:999px;letter-spacing:0.03em;line-height:1.2;">-{{ promo_pct }}% OFF</span>
                  {%- endif -%}
                </div>
                <div class="affirm-monthly-badge">Desde <strong>${{ monthly_affirm }}/mes</strong> con Affirm</div>
              </div>
              <button type="button" class="btn-add-cart-pill" onclick="event.stopPropagation(); openProductModalFromCard(this.closest('.product-shop-card'));" title="Ver y Comprar" aria-label="Ver y Comprar">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M16 8a4 4 0 0 1-8 0M3.6 7.4L2.9 15.8C2.8 17.6 2.7 18.5 3 19.2c.3.6.7 1.1 1.3 1.4.7.4 1.6.4 3.4.4h8.6c1.8 0 2.7 0 3.4-.4.6-.3 1-.8 1.3-1.4.3-.7.2-1.6.1-3.4l-.7-8.4c-.1-1.6-.2-2.3-.5-2.9-.3-.5-.8-1-1.3-1.2C18 3 17.2 3 15.6 3H8.4C6.8 3 6 3 5.4 3.3c-.5.2-1 .7-1.3 1.2-.3.6-.4 1.3-.5 2.9z"/></svg>
              </button>
            </div>
          </div>
        </div>
      {%- else -%}
        <div style="grid-column: 1 / -1; text-align:center; padding:60px 20px; color:#64748B;">
          <p style="font-size:1.1rem; color:#08195B; font-weight:700;">Pronto añadiremos nuevas joyas a esta colección.</p>
          <p style="font-size:0.85rem;">Explora mientras tanto nuestras <a href="/collections/all" style="color:#D1B054; font-weight:700;">demás colecciones</a> de oro.</p>
        </div>
      {%- endfor -%}
    </div>

    <!-- Pagination Controls (8 on Desktop, 6 on Mobile) -->
    <div class="catalog-pagination-bar" id="collectionPaginationBar"></div>

    <!-- Trust Strip Horizontal -->
    <div style="margin-top:40px;">
      {%- render 'quick-view-modal' -%}
    </div>
  </div>
</div>
{%- endpaginate -%}

<!-- JavaScript for Collection Filtering & Pagination -->
<script>
  var collectionPage = 1;
  function getCollectionPerPage() {
    return (window.innerWidth && window.innerWidth <= 860) ? 6 : 8;
  }
  var activeCollectionKarat = 'all';
  var activeCollectionSort = 'default';

  function initCollectionPagination() {
    paginateCollectionGrid();
  }

  function getActiveCollectionCards() {
    var cards = Array.from(document.querySelectorAll('#collectionProductsGrid .product-shop-card'));
    var filtered = cards.filter(function(card) {
      var karat = (card.getAttribute('data-karat') || '').toLowerCase();
      if (activeCollectionKarat !== 'all' && karat !== activeCollectionKarat) return false;
      return true;
    });

    if (activeCollectionSort === 'price-asc') {
      filtered.sort(function(a, b) {
        return (parseFloat(a.getAttribute('data-price')) || 0) - (parseFloat(b.getAttribute('data-price')) || 0);
      });
    } else if (activeCollectionSort === 'price-desc') {
      filtered.sort(function(a, b) {
        return (parseFloat(b.getAttribute('data-price')) || 0) - (parseFloat(a.getAttribute('data-price')) || 0);
      });
    } else {
      filtered.sort(function(a, b) {
        return (parseInt(a.getAttribute('data-default-order')) || 0) - (parseInt(b.getAttribute('data-default-order')) || 0);
      });
    }

    return filtered;
  }

  function paginateCollectionGrid() {
    var grid = document.getElementById('collectionProductsGrid');
    if (!grid) return;
    var activeCards = getActiveCollectionCards();
    var allCards = grid.querySelectorAll('.product-shop-card');
    allCards.forEach(function(c) { c.style.display = 'none'; });

    var total = activeCards.length;
    var perPage = getCollectionPerPage();
    var totalPages = Math.max(1, Math.ceil(total / perPage));
    if (collectionPage > totalPages) collectionPage = 1;

    var start = (collectionPage - 1) * perPage;
    var end = start + perPage;
    var pageCards = activeCards.slice(start, end);

    pageCards.forEach(function(c) {
      c.style.display = 'flex';
      grid.appendChild(c);
    });

    var countText = document.getElementById('collectionCountText');
    if (countText) {
      if (total === 0) {
        countText.textContent = 'No se encontraron joyas con los filtros seleccionados.';
      } else {
        countText.textContent = 'Mostrando ' + (start + 1) + '-' + Math.min(end, total) + ' de ' + total + ' joyas de oro';
      }
    }

    renderCollectionPaginationButtons(totalPages);
  }

  function renderCollectionPaginationButtons(totalPages) {
    var bar = document.getElementById('collectionPaginationBar');
    if (!bar) return;
    bar.innerHTML = '';

    if (totalPages <= 1) return;

    // Prev Button
    var prevBtn = document.createElement('button');
    prevBtn.className = 'catalog-page-btn nav-btn';
    prevBtn.innerHTML = '← Anterior';
    prevBtn.disabled = (collectionPage === 1);
    prevBtn.onclick = function() {
      if (collectionPage > 1) {
        collectionPage--;
        paginateCollectionGrid();
        window.scrollTo({ top: 180, behavior: 'smooth' });
      }
    };
    bar.appendChild(prevBtn);

    // Page number buttons
    for (var i = 1; i <= totalPages; i++) {
      (function(pageNum) {
        var numBtn = document.createElement('button');
        numBtn.className = 'catalog-page-btn' + (pageNum === collectionPage ? ' active' : '');
        numBtn.textContent = pageNum;
        numBtn.onclick = function() {
          collectionPage = pageNum;
          paginateCollectionGrid();
          window.scrollTo({ top: 180, behavior: 'smooth' });
        };
        bar.appendChild(numBtn);
      })(i);
    }

    // Next Button
    var nextBtn = document.createElement('button');
    nextBtn.className = 'catalog-page-btn nav-btn';
    nextBtn.innerHTML = 'Siguiente →';
    nextBtn.disabled = (collectionPage === totalPages);
    nextBtn.onclick = function() {
      if (collectionPage < totalPages) {
        collectionPage++;
        paginateCollectionGrid();
        window.scrollTo({ top: 180, behavior: 'smooth' });
      }
    };
    bar.appendChild(nextBtn);
  }

  function filterCollectionProducts(type, val, text) {
    if (type === 'karat') {
      activeCollectionKarat = val;
      var t = document.getElementById('selectedCollectionKaratText');
      if (t) t.textContent = text;
    } else if (type === 'sort') {
      activeCollectionSort = val;
      var s = document.getElementById('selectedCollectionSortText');
      if (s) s.textContent = text;
    }
    document.querySelectorAll('.uiverse-select').forEach(function(sel) { sel.classList.remove('is-open'); });
    collectionPage = 1;
    paginateCollectionGrid();
  }

  function resetCollectionFilters() {
    activeCollectionKarat = 'all';
    activeCollectionSort = 'default';
    var kAll = document.getElementById('ckarat-all');
    if (kAll) kAll.checked = true;
    var k = document.getElementById('selectedCollectionKaratText');
    if (k) k.textContent = 'Todas las purezas';
    var sDef = document.getElementById('csort-default');
    if (sDef) sDef.checked = true;
    var s = document.getElementById('selectedCollectionSortText');
    if (s) s.textContent = 'Destacados';
    collectionPage = 1;
    paginateCollectionGrid();
  }

  document.addEventListener('click', function(e) {
    var selectedEl = e.target.closest('.uiverse-select .selected');
    if (selectedEl) {
      var parentSelect = selectedEl.closest('.uiverse-select');
      var wasOpen = parentSelect.classList.contains('is-open');
      document.querySelectorAll('.uiverse-select').forEach(function(s) { s.classList.remove('is-open'); });
      if (!wasOpen) parentSelect.classList.add('is-open');
      return;
    }
    if (!e.target.closest('.uiverse-select')) {
      document.querySelectorAll('.uiverse-select').forEach(function(s) { s.classList.remove('is-open'); });
    }
  });

  document.addEventListener('DOMContentLoaded', initCollectionPagination);
  if (document.readyState !== 'loading') initCollectionPagination();

  var resizeCollectionTimer;
  window.addEventListener('resize', function() {
    clearTimeout(resizeCollectionTimer);
    resizeCollectionTimer = setTimeout(function() {
      paginateCollectionGrid();
    }, 150);
  });
</script>

